                        <span class="active-dot"></span>
                    </a>
                </li>
                <li>
                    <a href="/Trainer/Appointments" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-calendar2-event"></i>
                            <span>Appointments</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Trainer/Reports" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-graph-up-arrow"></i>
                            <span>Progress & Reports</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Trainer/Profile" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-person-gear"></i>
                            <span>Profile & Specialty</span>
                        </div>
                    </a>
                </li>
            </ul>
        </div>

        <div class="sidebar-bottom-section">
            <div class="support-card">
                <div class="support-icon">
                    <i class="bi bi-heart-pulse"></i>
                </div>
                <div class="support-title">Need assistance?</div>
                <div class="support-desc">Our care team is here to help.</div>
                <a href="mailto:support@healthtrack.com" class="support-link">
                    <span>Contact support</span>
                    <i class="bi bi-chevron-right" style="font-size: 0.7rem;"></i>
                </a>
            </div>

            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                <button type="submit" class="btn-signout">
                    <i class="bi bi-box-arrow-left"></i>
                    <span>Sign out</span>
                </button>
            </form>

            <a href="/" class="link-public-site">View public site</a>
        </div>
    </aside>

    <!-- ========================================================= -->
    <!-- 2. MAIN CONTENT AREA                                      -->
    <!-- ========================================================= -->
    <div class="main-wrapper">
        
        <!-- Top Navbar -->
        <header class="top-navbar">
            <div class="search-box">
                <i class="bi bi-search search-icon"></i>
                <input type="text" class="search-input" placeholder="Search diet plans, macros, clients..." />
            </div>

            <div class="top-controls">
                <!-- Notifications Bell -->
                <a href="/Client/Notifications" class="btn-notification" title="Notifications">
                    <i class="bi bi-bell"></i>
                    @if (Model.UnreadNotificationsCount > 0)
                    {
                        <span class="notify-dot"></span>
                    }
                </a>

                <!-- User Profile Dropdown -->
                <div class="dropdown">
                    <button class="user-profile-pill btn p-0 border-0 d-flex align-items-center" type="button" id="trainerDietDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="avatar-initials">@Model.TrainerInitials</div>
                        <div class="user-meta d-none d-sm-block text-start ms-2">
                            <span class="fw-bold small text-dark d-block">@Model.TrainerName</span>
                            <span class="text-muted" style="font-size: 0.75rem;">Trainer</span>
                        </div>
                        <i class="bi bi-chevron-down ms-2 text-muted" style="font-size: 0.75rem;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border border-slate-100 rounded-3 mt-2 py-2" aria-labelledby="trainerDietDropdown" style="min-width: 220px; z-index: 1050;">
                        <li class="px-3 py-2 border-bottom">
                            <div class="fw-bold text-dark small">@Model.TrainerName</div>
                            <div class="text-muted" style="font-size: 0.78rem;">@Model.TrainerEmail</div>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="/Trainer">
                                <i class="bi bi-grid text-secondary"></i> Trainer Dashboard
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="/Trainer/Clients">
                                <i class="bi bi-people text-secondary"></i> My Clients
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="/Trainer/Workouts">
                                <i class="bi bi-shield-check text-secondary"></i> Workout Plans
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="/Trainer/Profile">
                                <i class="bi bi-person-gear text-secondary"></i> Trainer Profile
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li class="px-2 pt-1">
                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-2 py-1.5 d-flex align-items-center justify-content-center gap-2 fw-semibold">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Log out</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Body Content -->
        <main class="dashboard-body">

            <!-- Toast / Alerts -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert" style="background-color: #ECFDF5; color: #065F46;">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Header Row -->
            <div class="page-header-row">
                <div>
                    <div class="page-eyebrow">NUTRITION COACHING</div>
                    <h1 class="page-title">Diet Plans & Nutrition</h1>
                    <p class="page-subtitle">Design dietary programs, set macro targets, and monitor client nutritional adherence.</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn-new-template" data-bs-toggle="modal" data-bs-target="#createDietTemplateModal">
                        <i class="bi bi-folder-plus text-teal"></i>
                        <span>+ New Template</span>
                    </button>
                    <button type="button" class="btn-create-diet" data-bs-toggle="modal" data-bs-target="#createDietModal">
                        <i class="bi bi-plus-lg"></i>
                        <span>Create diet plan</span>
                    </button>
                </div>
            </div>

            <!-- KPI Metric Cards -->
            <div class="kpi-cards-grid">
                <div class="kpi-card">
                    <div class="kpi-header">
                        <span class="kpi-title">Active Diet Plans</span>
                        <div class="kpi-icon icon-teal">
                            <i class="bi bi-egg-fried"></i>
                        </div>
                    </div>
                    <div class="kpi-value">@Model.TotalActiveDietPlans</div>
                    <div class="kpi-sub text-success fw-bold"><i class="bi bi-arrow-up-short"></i> +2 this month</div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-header">
                        <span class="kpi-title">Diet Templates</span>
                        <div class="kpi-icon icon-blue">
                            <i class="bi bi-journal-bookmark"></i>
                        </div>
                    </div>
                    <div class="kpi-value">@Model.TotalTemplatesCount</div>
                    <div class="kpi-sub text-muted">Standardized protocols</div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-header">
                        <span class="kpi-title">Avg. Macro Adherence</span>
                        <div class="kpi-icon icon-green">
                            <i class="bi bi-pie-chart"></i>
                        </div>
                    </div>
                    <div class="kpi-value">@Model.AvgMacroAdherence%</div>
                    <div class="kpi-sub text-success fw-bold"><i class="bi bi-arrow-up-short"></i> +3.5% vs last month</div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-header">
                        <span class="kpi-title">Meal Logs Monitored</span>
                        <div class="kpi-icon icon-purple">
                            <i class="bi bi-check2-circle"></i>
                        </div>
                    </div>
                    <div class="kpi-value">@Model.WeeklyMealLogsCount</div>
                    <div class="kpi-sub text-muted">Weekly client meal logs</div>
                </div>
            </div>

            <!-- Section 1: Diet Program Templates -->
            <div class="section-header-row">
                <div>
                    <h2 class="section-title">Nutrition Program Templates</h2>
                    <p class="section-sub">Standardized caloric & macro blueprints you can assign directly to any client.</p>
                </div>
                <button type="button" class="btn-new-template" data-bs-toggle="modal" data-bs-target="#createDietTemplateModal">
                    <i class="bi bi-plus-circle text-teal"></i>
                    <span>+ New Template</span>
                </button>
            </div>

            <div class="templates-grid">
                @foreach (var tpl in Model.Templates)
                {
                    <div class="template-card">
                        <div>
                            <span class="badge-category @tpl.BadgeClass">@tpl.Category</span>
                            <h3 class="template-title">@tpl.Title</h3>
                            <p class="template-desc">@tpl.Description</p>
                        </div>
                        <div>
                            <div class="template-meta-row">
                                <span><i class="bi bi-fire me-1"></i> @tpl.DailyCalories kcal</span>
                                <span><i class="bi bi-droplet me-1"></i> @tpl.ProteinGrams g protein</span>
                                <span><i class="bi bi-people me-1"></i> @tpl.AssignedClientsCount clients</span>
                            </div>
                            <button type="button" class="btn-assign-template" onclick="openAssignModalForDietTemplate('@tpl.Title', '@tpl.Category', @tpl.DailyCalories, @tpl.ProteinGrams, @tpl.MealsPerDay)">
                                <i class="bi bi-person-plus me-1"></i> Assign to Client
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- Section 2: Client Nutrition Roster Table -->
            <div class="section-header-row">
                <div>
                    <h2 class="section-title">Client Nutrition Roster & Compliance</h2>
                    <p class="section-sub">Live monitoring of your assigned clients and their daily meal logging adherence.</p>
                </div>
            </div>

            <div class="table-card">
                <div class="table-top-header">
                    <h3 class="table-card-title">Assigned Clients Nutrition (@Model.ClientDietRosters.Count)</h3>
                    <span class="badge-count">Live Daily Compliance</span>
                </div>

                <div class="table-responsive">
                    <table class="custom-diet-table">
                        <thead>
                            <tr>
                                <th>CLIENT</th>
                                <th>ASSIGNED DIET PLAN</th>
                                <th>DAILY MACRO TARGETS</th>
                                <th>TODAY'S MEAL LOGS</th>
                                <th>LAST MEAL LOGGED</th>
                                <th>STATUS</th>
                                <th class="text-end">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ClientDietRosters)
                            {
                                <tr>
                                    <td>
                                        <div class="client-info-cell">
                                            <div class="client-avatar-pill">@item.ClientInitials</div>
                                            <div>
                                                <div class="fw-bold text-dark">@item.ClientName</div>
                                                <div class="text-muted small" style="font-size: 0.76rem;">@item.ClientEmail</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.PlanTitle</div>
                                        <div class="text-muted small" style="font-size: 0.76rem;">@item.Category</div>
                                    </td>
                                    <td>
                                        <span class="text-dark small fw-bold">@item.TargetCalories kcal</span>
                                        <span class="text-muted small">· @item.TargetProtein g protein</span>
                                    </td>
                                    <td>
                                        <div class="progress-bar-container">
                                            <div class="progress-track">
                                                <div class="progress-fill" style="width: @(item.AdherencePercentage)%;"></div>
                                            </div>
                                            <span class="fw-bold small text-dark">@item.MealsLoggedToday/@item.TotalMealsScheduled (@item.AdherencePercentage%)</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-muted small">@item.LastMealLogged</span>
                                    </td>
                                    <td>
                                        @if (item.Status == "Active")
                                        {
                                            <span class="status-badge-active">
                                                <span class="status-dot-green"></span>
                                                <span>Active</span>
                                            </span>
                                        }
                                        else if (item.Status == "Archived")
                                        {
                                            <span class="badge rounded-pill fw-semibold" style="background-color: #F3F4F6; color: #4B5563; padding: 5px 12px; font-size: 0.78rem; display: inline-flex; align-items: center; gap: 4px;">
                                                <i class="bi bi-archive-fill text-muted" style="font-size: 0.8rem;"></i>
                                                <span>Archived</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge-risk">
                                                <span class="status-dot-red"></span>
                                                <span>At risk</span>
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn-edit-diet" onclick="openAssignModalForDietClient('@item.ClientId', '@item.ClientName', @item.TargetCalories, @item.TargetProtein)">
                                            <i class="bi bi-sliders2 me-1"></i> Adjust
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>
</div>

<!-- ========================================================= -->
<!-- 4. MODAL: CREATE & ASSIGN DIET PLAN                       -->
<!-- ========================================================= -->
<div class="modal fade" id="createDietModal" tabindex="-1" aria-labelledby="createDietModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom px-4 py-3 bg-light rounded-top-4">
                <div class="d-flex align-items-center gap-3">
                    <div style="width: 40px; height: 40px; border-radius: 12px; background: #CCFBF1; color: #0D9488; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                        <i class="bi bi-egg-fried"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark" id="createDietModalLabel">Create & Assign Nutrition Plan</h5>
                        <p class="text-muted small mb-0">Prescribe daily caloric and macronutrient targets for your client.</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="CreateDietPlan" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body px-4 py-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Assign to Client <span class="text-danger">*</span></label>
                            <select name="ClientId" id="modalDietClientSelect" class="form-select rounded-3 py-2" required>
                                <option value="">-- Choose Client --</option>
                                @foreach (var client in Model.AvailableClients)
                                {
                                    <option value="@client.Id">@client.FullName (@client.Email)</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Diet Category</label>
                            <select name="Category" id="modalDietCategorySelect" class="form-select rounded-3 py-2">
                                <option value="Balanced Nutrition">Balanced Performance</option>
                                <option value="Caloric Deficit">High-Protein Fat Loss</option>
                                <option value="Mass Building">Lean Mass Hypertrophy</option>
                                <option value="Vegan & Plant">Plant-Based Metabolic Fuel</option>
                                <option value="Rehab & Recovery">Anti-Inflammatory & Mobility</option>
                            </select>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-semibold small text-dark">Diet Plan Title <span class="text-danger">*</span></label>
                            <input type="text" name="Title" id="modalDietTitleInput" class="form-control rounded-3 py-2" placeholder="e.g. Balanced Performance Plan" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">Daily Target Calories (kcal) <span class="text-danger">*</span></label>
                            <input type="number" name="TargetCalories" id="modalDietCaloriesInput" class="form-control rounded-3 py-2" min="800" max="6000" value="2150" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">Daily Target Protein (g)</label>
                            <input type="number" name="TargetProtein" id="modalDietProteinInput" class="form-control rounded-3 py-2" min="30" max="350" value="120" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">Meals Per Day</label>
                            <select name="MealsPerDay" id="modalDietMealsSelect" class="form-select rounded-3 py-2">
                                <option value="3">3 Meals / Day</option>
                                <option value="4" selected>4 Meals / Day</option>
                                <option value="5">5 Meals / Day</option>
                                <option value="6">6 Meals / Day</option>
                            </select>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-semibold small text-dark">Dietary Instructions & Allergies</label>
                            <textarea name="DietaryNotes" class="form-control rounded-3 py-2" rows="2" placeholder="e.g. No dairy, emphasize whole grains, ensure 3 liters of water daily."></textarea>
                            <div class="form-text small text-muted">Standard meal structure (Breakfast, Lunch, Afternoon Snack, Dinner) will be generated.</div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top px-4 py-3 bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success px-4 rounded-3 fw-semibold" style="background-color: var(--ht-teal); border: none;">
                        <i class="bi bi-check2-circle me-1"></i> Assign Nutrition Plan
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Create Reusable Diet Template (Without assigning client first) -->
<div class="modal fade" id="createDietTemplateModal" tabindex="-1" aria-labelledby="createDietTemplateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom px-4 py-3 bg-light rounded-top-4">
                <div class="d-flex align-items-center gap-3">
                    <div style="width: 40px; height: 40px; border-radius: 12px; background: #FEF3C7; color: #D97706; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                        <i class="bi bi-journal-bookmark"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark" id="createDietTemplateModalLabel">Create Reusable Diet Template</h5>
                        <p class="text-muted small mb-0">Build a standardized nutritional protocol for your library. You can assign it to clients anytime.</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="CreateDietTemplate" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body px-4 py-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold small text-dark">Template Title <span class="text-danger">*</span></label>
                            <input type="text" name="Title" class="form-control rounded-3 py-2" placeholder="e.g. High-Protein Fat Loss Protocol" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">Diet Category</label>
                            <select name="Category" class="form-select rounded-3 py-2">
                                <option value="Balanced Nutrition">Balanced Performance</option>
                                <option value="Caloric Deficit">High-Protein Fat Loss</option>
                                <option value="Mass Building">Lean Mass Hypertrophy</option>
                                <option value="Vegan & Plant">Plant-Based Metabolic Fuel</option>
                                <option value="Rehab & Recovery">Anti-Inflammatory & Mobility</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">Target Calories (kcal) <span class="text-danger">*</span></label>
                            <input type="number" name="TargetCalories" class="form-control rounded-3 py-2" min="800" max="6000" value="2100" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">Target Protein (g)</label>
                            <input type="number" name="TargetProtein" class="form-control rounded-3 py-2" min="30" max="350" value="130" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">Meals / Day</label>
                            <select name="MealsPerDay" class="form-select rounded-3 py-2">
                                <option value="3">3 Meals / Day</option>
                                <option value="4" selected>4 Meals / Day</option>
                                <option value="5">5 Meals / Day</option>
                                <option value="6">6 Meals / Day</option>
                            </select>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-semibold small text-dark">Template Description</label>
                            <textarea name="Description" class="form-control rounded-3 py-2" rows="2" placeholder="Nutritional principles, macronutrient split rationale, and guidelines."></textarea>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-semibold small text-dark">Sample Meal Blueprint</label>
                            <textarea name="MealsText" class="form-control rounded-3 py-2" rows="3" placeholder="Breakfast: Oatmeal with protein powder and blueberries (450 kcal)&#10;Lunch: Grilled chicken breast with sweet potatoes & broccoli (600 kcal)&#10;Snack: Greek yogurt with honey and almonds (300 kcal)&#10;Dinner: Salmon fillet with quinoa and asparagus (650 kcal)"></textarea>
                            <div class="form-text small text-muted">A standard meal plan will be generated if left blank.</div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top px-4 py-3 bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning px-4 rounded-3 fw-semibold text-dark" style="background-color: #F59E0B; border: none;">
                        <i class="bi bi-save me-1"></i> Save to Template Library
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Bootstrap 5 JS Bundle & Helper Script -->
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function openAssignModalForDietTemplate(title, category, calories, protein, meals) {
        document.getElementById('modalDietTitleInput').value = title;
        document.getElementById('modalDietCategorySelect').value = category;
        document.getElementById('modalDietCaloriesInput').value = calories;
        document.getElementById('modalDietProteinInput').value = protein;
        document.getElementById('modalDietMealsSelect').value = meals;
        var modal = new bootstrap.Modal(document.getElementById('createDietModal'));
        modal.show();
    }

    function openAssignModalForDietClient(clientId, clientName, calories, protein) {
        var sel = document.getElementById('modalDietClientSelect');
        for (var i = 0; i < sel.options.length; i++) {
            if (sel.options[i].value === clientId || sel.options[i].text.indexOf(clientName) > -1) {
                sel.selectedIndex = i;
                break;
            }
        }
        if (calories) document.getElementById('modalDietCaloriesInput').value = calories;
        if (protein) document.getElementById('modalDietProteinInput').value = protein;
        var modal = new bootstrap.Modal(document.getElementById('createDietModal'));
        modal.show();
    }
</script>

</body>
</html>

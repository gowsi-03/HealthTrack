                <div class="col-md-4">
                    <div class="p-3.5 rounded-3 border border-slate-100" style="background: #FAFAFA;">
                        <span class="badge bg-dark bg-opacity-10 text-dark fw-bold px-2.5 py-1 rounded-pill mb-2">Admin Account</span>

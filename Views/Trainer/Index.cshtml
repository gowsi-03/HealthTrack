<!-- Bootstrap 5 JS Bundle -->
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

@if (Model.ShowFirstTimeSetup)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var welcomeEl = document.getElementById('welcomeSetupModal');
            if (welcomeEl) {
                var welcomeModal = new bootstrap.Modal(welcomeEl);
                welcomeModal.show();
            }

            var specCards = document.querySelectorAll('.setup-spec-card');
            var hiddenInput = document.getElementById('setupSpecialtyInput');
            var customInput = document.getElementById('customSpecialtyInput');

            specCards.forEach(function (card) {
                card.addEventListener('click', function () {
                    specCards.forEach(function (c) {
                        c.classList.remove('border-success', 'shadow-sm');
                        c.style.borderColor = '#E2E8F0';
                        c.style.backgroundColor = '#FFFFFF';
                    });
                    this.classList.add('border-success', 'shadow-sm');
                    this.style.borderColor = '#10B981';
                    this.style.backgroundColor = '#F0FDF4';

                    var val = this.getAttribute('data-value');
                    if (hiddenInput) hiddenInput.value = val;
                    if (customInput) customInput.value = '';
                });
            });

            if (customInput) {
                customInput.addEventListener('input', function () {
                    if (this.value.trim().length > 0) {
                        specCards.forEach(function (c) {
                            c.classList.remove('border-success', 'shadow-sm');
                            c.style.borderColor = '#E2E8F0';
                            c.style.backgroundColor = '#FFFFFF';
                        });
                        if (hiddenInput) hiddenInput.value = this.value.trim();
                    }
                });
            }
        });
    </script>
}

@if (Model.AssignedClientsCount > 0 && Model.ChartValues != null && Model.ChartValues.Any(v => v > 0))
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const chartCanvas = document.getElementById('clientProgressChart');
            if (chartCanvas) {
                const ctx = chartCanvas.getContext('2d');
                const gradient = ctx.createLinearGradient(0, 0, 0, 200);
                gradient.addColorStop(0, 'rgba(13, 148, 136, 0.28)');
                gradient.addColorStop(1, 'rgba(13, 148, 136, 0.0)');

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels)),
                        datasets: [{
                            label: 'Average Completion (%)',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartValues)),
                            borderColor: '#0D9488',
                            borderWidth: 3,
                            backgroundColor: gradient,
                            fill: true,
                            tension: 0.35,
                            pointBackgroundColor: '#FFFFFF',
                            pointBorderColor: '#0D9488',
                            pointBorderWidth: 3,
                            pointRadius: 5,
                            pointHoverRadius: 7
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: '#0F172A',
                                titleFont: { size: 12, weight: 'bold' },
                                bodyFont: { size: 12 },
                                padding: 10,
                                cornerRadius: 8,
                                callbacks: {
                                    label: function(context) {
                                        return context.parsed.y + '% completion';
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: false,
                                min: 50,
                                max: 100,
                                grid: {
                                    color: '#F1F5F9',
                                    borderDash: [3, 3]
                                },
                                ticks: {
                                    color: '#94A3B8',
                                    font: { size: 11, weight: '600' }
                                }
                            },
                            x: {
                                grid: { display: false },
                                ticks: {
                                    color: '#94A3B8',
                                    font: { size: 11, weight: '600' }
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
}

</body>
</html>

@using Microsoft.AspNetCore.Identity
@using HealthTrack.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="d-flex align-items-center gap-3">
        <a class="nav-link-login fw-semibold" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
            Hello, @(User.Identity?.Name?.Split('@')[0])!
        </a>
        <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Logout</button>
        </form>
    </div>
}
else
{
    <div class="d-flex align-items-center gap-2">
        <a class="nav-link-login" asp-area="Identity" asp-page="/Account/Login">Log in</a>
        <a class="btn-get-started" asp-area="Identity" asp-page="/Account/Register">Get started</a>
    </div>
}

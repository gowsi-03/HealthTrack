@model HealthTrack.Models.ViewModels.DietPlansViewModel
@{
    ViewData["Title"] = "Diet Plans - HealthTrack";
    Layout = null;
    var initials = string.Join("", Model.FullName.Split(' ').Select(n => n.Length > 0 ? n[0].ToString() : "")).ToUpper();
    if (initials.Length > 2) initials = initials.Substring(0, 2);
    if (string.IsNullOrEmpty(initials)) initials = "JD";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Diet Plans - HealthTrack</title>

    <!-- Google Fonts & Bootstrap 5 & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --ht-navy: #0B192C;
            --ht-navy-hero: #0C2333;
            --ht-navy-light: #1E293B;
            --ht-navy-hover: #152840;
            --ht-green: #10B981;
            --ht-green-hover: #059669;
            --ht-green-bg: #E8F7F0;
            --ht-slate: #0F172A;
            --ht-muted: #64748B;
            --ht-border: #E2E8F0;
            --ht-bg: #F8FAFC;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--ht-bg);
            color: var(--ht-slate);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        .dashboard-container {
            display: flex;
            min-height: 100vh;
        }

        /* ========================================================= */
        /* 1. SIDEBAR (Dark Navy)                                    */
        /* ========================================================= */
        .sidebar {
            width: 255px;
            background-color: var(--ht-navy);
            color: #FFFFFF;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: sticky;
            top: 0;
            height: 100vh;
            padding: 1.75rem 1.25rem;
            flex-shrink: 0;
            z-index: 100;
        }

        .brand-header {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
            font-size: 1.35rem;
            color: #FFFFFF;
            text-decoration: none;
            margin-bottom: 2rem;
            padding-left: 0.5rem;
        }
        .brand-header:hover { color: #FFFFFF; }

        .brand-icon {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            background: linear-gradient(135deg, #10B981 0%, #059669 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #FFFFFF;
            font-size: 1.2rem;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
        }

        .nav-category {
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            color: #64748B;
            text-transform: uppercase;
            padding: 0.5rem 0.75rem;
            margin-bottom: 0.5rem;
        }

        .sidebar-nav {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 0.75rem 0.85rem;
            border-radius: 12px;
            color: #94A3B8;
            text-decoration: none;
            font-size: 0.92rem;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .sidebar-link:hover {
            color: #FFFFFF;
            background-color: var(--ht-navy-hover);
        }

        .sidebar-link.active {
            background-color: rgba(255, 255, 255, 0.08);
            color: #FFFFFF;
        }

        .sidebar-link-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sidebar-link i { font-size: 1.15rem; }

        .active-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background-color: var(--ht-green);
            box-shadow: 0 0 8px rgba(16, 185, 129, 0.7);
        }

        .support-card {
            background: rgba(30, 41, 59, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 1.15rem;
            margin-bottom: 1rem;
        }

        .support-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: rgba(16, 185, 129, 0.15);
            color: var(--ht-green);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
            margin-bottom: 0.75rem;
        }

        .support-title { font-size: 0.88rem; font-weight: 700; color: #FFFFFF; margin-bottom: 0.25rem; }
        .support-desc { font-size: 0.75rem; color: #94A3B8; margin-bottom: 0.65rem; line-height: 1.4; }
        .support-link { font-size: 0.78rem; font-weight: 700; color: #FFFFFF; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; }
        .support-link:hover { color: var(--ht-green); }

        .btn-signout {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #94A3B8;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 600;
            padding: 0.6rem 0.75rem;
            border-radius: 10px;
            background: none;
            border: none;
            width: 100%;
            text-align: left;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .btn-signout:hover { color: #EF4444; background-color: rgba(239, 68, 68, 0.1); }

        /* ========================================================= */
        /* 2. TOP NAVBAR                                             */
        /* ========================================================= */
        .main-wrapper { flex: 1; display: flex; flex-direction: column; overflow-x: hidden; }

        .top-navbar {
            background-color: #FFFFFF;
            border-bottom: 1px solid var(--ht-border);
            padding: 0.95rem 2.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 90;
        }

        .search-box { position: relative; width: 340px; }
        .search-input {
            width: 100%;
            height: 42px;
            padding: 0.5rem 1rem 0.5rem 2.5rem;
            background-color: #F8FAFC;
            border: 1px solid var(--ht-border);
            border-radius: 12px;
            font-size: 0.9rem;
            color: var(--ht-slate);
            transition: all 0.2s ease;
        }
        .search-input:focus {
            background-color: #FFFFFF;
            border-color: var(--ht-green);
            outline: none;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.12);
        }
        .search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #94A3B8;
            font-size: 0.9rem;
        }

        .top-controls { display: flex; align-items: center; gap: 1.25rem; }

        .btn-notification {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            border: 1px solid var(--ht-border);
            background: #FFFFFF;
            color: #475569;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .btn-notification:hover { background-color: #F1F5F9; color: var(--ht-slate); }

        .notify-dot {
            position: absolute;
            top: 9px;
            right: 9px;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #EF4444;
            border: 2px solid #FFFFFF;
        }

        .user-profile-pill {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 4px 8px 4px 4px;
            border-radius: 30px;
            border: 1px solid transparent;
            cursor: pointer;
            transition: all 0.15s ease;
            background: none;
        }
        .user-profile-pill:hover { background-color: #F1F5F9; border-color: var(--ht-border); }

        .avatar-initials {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: linear-gradient(135deg, #1D4ED8 0%, #10B981 100%);
            color: #FFFFFF;
            font-weight: 700;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* ========================================================= */
        /* 3. DASHBOARD BODY & MAIN HERO BANNER                      */
        /* ========================================================= */
        .dashboard-body {
            padding: 2.25rem 2.5rem 4rem;
            max-width: 1400px;
            width: 100%;
            margin: 0 auto;
        }

        .page-header-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 2rem;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

        .page-main-title {
            font-size: 2rem;
            font-weight: 800;
            color: #0F172A;
            letter-spacing: -0.025em;
            margin-bottom: 0.35rem;
        }

        .page-subtitle {
            font-size: 0.95rem;
            color: #64748B;
            font-weight: 500;
            margin: 0;
        }

        .btn-log-meal-cta {
            background-color: #059669;
            background: linear-gradient(135deg, #10B981 0%, #059669 100%);
            color: #FFFFFF !important;
            font-weight: 700;
            font-size: 0.95rem;
            padding: 0.75rem 1.6rem;
            border-radius: 12px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: none;
            box-shadow: 0 4px 14px rgba(16, 185, 129, 0.28);
            transition: all 0.2s ease;
            cursor: pointer;
        }
        .btn-log-meal-cta:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(16, 185, 129, 0.38);
            filter: brightness(1.05);
        }

        /* ========================================================= */
        /* HERO BANNER CARD (Exact match to screenshot)             */
        /* ========================================================= */
        .diet-hero-banner {
            background-color: var(--ht-navy-hero);
            background: linear-gradient(135deg, #0C2333 0%, #081B28 100%);
            color: #FFFFFF;
            border-radius: 20px;
            padding: 2.25rem 2.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 2.75rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(12, 35, 51, 0.15);
        }

        .banner-left-group {
            display: flex;
            align-items: flex-start;
            gap: 24px;
            max-width: 820px;
        }

        .banner-fork-box {
            width: 60px;
            height: 60px;
            border-radius: 16px;
            background-color: #153245;
            color: #34D399;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            margin-top: 4px;
        }

        .banner-fork-svg {
            width: 28px;
            height: 28px;
            fill: #34D399;
        }

        .menu-pill-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            background: #FFFFFF;
            border-radius: 9999px;
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            color: #065F46;
            text-transform: uppercase;
            margin-bottom: 0.85rem;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
        }

        .menu-green-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: #10B981;
        }

        .banner-plan-title {
            font-size: 1.65rem;
            font-weight: 800;
            color: #FFFFFF;
            letter-spacing: -0.02em;
            margin-bottom: 0.45rem;
        }

        .banner-plan-desc {
            font-size: 0.95rem;
            color: #94A3B8;
            line-height: 1.55;
            margin-bottom: 1.5rem;
        }

        .banner-metrics-row {
            display: flex;
            align-items: flex-start;
            gap: 3rem;
        }

        .banner-metric-col {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .banner-metric-val {
            font-size: 1.55rem;
            font-weight: 800;
            color: #FFFFFF;
            line-height: 1;
        }

        .banner-metric-lbl {
            font-size: 0.8rem;
            color: #94A3B8;
            font-weight: 500;
        }

        .btn-view-plan {
            background-color: #0D9488;
            color: #FFFFFF !important;
            font-weight: 700;
            font-size: 0.95rem;
            padding: 0.75rem 1.65rem;
            border-radius: 12px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: none;
            white-space: nowrap;
            transition: all 0.2s ease;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(13, 148, 136, 0.25);
        }
        .btn-view-plan:hover {
            background-color: #0F766E;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(13, 148, 136, 0.35);
        }

        /* ========================================================= */
        /* 4. SCHEDULE SECTION & 2x2 MEAL CARDS GRID                 */
        /* ========================================================= */
        .schedule-header {
            margin-bottom: 1.5rem;
        }

        .schedule-title {
            font-size: 1.25rem;
            font-weight: 800;
            color: #0F172A;
            letter-spacing: -0.015em;
            margin-bottom: 0.25rem;
        }

        .schedule-subtitle {
            font-size: 0.88rem;
            color: #64748B;
            font-weight: 500;
        }

        .meals-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1.5rem;
        }

        .meal-card {
            background-color: #FFFFFF;
            border: 1px solid var(--ht-border);
            border-radius: 18px;
            padding: 1.35rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            text-decoration: none;
            color: var(--ht-slate);
            transition: all 0.2s ease;
            cursor: pointer;
            box-shadow: 0 2px 6px rgba(15, 23, 42, 0.03);
            position: relative;
        }
        .meal-card:hover {
            border-color: #CBD5E1;
            box-shadow: 0 8px 24px -4px rgba(15, 23, 42, 0.07);
            transform: translateY(-2px);
            color: var(--ht-slate);
        }

        .meal-left-group {
            display: flex;
            align-items: center;
            gap: 16px;
            flex: 1;
            min-width: 0;
        }

        .meal-icon-box {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .meal-icon-logged {
            background-color: #E6F9F0;
            color: #10B981;
        }
        .meal-icon-upcoming {
            background-color: #F1F5F9;
            color: #94A3B8;
        }

        .meal-icon-svg {
            width: 22px;
            height: 22px;
        }
        .meal-icon-logged .meal-icon-svg { fill: #10B981; }
        .meal-icon-upcoming .meal-icon-svg { fill: #94A3B8; }

        .meal-text-details {
            display: flex;
            flex-direction: column;
            gap: 2px;
            min-width: 0;
        }

        .meal-time-tag {
            font-size: 0.72rem;
            font-weight: 700;
            color: #94A3B8;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .meal-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: #0F172A;
            margin: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .meal-food-desc {
            font-size: 0.82rem;
            color: #64748B;
            margin: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .meal-meta-row {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.78rem;
            color: #64748B;
            font-weight: 500;
            margin-top: 2px;
        }
        .meal-meta-row i { font-size: 0.82rem; color: #94A3B8; }

        .meal-right-group {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
        }

        .meal-status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.78rem;
            font-weight: 700;
            padding: 4px 12px;
            border-radius: 9999px;
        }
        .pill-logged {
            background-color: #ECFDF5;
            color: #059669;
        }
        .pill-upcoming {
            background-color: #F1F5F9;
            color: #64748B;
        }

        .dot-green {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: #10B981;
        }
        .dot-gray {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: #94A3B8;
        }

        .btn-circle-chevron {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            border: 1px solid var(--ht-border);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #94A3B8;
            font-size: 0.85rem;
            background: #FFFFFF;
            transition: all 0.15s ease;
        }
        .meal-card:hover .btn-circle-chevron {
            border-color: #10B981;
            color: #10B981;
            background-color: #F0FDF4;
        }

        /* Toast / Alert */
        .alert-custom-success {
            background-color: #ECFDF5;
            border: 1px solid #A7F3D0;
            color: #065F46;
            border-radius: 12px;
            font-weight: 600;
            padding: 1rem 1.25rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        @@media (max-width: 992px) {
            .sidebar { display: none; }
            .top-navbar { padding: 0.85rem 1.25rem; }
            .dashboard-body { padding: 1.5rem 1rem; }
            .diet-hero-banner { flex-direction: column; align-items: flex-start; gap: 1.5rem; padding: 1.75rem 1.5rem; }
            .banner-metrics-row { flex-wrap: wrap; gap: 1.75rem; }
            .meals-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

<!-- Fork & Knife SVG Symbol definition for crisp high-dpi rendering -->
<svg xmlns="http://www.w3.org/2000/svg" style="display: none;">
    <symbol id="icon-cutlery" viewBox="0 0 24 24">
        <!-- Fork left: 3 prongs and handle -->
        <path d="M7 2a.75.75 0 0 1 .75.75v3.5a.5.5 0 0 0 1 0v-3.5a.75.75 0 0 1 1.5 0v3.5a.5.5 0 0 0 1 0v-3.5a.75.75 0 0 1 1.5 0v3.75a3 3 0 0 1-2.25 2.9V21.25a.75.75 0 0 1-1.5 0V9.4a3 3 0 0 1-2.25-2.9V2.75A.75.75 0 0 1 7 2z"/>
        <!-- Knife right: curved blade and handle -->
        <path d="M16.5 2c-.28 0-.5.22-.5.5v8.5a.75.75 0 0 0 .75.75h.5v9.5a.75.75 0 0 0 1.5 0V2.7c0-.39-.31-.7-.75-.7h-1.5z"/>
    </symbol>
</svg>

<div class="dashboard-container">

    <!-- ========================================================= -->
    <!-- 1. LEFT SIDEBAR                                           -->
    <!-- ========================================================= -->
    <aside class="sidebar">
        <div>
            <a href="/" class="brand-header">
                <div class="brand-icon">
                    <i class="bi bi-heart-pulse-fill"></i>
                </div>
                <span>HealthTrack</span>
            </a>

            <div class="nav-category">WORKSPACE</div>
            <ul class="sidebar-nav">
                <li>
                    <a href="/Client" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-grid"></i>
                            <span>Dashboard</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Workouts" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-shield-check"></i>
                            <span>Workout Plans</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Diet" class="sidebar-link active">
                        <div class="sidebar-link-left">
                            <i class="bi bi-egg-fried"></i>
                            <span>Diet Plans</span>
                        </div>
                        <span class="active-dot"></span>
                    </a>
                </li>
                <li>
                    <a href="/Client" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-calendar2-event"></i>
                            <span>Appointments</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client#analyticsSection" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-graph-up-arrow"></i>
                            <span>Progress & Analytics</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="javascript:void(0)" onclick="alert('You have 1 new appointment update from Trainer Alex.')" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-bell"></i>
                            <span>Notifications</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-person"></i>
                            <span>Profile & Health</span>
                        </div>
                    </a>
                </li>
            </ul>
        </div>

        <div>
            <div class="support-card">
                <div class="support-icon">
                    <i class="bi bi-heart-pulse"></i>
                </div>
                <div class="support-title">Need assistance?</div>
                <div class="support-desc">Our care team is here to help with your training & nutrition goals.</div>
                <a href="mailto:support@healthtrack.com" class="support-link">
                    <span>Contact support</span>
                    <i class="bi bi-chevron-right" style="font-size: 0.7rem;"></i>
                </a>
            </div>

            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                <button type="submit" class="btn-signout">
                    <i class="bi bi-box-arrow-left"></i>
                    <span>Sign out</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- ========================================================= -->
    <!-- 2. MAIN CONTENT AREA                                      -->
    <!-- ========================================================= -->
    <div class="main-wrapper">
        
        <!-- Top Navbar -->
        <header class="top-navbar">
            <div class="search-box">
                <i class="bi bi-search search-icon"></i>
                <input type="text" class="search-input" placeholder="Search meals, recipes, macros..." />
            </div>

            <div class="top-controls">
                <!-- Notifications -->
                <button class="btn-notification" type="button" title="Notifications" onclick="alert('Latest alert: Trainer Alex reviewed your nutrition log.');">
                    <i class="bi bi-bell"></i>
                    <span class="notify-dot"></span>
                </button>

                <!-- User Profile Dropdown with working Logout -->
                <div class="dropdown">
                    <button class="user-profile-pill btn p-0 border-0 d-flex align-items-center" type="button" id="dietUserDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="avatar-initials">@initials</div>
                        <div class="user-meta d-none d-sm-block text-start ms-2">
                            <span class="fw-bold small text-dark d-block">@Model.FullName</span>
                            <span class="text-muted" style="font-size: 0.75rem;">Client</span>
                        </div>
                        <i class="bi bi-chevron-down ms-2 text-muted" style="font-size: 0.75rem;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border border-slate-100 rounded-3 mt-2 py-2" aria-labelledby="dietUserDropdown" style="min-width: 220px; z-index: 1050;">
                        <li class="px-3 py-2 border-bottom">
                            <div class="fw-bold text-dark small">@Model.FullName</div>
                            <div class="text-muted" style="font-size: 0.78rem;">@Model.Email</div>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="/Client">
                                <i class="bi bi-grid text-secondary"></i> Dashboard
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="/Client/Workouts">
                                <i class="bi bi-shield-check text-secondary"></i> Workout Plans
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li class="px-2 pt-1">
                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-2 py-1.5 d-flex align-items-center justify-content-center gap-2 fw-semibold">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Log out</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Main Body -->
        <main class="dashboard-body">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-custom-success alert-dismissible fade show" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- 1. Header Row (Title & + Log meal CTA) -->
            <div class="page-header-row">
                <div>
                    <h1 class="page-main-title">Diet plans</h1>
                    <p class="page-subtitle">Balanced nutrition designed around your preferences and goals.</p>
                </div>
                <button type="button" class="btn-log-meal-cta" data-bs-toggle="modal" data-bs-target="#logMealModal">
                    <i class="bi bi-plus-lg"></i>
                    <span>Log meal</span>
                </button>
            </div>

            <!-- 2. Hero Banner Card (Matching Screenshot media_1792516155246_4c1992a0.png) -->
            <section class="diet-hero-banner">
                <div class="banner-left-group">
                    <div class="banner-fork-box">
                        <svg class="banner-fork-svg"><use href="#icon-cutlery"/></svg>
                    </div>
                    <div>
                        <div class="menu-pill-badge">
                            <span class="menu-green-dot"></span>
                            <span>TODAY'S MENU</span>
                        </div>
                        <h2 class="banner-plan-title">@Model.PlanTitle</h2>
                        <p class="banner-plan-desc">@Model.PlanDescription</p>

                        <div class="banner-metrics-row">
                            <div class="banner-metric-col">
                                <span class="banner-metric-val">@Model.DailyTargetCalories.ToString("N0")</span>
                                <span class="banner-metric-lbl">daily kcal</span>
                            </div>
                            <div class="banner-metric-col">
                                <span class="banner-metric-val">@Model.TargetProteinGrams</span>
                                <span class="banner-metric-lbl">g protein</span>
                            </div>
                            <div class="banner-metric-col">
                                <span class="banner-metric-val">@Model.MealsPerDay</span>
                                <span class="banner-metric-lbl">meals / day</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div>
                    <button type="button" class="btn-view-plan" data-bs-toggle="modal" data-bs-target="#fullPlanModal">
                        <span>View full plan</span>
                    </button>
                </div>
            </section>

            <!-- 3. Today's meal schedule Section -->
            <section>
                <div class="schedule-header">
                    <h3 class="schedule-title">Today's meal schedule</h3>
                    <div class="schedule-subtitle">@Model.ScheduleDateText</div>
                </div>

                <!-- 2x2 Grid of Meal Cards -->
                <div class="meals-grid">
                    @foreach (var meal in Model.ScheduledMeals)
                    {
                        var isLogged = meal.IsLogged;
                        var iconClass = isLogged ? "meal-icon-logged" : "meal-icon-upcoming";
                        var pillClass = isLogged ? "pill-logged" : "pill-upcoming";
                        var dotClass = isLogged ? "dot-green" : "dot-gray";
                        var statusText = isLogged ? "Logged" : "Upcoming";

                        <div class="meal-card" onclick="openMealDetails('@meal.MealType', '@meal.MealTime', '@meal.Calories', '@meal.ProteinGrams', '@meal.CarbsGrams', '@meal.FatsGrams', '@meal.Description.Replace("'", "\\'")', '@meal.Ingredients.Replace("'", "\\'")', @(isLogged ? "true" : "false"))">
                            <div class="meal-left-group">
                                <div class="meal-icon-box @iconClass">
                                    <svg class="meal-icon-svg"><use href="#icon-cutlery"/></svg>
                                </div>
                                <div class="meal-text-details">
                                    <span class="meal-time-tag">@meal.MealTime</span>
                                    <h4 class="meal-title">@meal.MealType</h4>
                                    <p class="meal-food-desc">@meal.Description</p>
                                    <div class="meal-meta-row">
                                        <i class="bi bi-clock"></i>
                                        <span>@meal.Calories kcal</span>
                                    </div>
                                </div>
                            </div>

                            <div class="meal-right-group">
                                <span class="meal-status-pill @pillClass">
                                    <span class="@dotClass"></span>
                                    <span>@statusText</span>
                                </span>
                                <div class="btn-circle-chevron">
                                    <i class="bi bi-chevron-right"></i>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>

        </main>
    </div>
</div>

<!-- ========================================================= -->
<!-- MODAL 1: LOG MEAL (+ Log meal button)                     -->
<!-- ========================================================= -->
<div class="modal fade" id="logMealModal" tabindex="-1" aria-labelledby="logMealModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white p-4" style="background: linear-gradient(135deg, #0C2333 0%, #081B28 100%) !important;">
                <div class="d-flex align-items-center gap-3">
                    <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(16, 185, 129, 0.2); color: #10B981; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                        <svg class="meal-icon-svg" style="fill: #10B981; width: 22px; height: 22px;"><use href="#icon-cutlery"/></svg>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-white mb-0" id="logMealModalLabel">Log Nutrition Intake</h5>
                        <small class="text-white-50">Record your meal to keep your calories & macros on track</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <form asp-action="LogMealEntry" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary text-uppercase">Meal Timing</label>
                        <select asp-for="LogMealForm.MealType" class="form-select rounded-3 py-2">
                            <option value="Breakfast">Breakfast (Morning)</option>
                            <option value="Lunch" selected>Lunch (Midday)</option>
                            <option value="Afternoon snack">Afternoon snack</option>
                            <option value="Dinner">Dinner (Evening)</option>
                            <option value="Post-Workout Shake">Post-Workout Shake</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary text-uppercase">Meal Description / Food Items</label>
                        <input asp-for="LogMealForm.Description" class="form-control rounded-3 py-2" placeholder="e.g. Grilled chicken quinoa power bowl" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-secondary text-uppercase">Calories (kcal)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-fire text-danger"></i></span>
                                <input asp-for="LogMealForm.Calories" type="number" class="form-control rounded-end-3 py-2 border-start-0" placeholder="610" min="50" max="3000" required />
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-secondary text-uppercase">Protein (grams)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-shield-shaded text-primary"></i></span>
                                <input asp-for="LogMealForm.ProteinGrams" type="number" class="form-control rounded-end-3 py-2 border-start-0" placeholder="35" min="0" max="250" />
                            </div>
                        </div>
                    </div>

                    <div class="p-3 rounded-3" style="background-color: #F8FAFC; border: 1px dashed #CBD5E1;">
                        <div class="d-flex align-items-center gap-2 small text-muted">
                            <i class="bi bi-info-circle text-primary"></i>
                            <span>This meal log is recorded to your daily nutrition log and alerts your assigned trainer Alex.</span>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light p-3 border-top">
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn text-white rounded-3 px-4 fw-bold" style="background: linear-gradient(135deg, #10B981 0%, #059669 100%);">
                        <i class="bi bi-check2-circle me-1"></i> Log Meal
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================= -->
<!-- MODAL 2: VIEW FULL PLAN (View full plan button)           -->
<!-- ========================================================= -->
<div class="modal fade" id="fullPlanModal" tabindex="-1" aria-labelledby="fullPlanModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white p-4" style="background: linear-gradient(135deg, #0C2333 0%, #081B28 100%);">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill small fw-bold">ACTIVE NUTRITION ARCHITECTURE</span>
                    </div>
                    <h4 class="modal-title fw-bold text-white mb-1" id="fullPlanModalLabel">Balanced Performance Plan</h4>
                    <p class="text-white-50 mb-0 small">Designed by Trainer Alex Henderson for optimum endurance and metabolic health.</p>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <!-- Macro Breakdown Row -->
                <div class="row g-3 mb-4">
                    <div class="col-md-3 col-6">
                        <div class="p-3 rounded-3 text-center" style="background-color: #F8FAFC; border: 1px solid var(--ht-border);">
                            <div class="fw-bold fs-4 text-dark mb-0">2,150</div>
                            <div class="text-muted small fw-semibold">Target Calories</div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="p-3 rounded-3 text-center" style="background-color: #EFF6FF; border: 1px solid #DBEAFE;">
                            <div class="fw-bold fs-4 text-primary mb-0">120 g</div>
                            <div class="text-muted small fw-semibold">Protein (22%)</div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="p-3 rounded-3 text-center" style="background-color: #ECFDF5; border: 1px solid #A7F3D0;">
                            <div class="fw-bold fs-4 text-success mb-0">240 g</div>
                            <div class="text-muted small fw-semibold">Carbs (45%)</div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="p-3 rounded-3 text-center" style="background-color: #FFFBEB; border: 1px solid #FDE68A;">
                            <div class="fw-bold fs-4 text-warning mb-0">75 g</div>
                            <div class="text-muted small fw-semibold">Fats (33%)</div>
                        </div>
                    </div>
                </div>

                <!-- Guidance & Hydration -->
                <div class="card border border-slate-200 rounded-3 mb-4 p-3 bg-light">
                    <h6 class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                        <i class="bi bi-droplet-half text-info"></i> Daily Hydration & Supplementation
                    </h6>
                    <p class="text-secondary small mb-0">
                        Aim for <strong>2.8 – 3.2 Liters</strong> of clean water daily. Drink 500ml 30 minutes before training sessions. Electrolyte supplementation is recommended on heavy cardio days.
                    </p>
                </div>

                <!-- Structured Meal Timeline -->
                <h6 class="fw-bold text-dark mb-3">Structured Daily Schedule</h6>
                <div class="list-group list-group-flush border rounded-3 mb-3">
                    @foreach (var meal in Model.ScheduledMeals)
                    {
                        <div class="list-group-item p-3 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <div style="width: 36px; height: 36px; border-radius: 10px; background-color: #F1F5F9; display: flex; align-items: center; justify-content: center;">
                                    <svg class="meal-icon-svg" style="width: 18px; height: 18px; fill: #64748B;"><use href="#icon-cutlery"/></svg>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">@meal.MealType <span class="text-muted fw-normal small">(@meal.MealTime)</span></div>
                                    <div class="text-muted small">@meal.Description</div>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-light text-dark border fw-bold">@meal.Calories kcal</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="modal-footer bg-light p-3">
                <button type="button" class="btn btn-secondary rounded-3 px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================= -->
<!-- MODAL 3: MEAL DETAILS (When clicking any meal card)       -->
<!-- ========================================================= -->
<div class="modal fade" id="mealDetailModal" tabindex="-1" aria-labelledby="mealDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white p-4" style="background: linear-gradient(135deg, #0C2333 0%, #081B28 100%);">
                <div class="d-flex align-items-center gap-3">
                    <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(52, 211, 153, 0.2); color: #34D399; display: flex; align-items: center; justify-content: center;">
                        <svg class="meal-icon-svg" style="fill: #34D399; width: 22px; height: 22px;"><use href="#icon-cutlery"/></svg>
                    </div>
                    <div>
                        <span id="detailMealTime" class="badge bg-white text-dark fw-bold mb-1" style="font-size: 0.7rem;"></span>
                        <h5 class="modal-title fw-bold text-white mb-0" id="detailMealType">Meal Details</h5>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="text-muted small fw-bold text-uppercase">Dish / Food Description</label>
                    <p id="detailMealDesc" class="fs-6 fw-bold text-dark mb-0"></p>
                </div>

                <div class="row g-2 mb-3 text-center">
                    <div class="col-3">
                        <div class="p-2 rounded bg-light border">
                            <div id="detailMealCal" class="fw-bold text-dark">0</div>
                            <div class="text-muted" style="font-size: 0.7rem;">kcal</div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="p-2 rounded bg-light border">
                            <div id="detailMealProtein" class="fw-bold text-primary">0g</div>
                            <div class="text-muted" style="font-size: 0.7rem;">protein</div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="p-2 rounded bg-light border">
                            <div id="detailMealCarbs" class="fw-bold text-success">0g</div>
                            <div class="text-muted" style="font-size: 0.7rem;">carbs</div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="p-2 rounded bg-light border">
                            <div id="detailMealFats" class="fw-bold text-warning">0g</div>
                            <div class="text-muted" style="font-size: 0.7rem;">fats</div>
                        </div>
                    </div>
                </div>

                <div class="mb-3" id="ingredientsBlock">
                    <label class="text-muted small fw-bold text-uppercase">Recommended Ingredients & Portions</label>
                    <div id="detailMealIngredients" class="p-3 rounded-3 bg-light small text-secondary"></div>
                </div>

                <form id="toggleMealForm" asp-action="ToggleMealStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="mealType" id="toggleMealTypeInput" />
                    <input type="hidden" name="mealDescription" id="toggleMealDescInput" />
                    <input type="hidden" name="calories" id="toggleMealCalInput" />

                    <div class="d-grid mt-4">
                        <button type="submit" id="toggleBtn" class="btn py-2.5 fw-bold text-white rounded-3" style="background: linear-gradient(135deg, #10B981 0%, #059669 100%);">
                            <i class="bi bi-check2-circle me-1"></i> Mark as Logged
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap 5 JavaScript Bundle -->
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function openMealDetails(type, time, cal, protein, carbs, fats, desc, ingredients, isLogged) {
        document.getElementById('detailMealType').innerText = type;
        document.getElementById('detailMealTime').innerText = time;
        document.getElementById('detailMealDesc').innerText = desc;
        document.getElementById('detailMealCal').innerText = cal;
        document.getElementById('detailMealProtein').innerText = protein + 'g';
        document.getElementById('detailMealCarbs').innerText = carbs + 'g';
        document.getElementById('detailMealFats').innerText = fats + 'g';
        
        var ingEl = document.getElementById('detailMealIngredients');
        if (ingredients && ingredients.trim().length > 0) {
            ingEl.innerText = ingredients;
            document.getElementById('ingredientsBlock').style.display = 'block';
        } else {
            ingEl.innerText = desc;
        }

        document.getElementById('toggleMealTypeInput').value = type;
        document.getElementById('toggleMealDescInput').value = desc;
        document.getElementById('toggleMealCalInput').value = cal;

        var toggleBtn = document.getElementById('toggleBtn');
        if (isLogged) {
            toggleBtn.innerHTML = '<i class="bi bi-check2-all me-1"></i> Already Logged for Today';
            toggleBtn.className = 'btn py-2.5 fw-bold btn-light border text-success rounded-3';
        } else {
            toggleBtn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Mark as Logged (+ ' + cal + ' kcal)';
            toggleBtn.className = 'btn py-2.5 fw-bold text-white rounded-3';
            toggleBtn.style.background = 'linear-gradient(135deg, #10B981 0%, #059669 100%)';
        }

        var modal = new bootstrap.Modal(document.getElementById('mealDetailModal'));
        modal.show();
    }
</script>

</body>
</html>

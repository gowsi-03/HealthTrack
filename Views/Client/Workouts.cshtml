@model HealthTrack.Models.ViewModels.WorkoutPlansViewModel
@{
    ViewData["Title"] = "Workout Plans - HealthTrack";
    Layout = null;
    var initials = string.Join("", Model.FullName.Split(' ').Select(n => n.Length > 0 ? n[0].ToString() : "")).ToUpper();
    if (initials.Length > 2) initials = initials.Substring(0, 2);
    if (string.IsNullOrEmpty(initials)) initials = "AM";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Workout Plans - HealthTrack</title>

    <!-- Google Fonts & Bootstrap 5 & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --ht-navy: #0B192C;
            --ht-navy-light: #1E293B;
            --ht-navy-hover: #152840;
            --ht-green: #10B981;
            --ht-green-hover: #059669;
            --ht-green-bg: #E8F7F0;
            --ht-slate: #0F172A;
            --ht-muted: #64748B;
            --ht-border: #E2E8F0;
            --ht-bg: #F8FAFC;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--ht-bg);
            color: var(--ht-slate);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        .dashboard-container {
            display: flex;
            min-height: 100vh;
        }

        /* 1. SIDEBAR (Dark Navy) */
        .sidebar {
            width: 255px;
            background-color: var(--ht-navy);
            color: #FFFFFF;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: sticky;
            top: 0;
            height: 100vh;
            padding: 1.75rem 1.25rem;
            flex-shrink: 0;
            z-index: 100;
        }

        .brand-header {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
            font-size: 1.35rem;
            color: #FFFFFF;
            text-decoration: none;
            margin-bottom: 2rem;
            padding-left: 0.5rem;
        }
        .brand-header:hover { color: #FFFFFF; }

        .brand-icon {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            background: linear-gradient(135deg, #10B981 0%, #059669 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #FFFFFF;
            font-size: 1.2rem;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
        }

        .nav-category {
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            color: #64748B;
            text-transform: uppercase;
            padding: 0.5rem 0.75rem;
            margin-bottom: 0.5rem;
        }

        .sidebar-nav {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 0.75rem 0.85rem;
            border-radius: 12px;
            color: #94A3B8;
            text-decoration: none;
            font-size: 0.92rem;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .sidebar-link:hover {
            color: #FFFFFF;
            background-color: var(--ht-navy-hover);
        }

        .sidebar-link.active {
            background-color: rgba(255, 255, 255, 0.08);
            color: #FFFFFF;
        }

        .sidebar-link-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sidebar-link i { font-size: 1.15rem; }

        .active-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background-color: var(--ht-green);
            box-shadow: 0 0 8px rgba(16, 185, 129, 0.7);
        }

        .support-card {
            background: rgba(30, 41, 59, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 1.15rem;
            margin-bottom: 1rem;
        }

        .support-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: rgba(16, 185, 129, 0.15);
            color: var(--ht-green);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
            margin-bottom: 0.75rem;
        }

        .support-title { font-size: 0.88rem; font-weight: 700; color: #FFFFFF; margin-bottom: 0.25rem; }
        .support-desc { font-size: 0.75rem; color: #94A3B8; margin-bottom: 0.65rem; line-height: 1.4; }
        .support-link { font-size: 0.78rem; font-weight: 700; color: #FFFFFF; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; }
        .support-link:hover { color: var(--ht-green); }

        .btn-signout {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #94A3B8;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 600;
            padding: 0.6rem 0.75rem;
            border-radius: 10px;
            background: none;
            border: none;
            width: 100%;
            text-align: left;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .btn-signout:hover { color: #EF4444; background-color: rgba(239, 68, 68, 0.1); }

        /* 2. TOP NAVBAR */
        .main-wrapper { flex: 1; display: flex; flex-direction: column; overflow-x: hidden; }

        .top-navbar {
            background-color: #FFFFFF;
            border-bottom: 1px solid var(--ht-border);
            padding: 0.95rem 2.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 90;
        }

        .search-box { position: relative; width: 320px; }
        .search-input {
            width: 100%;
            height: 42px;
            padding: 0.5rem 1rem 0.5rem 2.5rem;
            background-color: #F8FAFC;
            border: 1px solid var(--ht-border);
            border-radius: 12px;
            font-size: 0.9rem;
            color: var(--ht-slate);
            transition: all 0.2s ease;
        }
        .search-input:focus {
            background-color: #FFFFFF;
            border-color: var(--ht-green);
            outline: none;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.12);
        }
        .search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #94A3B8;
            font-size: 0.9rem;
        }

        .top-controls { display: flex; align-items: center; gap: 1.25rem; }

        .btn-notification {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            border: 1px solid var(--ht-border);
            background: #FFFFFF;
            color: #475569;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            position: relative;
            cursor: pointer;
        }
        .notify-dot {
            position: absolute;
            top: 9px;
            right: 9px;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background-color: #EF4444;
        }

        .user-profile-pill {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 4px 8px 4px 4px;
            border-radius: 12px;
            cursor: pointer;
            text-decoration: none;
        }
        .avatar-initials {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: #E2E8F0;
            color: #334155;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.9rem;
        }

        /* 3. WORKOUT PAGE CONTENT */
        .dashboard-body {
            padding: 2.25rem 2.5rem;
            max-width: 1400px;
            width: 100%;
            margin: 0 auto;
        }

        .page-header-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 2rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .eyebrow-text {
            font-size: 0.75rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            color: #94A3B8;
            text-transform: uppercase;
            margin-bottom: 0.35rem;
            display: block;
        }

        .page-title {
            font-size: 2.1rem;
            font-weight: 800;
            color: #0F172A;
            letter-spacing: -0.025em;
            margin-bottom: 0.25rem;
        }

        .page-desc {
            font-size: 0.98rem;
            color: var(--ht-muted);
            margin: 0;
        }

        .btn-log-workout {
            background-color: var(--ht-green);
            color: #FFFFFF !important;
            font-weight: 700;
            font-size: 0.95rem;
            padding: 0.75rem 1.6rem;
            border-radius: 12px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: none;
            box-shadow: 0 4px 14px rgba(16, 185, 129, 0.25);
            transition: all 0.2s ease;
            cursor: pointer;
        }
        .btn-log-workout:hover {
            background-color: var(--ht-green-hover);
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(16, 185, 129, 0.35);
        }

        /* ========================================================= */
        /* ACTIVE PLAN BANNER (Matching Screenshot Exactly)         */
        /* ========================================================= */
        .active-plan-banner {
            background-color: var(--ht-navy);
            color: #FFFFFF;
            border-radius: 20px;
            padding: 2.25rem 2.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 2.75rem;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(11, 25, 44, 0.12);
        }

        .banner-left-content {
            display: flex;
            align-items: flex-start;
            gap: 24px;
            max-width: 750px;
        }

        .banner-icon-box {
            width: 58px;
            height: 58px;
            border-radius: 16px;
            background-color: #162A45;
            color: var(--ht-green);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.75rem;
            flex-shrink: 0;
            margin-top: 4px;
        }

        .active-pill-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 9999px;
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            color: #FFFFFF;
            text-transform: uppercase;
            margin-bottom: 0.85rem;
        }
        .active-green-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: var(--ht-green);
            box-shadow: 0 0 6px rgba(16, 185, 129, 0.8);
        }

        .banner-title {
            font-size: 1.65rem;
            font-weight: 800;
            color: #FFFFFF;
            letter-spacing: -0.02em;
            margin-bottom: 0.5rem;
        }

        .banner-desc {
            font-size: 0.95rem;
            color: #94A3B8;
            line-height: 1.55;
            margin-bottom: 1.5rem;
        }

        .banner-metrics-row {
            display: flex;
            align-items: baseline;
            gap: 2.75rem;
        }

        .banner-metric-item {
            display: flex;
            align-items: baseline;
            gap: 6px;
        }

        .banner-metric-num {
            font-size: 1.5rem;
            font-weight: 800;
            color: #FFFFFF;
            line-height: 1;
        }

        .banner-metric-label {
            font-size: 0.82rem;
            color: #94A3B8;
            font-weight: 500;
        }

        .btn-view-full-plan {
            background-color: var(--ht-green);
            color: #FFFFFF !important;
            font-weight: 700;
            font-size: 0.92rem;
            padding: 0.75rem 1.75rem;
            border-radius: 12px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            border: none;
            box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3);
            transition: all 0.2s ease;
            cursor: pointer;
            flex-shrink: 0;
        }
        .btn-view-full-plan:hover {
            background-color: var(--ht-green-hover);
            transform: translateY(-1px);
        }

        /* ========================================================= */
        /* SESSIONS SECTION (Matching Screenshot Exactly)           */
        /* ========================================================= */
        .section-header-title {
            font-size: 1.3rem;
            font-weight: 800;
            color: #0F172A;
            letter-spacing: -0.015em;
            margin-bottom: 0.25rem;
        }

        .section-header-sub {
            font-size: 0.9rem;
            color: #64748B;
            margin-bottom: 1.5rem;
        }

        .session-card {
            background: #FFFFFF;
            border: 1px solid var(--ht-border);
            border-radius: 18px;
            padding: 1.5rem 1.65rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 100%;
            transition: all 0.2s ease;
            cursor: pointer;
            text-decoration: none;
            color: var(--ht-slate);
        }
        .session-card:hover {
            border-color: #CBD5E1;
            box-shadow: 0 10px 24px -6px rgba(15, 23, 42, 0.06);
            transform: translateY(-2px);
            color: var(--ht-slate);
        }

        .session-time-eyebrow {
            font-size: 0.8rem;
            font-weight: 600;
            color: #94A3B8;
            margin-bottom: 0.9rem;
        }

        .session-body-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
        }

        .session-left-group {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .session-icon-box {
            width: 46px;
            height: 46px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            flex-shrink: 0;
        }
        .icon-box-active {
            background-color: #E8F7F0;
            color: var(--ht-green);
        }
        .icon-box-upcoming {
            background-color: #F1F5F9;
            color: #64748B;
        }

        .session-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: #0F172A;
            margin-bottom: 0.25rem;
        }

        .session-exercises-count {
            font-size: 0.8rem;
            color: #64748B;
            margin-bottom: 0.4rem;
        }

        .session-meta-row {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.78rem;
            color: #94A3B8;
        }

        .session-right-group {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 0.78rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 9999px;
        }
        .badge-in-progress {
            background-color: #ECFDF5;
            color: #059669;
        }
        .badge-upcoming {
            background-color: #F1F5F9;
            color: #64748B;
        }

        .status-dot-green {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: #10B981;
        }
        .status-dot-gray {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: #94A3B8;
        }

        .btn-circle-arrow {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            border: 1px solid var(--ht-border);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #64748B;
            font-size: 0.85rem;
            transition: all 0.15s ease;
            background: #FFFFFF;
        }
        .session-card:hover .btn-circle-arrow {
            border-color: var(--ht-green);
            color: var(--ht-green);
            background-color: #F0FDF4;
        }

        @@media (max-width: 992px) {
            .sidebar { display: none; }
            .top-navbar { padding: 0.85rem 1.25rem; }
            .dashboard-body { padding: 1.5rem 1rem; }
            .active-plan-banner { flex-direction: column; align-items: flex-start; gap: 1.5rem; }
            .banner-metrics-row { flex-wrap: wrap; gap: 1.5rem; }
        }
    </style>
</head>
<body>

<div class="dashboard-container">

    <!-- ========================================================= -->
    <!-- 1. LEFT SIDEBAR                                           -->
    <!-- ========================================================= -->
    <aside class="sidebar">
        <div>
            <a href="/" class="brand-header">
                <div class="brand-icon">
                    <i class="bi bi-heart-pulse-fill"></i>
                </div>
                <span>HealthTrack</span>
            </a>

            <div class="nav-category">WORKSPACE</div>
            <ul class="sidebar-nav">
                <li>
                    <a href="/Client" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-grid"></i>
                            <span>Dashboard</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Workouts" class="sidebar-link active">
                        <div class="sidebar-link-left">
                            <i class="bi bi-shield-check"></i>
                            <span>Workout Plans</span>
                        </div>
                        <span class="active-dot"></span>
                    </a>
                </li>
                <li>
                    <a href="/Client/Diet" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-egg-fried"></i>
                            <span>Diet Plans</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Appointments" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-calendar2-event"></i>
                            <span>Appointments</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Analytics" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-graph-up-arrow"></i>
                            <span>Progress & Analytics</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="javascript:void(0)" onclick="alert('You have 1 new appointment update from Trainer Alex.')" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-bell"></i>
                            <span>Notifications</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-person"></i>
                            <span>Profile & Health</span>
                        </div>
                    </a>
                </li>
            </ul>
        </div>

        <div>
            <div class="support-card">
                <div class="support-icon">
                    <i class="bi bi-heart-pulse"></i>
                </div>
                <div class="support-title">Need assistance?</div>
                <div class="support-desc">Our care team is here to help with your training goals.</div>
                <a href="mailto:support@healthtrack.com" class="support-link">
                    <span>Contact support</span>
                    <i class="bi bi-chevron-right" style="font-size: 0.7rem;"></i>
                </a>
            </div>

            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                <button type="submit" class="btn-signout">
                    <i class="bi bi-box-arrow-left"></i>
                    <span>Sign out</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- ========================================================= -->
    <!-- 2. MAIN CONTENT AREA                                      -->
    <!-- ========================================================= -->
    <div class="main-wrapper">
        
        <!-- Top Navbar -->
        <header class="top-navbar">
            <div class="search-box">
                <i class="bi bi-search search-icon"></i>
                <input type="text" class="search-input" placeholder="Search exercises, routines..." />
            </div>

            <div class="top-controls">
                <button type="button" class="btn-notification" onclick="alert('Notification: Upper body session scheduled for 5:30 PM today.')" title="Notifications">
                    <i class="bi bi-bell"></i>
                    <span class="notify-dot"></span>
                </button>

                <!-- User Profile Dropdown -->
                <div class="dropdown">
                    <button class="user-profile-pill btn p-0 border-0 d-flex align-items-center" type="button" id="workoutUserDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="avatar-initials">@initials</div>
                        <div class="user-meta d-none d-sm-block text-start ms-2">
                            <span class="fw-bold small text-dark d-block">@Model.FullName</span>
                            <span class="text-muted" style="font-size: 0.75rem;">Client</span>
                        </div>
                        <i class="bi bi-chevron-down ms-2 text-muted" style="font-size: 0.75rem;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border border-slate-100 rounded-3 mt-2 py-2" aria-labelledby="workoutUserDropdown" style="min-width: 220px; z-index: 1050;">
                        <li class="px-3 py-2 border-bottom">
                            <div class="fw-bold text-dark small">@Model.FullName</div>
                            <div class="text-muted" style="font-size: 0.78rem;">@Model.Email</div>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="/Client">
                                <i class="bi bi-grid text-secondary"></i> Dashboard
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li class="px-2 pt-1">
                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-2 py-1.5 d-flex align-items-center justify-content-center gap-2 fw-semibold">
                                    <i class="bi bi-box-arrow-left"></i> Log out
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Main Body -->
        <main class="dashboard-body">

            <!-- Success Alert -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3 shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Page Title Row -->
            <div class="page-header-row">
                <div>
                    <span class="eyebrow-text">MY HEALTH PLAN</span>
                    <h1 class="page-title">Workout plans</h1>
                    <p class="page-desc">Build strength and consistency with plans tailored to your goals.</p>
                </div>
                <div>
                    <button type="button" class="btn-log-workout" onclick="openLogModal()">
                        <i class="bi bi-plus-lg"></i>
                        <span>Log workout</span>
                    </button>
                </div>
            </div>

            <!-- ================================================= -->
            <!-- ACTIVE PLAN HERO BANNER (Matching Screenshot)     -->
            <!-- ================================================= -->
            <div class="active-plan-banner">
                <div class="banner-left-content">
                    <div class="banner-icon-box">
                        <i class="bi bi-activity"></i>
                    </div>
                    <div>
                        <div class="active-pill-badge">
                            <span class="active-green-dot"></span>
                            <span>ACTIVE PLAN</span>
                        </div>
                        <h2 class="banner-title">@Model.ProgramTitle</h2>
                        <p class="banner-desc">@Model.ProgramDescription</p>

                        <div class="banner-metrics-row">
                            <div class="banner-metric-item">
                                <span class="banner-metric-num">@Model.DaysPerWeek</span>
                                <span class="banner-metric-label">days / week</span>
                            </div>
                            <div class="banner-metric-item">
                                <span class="banner-metric-num">@Model.MinutesPerSession</span>
                                <span class="banner-metric-label">min / session</span>
                            </div>
                            <div class="banner-metric-item">
                                <span class="banner-metric-num" id="completionRateText">@Model.CompletionPercentage%</span>
                                <span class="banner-metric-label">completed</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div>
                    <button type="button" class="btn-view-full-plan" onclick="openPlanModal()">
                        View full plan
                    </button>
                </div>
            </div>

            <!-- ================================================= -->
            <!-- THIS WEEK'S SESSIONS (Matching Screenshot)        -->
            <!-- ================================================= -->
            <div>
                <h3 class="section-header-title">This week's sessions</h3>
                <div class="section-header-sub">@Model.CurrentWeekText</div>

                <div class="row g-4">
                    @foreach (var session in Model.WeeklySessions)
                    {
                        <div class="col-lg-6">
                            <div class="session-card" onclick="openSessionModal('@session.Title', '@session.DaySchedule', '@session.ExerciseCount')">
                                <div class="session-time-eyebrow">@session.DaySchedule</div>

                                <div class="session-body-row">
                                    <div class="session-left-group">
                                        <div class="session-icon-box @(session.IsActiveSession ? "icon-box-active" : "icon-box-upcoming")">
                                            <i class="bi bi-activity"></i>
                                        </div>
                                        <div>
                                            <div class="session-title">@session.Title</div>
                                            <div class="session-exercises-count">@session.ExerciseCount exercises</div>
                                            <div class="session-meta-row">
                                                <span><i class="bi bi-clock me-1"></i>@session.DurationMinutes min</span>
                                                <span>•</span>
                                                <span>@session.Intensity</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="session-right-group">
                                        @if (session.Status == "In progress")
                                        {
                                            <span class="status-badge badge-in-progress">
                                                <span class="status-dot-green"></span>
                                                <span>In progress</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge badge-upcoming">
                                                <span class="status-dot-gray"></span>
                                                <span>Upcoming</span>
                                            </span>
                                        }

                                        <div class="btn-circle-arrow">
                                            <i class="bi bi-chevron-right"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </main>
    </div>

</div>

<!-- ========================================================= -->
<!-- MODAL: LOG WORKOUT                                        -->
<!-- ========================================================= -->
<div class="modal fade" id="logWorkoutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Log Workout Session</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="LogWorkoutSession" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">Session Name</label>
                        <input asp-for="LogWorkoutForm.WorkoutName" class="form-control rounded-3" value="Upper body strength" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">Duration (Minutes)</label>
                        <input asp-for="LogWorkoutForm.DurationMinutes" type="number" class="form-control rounded-3" value="45" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">Calories Burned (kcal)</label>
                        <input asp-for="LogWorkoutForm.CaloriesBurned" type="number" class="form-control rounded-3" value="420" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">Performance Notes</label>
                        <textarea asp-for="LogWorkoutForm.Notes" class="form-control rounded-3" rows="2" placeholder="Sets completed, weights used, how you felt"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-3 px-4 fw-semibold" style="background-color: #10B981; border: none;">Record Workout</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================= -->
<!-- MODAL: VIEW FULL PLAN & EXERCISE CHECKLIST                -->
<!-- ========================================================= -->
<div class="modal fade" id="planModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title fw-bold" id="planModalTitle">@Model.ProgramTitle</h5>
                    <div class="small text-muted">Coached by @Model.TrainerName • Tap checkmark when exercise is finished</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="exercise-checklist mt-2">
                    @if (Model.Exercises != null && Model.Exercises.Any())
                    {
                        foreach (var ex in Model.Exercises)
                        {
                            <div class="d-flex align-items-center justify-content-between p-3 mb-2 rounded-3 border" style="background: #FAFAFA;">
                                <div class="form-check d-flex align-items-center gap-3 mb-0">
                                    <input class="form-check-input" type="checkbox" style="width: 20px; height: 20px;" id="chk_@ex.Id" @(ex.IsCompleted ? "checked" : "") onchange="toggleExercise(@ex.Id)" />
                                    <div>
                                        <label class="form-check-label fw-bold text-dark d-block" for="chk_@ex.Id">@ex.Name</label>
                                        <span class="small text-muted">Target: @ex.Sets • @ex.Reps</span>
                                    </div>
                                </div>
                                <span class="badge @(ex.IsCompleted ? "bg-success" : "bg-light text-secondary") rounded-pill px-3 py-1.5">
                                    @(ex.IsCompleted ? "Completed" : "Pending")
                                </span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-between p-3 mb-2 rounded-3 border" style="background: #FAFAFA;">
                            <div class="form-check d-flex align-items-center gap-3 mb-0">
                                <input class="form-check-input" type="checkbox" style="width: 20px; height: 20px;" checked />
                                <div>
                                    <label class="form-check-label fw-bold text-dark d-block">Barbell Bench Press</label>
                                    <span class="small text-muted">Target: 4 sets • 10 reps (60 kg)</span>
                                </div>
                            </div>
                            <span class="badge bg-success rounded-pill px-3 py-1.5">Completed</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between p-3 mb-2 rounded-3 border" style="background: #FAFAFA;">
                            <div class="form-check d-flex align-items-center gap-3 mb-0">
                                <input class="form-check-input" type="checkbox" style="width: 20px; height: 20px;" checked />
                                <div>
                                    <label class="form-check-label fw-bold text-dark d-block">Incline Dumbbell Rows</label>
                                    <span class="small text-muted">Target: 3 sets • 12 reps (18 kg)</span>
                                </div>
                            </div>
                            <span class="badge bg-success rounded-pill px-3 py-1.5">Completed</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between p-3 mb-2 rounded-3 border" style="background: #FAFAFA;">
                            <div class="form-check d-flex align-items-center gap-3 mb-0">
                                <input class="form-check-input" type="checkbox" style="width: 20px; height: 20px;" />
                                <div>
                                    <label class="form-check-label fw-bold text-dark d-block">Overhead Dumbbell Press</label>
                                    <span class="small text-muted">Target: 3 sets • 10 reps (35 kg)</span>
                                </div>
                            </div>
                            <span class="badge bg-light text-secondary rounded-pill px-3 py-1.5">Pending</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between p-3 mb-2 rounded-3 border" style="background: #FAFAFA;">
                            <div class="form-check d-flex align-items-center gap-3 mb-0">
                                <input class="form-check-input" type="checkbox" style="width: 20px; height: 20px;" />
                                <div>
                                    <label class="form-check-label fw-bold text-dark d-block">Tricep Rope Pushdowns</label>
                                    <span class="small text-muted">Target: 3 sets • 15 reps (25 kg)</span>
                                </div>
                            </div>
                            <span class="badge bg-light text-secondary rounded-pill px-3 py-1.5">Pending</span>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-success w-100 rounded-3 py-2 fw-semibold" style="background-color: #10B981; border: none;" data-bs-dismiss="modal">Done Reviewing</button>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script>
    const logModal = new bootstrap.Modal(document.getElementById('logWorkoutModal'));
    const planModal = new bootstrap.Modal(document.getElementById('planModal'));

    function openLogModal() { logModal.show(); }
    function openPlanModal() { planModal.show(); }

    function openSessionModal(title, time, count) {
        document.getElementById('planModalTitle').textContent = title + ' (' + count + ' exercises)';
        planModal.show();
    }

    function toggleExercise(id) {
        fetch('/Client/ToggleExercise/' + id, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        }).then(res => res.json()).then(data => {
            console.log('Exercise toggled:', data);
        }).catch(err => console.error(err));
    }
</script>

</body>
</html>

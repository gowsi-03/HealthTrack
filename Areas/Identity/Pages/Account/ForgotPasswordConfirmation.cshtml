@page
@model HealthTrack.Areas.Identity.Pages.Account.ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Check your email";
    Layout = null;
    var resetUrl = TempData["ResetCallbackUrl"] as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Check your email - HealthTrack</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --ht-green: #10B981;
            --ht-green-hover: #059669;
            --ht-green-bg: #ECFDF5;
            --ht-dark-navy: #0B192C;
            --ht-slate: #0F172A;
            --ht-muted: #64748B;
            --ht-border: #E2E8F0;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #FFFFFF;
            color: #0F172A;
            min-height: 100vh;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        .split-layout {
            display: flex;
            min-height: 100vh;
            width: 100vw;
        }

        .hero-panel {
            flex: 0 0 44%;
            background-color: var(--ht-dark-navy);
            color: #FFFFFF;
            padding: 3.5rem 4.5rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

        .hero-rings {
            position: absolute;
            bottom: -100px;
            right: -100px;
            width: 540px;
            height: 540px;
            border-radius: 50%;
            border: 50px solid rgba(30, 41, 59, 0.45);
            pointer-events: none;
            z-index: 1;
        }

        .brand-header {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
            font-size: 1.5rem;
            color: #FFFFFF;
            text-decoration: none;
            z-index: 2;
        }

        .brand-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: linear-gradient(135deg, #10B981 0%, #059669 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #FFFFFF;
            font-size: 1.3rem;
            box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);
        }

        .hero-center-content {
            z-index: 2;
            max-width: 480px;
            margin: auto 0;
            padding: 2.5rem 0;
        }

        .pill-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 9999px;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            color: #E2E8F0;
            text-transform: uppercase;
            margin-bottom: 2rem;
        }

        .hero-heading {
            font-size: clamp(2.3rem, 3.6vw, 3.2rem);
            font-weight: 800;
            line-height: 1.15;
            letter-spacing: -0.03em;
            margin-bottom: 1.5rem;
            color: #FFFFFF;
        }

        .hero-subtext {
            font-size: 1.08rem;
            line-height: 1.6;
            color: #94A3B8;
        }

        .hero-footer {
            z-index: 2;
            font-size: 0.82rem;
            color: #64748B;
        }

        .form-panel {
            flex: 1;
            background-color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem 2rem;
            position: relative;
        }

        .form-container {
            width: 100%;
            max-width: 460px;
            text-align: center;
        }

        .icon-mail-circle {
            width: 72px;
            height: 72px;
            border-radius: 20px;
            background-color: var(--ht-green-bg);
            color: var(--ht-green);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 2.2rem;
            margin-bottom: 1.75rem;
            box-shadow: 0 8px 24px rgba(16, 185, 129, 0.18);
        }

        .eyebrow-tag {
            font-size: 0.75rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            color: var(--ht-green);
            text-transform: uppercase;
            margin-bottom: 0.5rem;
            display: block;
        }

        .form-title {
            font-size: 2rem;
            font-weight: 700;
            color: #0F172A;
            letter-spacing: -0.025em;
            margin-bottom: 0.65rem;
        }

        .form-subtitle {
            font-size: 1rem;
            color: var(--ht-muted);
            line-height: 1.6;
            margin-bottom: 2rem;
        }

        .btn-submit-ht {
            background-color: var(--ht-green);
            color: #FFFFFF;
            font-weight: 600;
            font-size: 1rem;
            height: 48px;
            border-radius: 10px;
            border: none;
            width: 100%;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s ease;
            box-shadow: 0 4px 14px rgba(16, 185, 129, 0.25);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        .btn-submit-ht:hover {
            background-color: var(--ht-green-hover);
            color: #FFFFFF;
            transform: translateY(-1px);
        }

        .demo-sim-box {
            background: #F0FDF4;
            border: 1px solid #BBF7D0;
            border-radius: 14px;
            padding: 1.25rem;
            margin-bottom: 2rem;
            text-align: left;
        }

        @@media (max-width: 992px) {
            .split-layout { flex-direction: column; }
            .hero-panel { flex: none; padding: 2.5rem 1.5rem; }
            .hero-rings { display: none; }
            .form-panel { padding: 2.5rem 1.5rem; }
        }
    </style>
</head>
<body>

<div class="split-layout">
    <div class="hero-panel">
        <div class="hero-rings"></div>

        <a href="/" class="brand-header">
            <div class="brand-icon">
                <i class="bi bi-heart-pulse-fill"></i>
            </div>
            <span>HealthTrack</span>
        </a>

        <div class="hero-center-content">
            <div class="pill-tag">
                <span class="pill-dot"></span>
                <span>Security Notice</span>
            </div>

            <h1 class="hero-heading">
                Check your inbox<br>
                to continue.
            </h1>

            <p class="hero-subtext">
                We've sent a confidential password reset link. For your security, this link expires in 24 hours.
            </p>
        </div>

        <div class="hero-footer">
            &copy; 2025 HealthTrack. Your privacy, protected.
        </div>
    </div>

    <div class="form-panel">
        <div class="form-container">
            <div class="icon-mail-circle">
                <i class="bi bi-envelope-check-fill"></i>
            </div>

            <span class="eyebrow-tag">Instructions Dispatched</span>
            <h2 class="form-title">Check your email</h2>
            <p class="form-subtitle">
                Please check your inbox (and spam folder) for instructions to reset your password.
            </p>

            @if (!string.IsNullOrEmpty(resetUrl))
            {
                <div class="demo-sim-box">
                    <div class="d-flex align-items-center gap-2 mb-2 text-success fw-bold">
                        <i class="bi bi-patch-check-fill fs-5"></i>
                        <span>Gmail / Viva Evaluation Simulation</span>
                    </div>
                    <p class="small text-muted mb-3">
                        In this local demonstration environment, click the button below to simulate opening the reset email sent to your address:
                    </p>
                    <a href="@resetUrl" class="btn btn-sm btn-success rounded-pill px-3 py-2 fw-semibold w-100">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Open Password Reset Form
                    </a>
                </div>
            }

            <a asp-page="./Login" class="btn-submit-ht">
                <span>Return to log in</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</div>

</body>
</html>

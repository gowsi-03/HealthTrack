@model HealthTrack.Models.ViewModels.NotificationsViewModel
@{
    ViewData["Title"] = "Notifications - HealthTrack";
    Layout = null;
    var initials = string.Join("", Model.FullName.Split(' ').Select(n => n.Length > 0 ? n[0].ToString() : "")).ToUpper();
    if (initials.Length > 2) initials = initials.Substring(0, 2);
    if (string.IsNullOrEmpty(initials)) initials = "JD";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Notifications - HealthTrack</title>

    <!-- Google Fonts & Bootstrap 5 & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --ht-navy: #0B192C;
            --ht-navy-light: #1E293B;
            --ht-navy-hover: #152840;
            --ht-green: #10B981;
            --ht-green-hover: #059669;
            --ht-teal: #0D9488;
            --ht-teal-light: #CCFBF1;
            --ht-slate: #0F172A;
            --ht-muted: #64748B;
            --ht-border: #E2E8F0;
            --ht-bg: #F8FAFC;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--ht-bg);
            color: var(--ht-slate);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        .dashboard-container {
            display: flex;
            min-height: 100vh;
        }

        /* ========================================================= */
        /* 1. SIDEBAR (Dark Navy)                                    */
        /* ========================================================= */
        .sidebar {
            width: 255px;
            background-color: var(--ht-navy);
            color: #FFFFFF;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: sticky;
            top: 0;
            height: 100vh;
            max-height: 100vh;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 1.5rem 1.15rem;
            flex-shrink: 0;
            z-index: 100;
        }

        .sidebar::-webkit-scrollbar {
            width: 5px;
        }
        .sidebar::-webkit-scrollbar-track {
            background: rgba(11, 25, 44, 0.4);
        }
        .sidebar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 4px;
        }
        .sidebar::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.35);
        }

        .brand-header {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
            font-size: 1.35rem;
            color: #FFFFFF;
            text-decoration: none;
            margin-bottom: 1.35rem;
            padding-left: 0.5rem;
        }
        .brand-header:hover { color: #FFFFFF; }

        .brand-icon {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            background: linear-gradient(135deg, #10B981 0%, #059669 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #FFFFFF;
            font-size: 1.2rem;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
        }

        .nav-category {
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            color: #64748B;
            text-transform: uppercase;
            padding: 0.5rem 0.75rem;
            margin-bottom: 0.5rem;
        }

        .sidebar-nav {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 0.65rem 0.85rem;
            border-radius: 12px;
            color: #94A3B8;
            text-decoration: none;
            font-size: 0.92rem;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .sidebar-link:hover {
            color: #FFFFFF;
            background-color: var(--ht-navy-hover);
        }

        .sidebar-link.active {
            background-color: rgba(255, 255, 255, 0.08);
            color: #FFFFFF;
        }

        .sidebar-link-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sidebar-link i { font-size: 1.15rem; }

        .active-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background-color: var(--ht-green);
            box-shadow: 0 0 8px rgba(16, 185, 129, 0.7);
        }

        .sidebar-bottom-section {
            margin-top: 1.25rem;
            flex-shrink: 0;
            padding-bottom: 0.75rem;
        }

        .support-card {
            background: rgba(30, 41, 59, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 1rem;
            margin-bottom: 0.75rem;
        }

        .support-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: rgba(16, 185, 129, 0.15);
            color: var(--ht-green);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
            margin-bottom: 0.75rem;
        }

        .support-title { font-size: 0.88rem; font-weight: 700; color: #FFFFFF; margin-bottom: 0.25rem; }
        .support-desc { font-size: 0.75rem; color: #94A3B8; margin-bottom: 0.65rem; line-height: 1.4; }
        .support-link { font-size: 0.78rem; font-weight: 700; color: #FFFFFF; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; }
        .support-link:hover { color: var(--ht-green); }

        .btn-signout {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #94A3B8;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 600;
            padding: 0.6rem 0.75rem;
            border-radius: 10px;
            background: none;
            border: none;
            width: 100%;
            text-align: left;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .btn-signout:hover { color: #EF4444; background-color: rgba(239, 68, 68, 0.1); }

        /* ========================================================= */
        /* 2. TOP NAVBAR                                             */
        /* ========================================================= */
        .main-wrapper { flex: 1; display: flex; flex-direction: column; overflow-x: hidden; }

        .top-navbar {
            background-color: #FFFFFF;
            border-bottom: 1px solid var(--ht-border);
            padding: 0.95rem 2.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 90;
        }

        .search-box { position: relative; width: 340px; }
        .search-input {
            width: 100%;
            height: 42px;
            padding: 0.5rem 1rem 0.5rem 2.5rem;
            background-color: #F8FAFC;
            border: 1px solid var(--ht-border);
            border-radius: 12px;
            font-size: 0.9rem;
            color: var(--ht-slate);
            transition: all 0.2s ease;
        }
        .search-input:focus {
            background-color: #FFFFFF;
            border-color: var(--ht-green);
            outline: none;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.12);
        }
        .search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #94A3B8;
            font-size: 0.9rem;
        }

        .top-controls { display: flex; align-items: center; gap: 1.25rem; }

        .btn-notification {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            border: 1px solid var(--ht-border);
            background: #FFFFFF;
            color: #475569;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.15s ease;
        }
        .btn-notification:hover { background-color: #F1F5F9; color: var(--ht-slate); }

        .notify-dot {
            position: absolute;
            top: 9px;
            right: 9px;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #10B981;
            border: 2px solid #FFFFFF;
        }

        .user-profile-pill {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 4px 8px 4px 4px;
            border-radius: 30px;
            border: 1px solid transparent;
            cursor: pointer;
            transition: all 0.15s ease;
            background: none;
        }
        .user-profile-pill:hover { background-color: #F1F5F9; border-color: var(--ht-border); }

        .avatar-initials {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: linear-gradient(135deg, #1D4ED8 0%, #10B981 100%);
            color: #FFFFFF;
            font-weight: 700;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* ========================================================= */
        /* 3. DASHBOARD BODY & MAIN LAYOUT                           */
        /* ========================================================= */
        .dashboard-body {
            padding: 2.25rem 2.5rem 4rem;
            max-width: 1400px;
            width: 100%;
            margin: 0 auto;
        }

        /* Page Header */
        .page-header-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 2rem;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

        .page-eyebrow {
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            color: #64748B;
            text-transform: uppercase;
            margin-bottom: 0.35rem;
        }

        .page-main-title {
            font-size: 2rem;
            font-weight: 800;
            color: #0F172A;
            letter-spacing: -0.025em;
            margin-bottom: 0.35rem;
        }

        .page-subtitle {
            font-size: 0.95rem;
            color: #64748B;
            font-weight: 500;
            margin: 0;
        }

        .btn-mark-all-read {
            background-color: #FFFFFF;
            border: 1px solid var(--ht-border);
            color: #0F172A;
            font-weight: 600;
            font-size: 0.9rem;
            padding: 0.6rem 1.35rem;
            border-radius: 12px;
            transition: all 0.15s ease;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
            cursor: pointer;
        }
        .btn-mark-all-read:hover {
            background-color: #F8FAFC;
            border-color: #CBD5E1;
            color: #0F172A;
        }

        /* ========================================================= */
        /* 4. NOTIFICATIONS CARD CONTAINER (Exact match to image)    */
        /* ========================================================= */
        .notifications-card {
            background-color: #FFFFFF;
            border: 1px solid var(--ht-border);
            border-radius: 20px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
            overflow: hidden;
        }

        .notification-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1.5rem 2rem;
            border-bottom: 1px solid #F1F5F9;
            transition: background-color 0.15s ease;
            position: relative;
        }
        .notification-row:last-child {
            border-bottom: none;
        }
        .notification-row:hover {
            background-color: #FAFCFF;
        }

        /* Left green stripe for unread notifications */
        .notification-row.unread {
            border-left: 4px solid var(--ht-green);
            background-color: rgba(232, 247, 240, 0.15);
        }
        .notification-row.read {
            border-left: 4px solid transparent;
        }

        .row-left-content {
            display: flex;
            align-items: center;
            gap: 20px;
            flex: 1;
            min-width: 0;
        }

        /* Notification Icon Box */
        .notif-icon-box {
            width: 46px;
            height: 46px;
            border-radius: 14px;
            background-color: #E8F7F0;
            color: var(--ht-green);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            flex-shrink: 0;
        }

        .notif-text-col {
            display: flex;
            flex-direction: column;
            gap: 2px;
            min-width: 0;
        }

        .notif-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: #0F172A;
            margin: 0;
        }

        .notif-body {
            font-size: 0.88rem;
            color: #64748B;
            margin: 0;
            line-height: 1.45;
        }

        .notif-time {
            font-size: 0.78rem;
            color: #94A3B8;
            font-weight: 500;
            margin-top: 3px;
        }

        /* Right actions & unread indicator */
        .row-right-content {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-shrink: 0;
        }

        .unread-dot-green {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: var(--ht-green);
        }

        .btn-dots-menu {
            background: none;
            border: none;
            color: #94A3B8;
            font-weight: 800;
            font-size: 1.15rem;
            cursor: pointer;
            padding: 4px 8px;
            border-radius: 8px;
            transition: all 0.15s ease;
        }
        .btn-dots-menu:hover {
            color: #0F172A;
            background-color: #F1F5F9;
        }

        /* Toast / Alert */
        .alert-custom-success {
            background-color: #ECFDF5;
            border: 1px solid #A7F3D0;
            color: #065F46;
            border-radius: 12px;
            font-weight: 600;
            padding: 1rem 1.25rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* Empty state */
        .empty-state {
            padding: 4rem 2rem;
            text-align: center;
        }
        .empty-icon {
            width: 64px;
            height: 64px;
            border-radius: 20px;
            background-color: #F1F5F9;
            color: #94A3B8;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin-bottom: 1.25rem;
        }

        @@media (max-width: 992px) {
            .sidebar { display: none; }
            .top-navbar { padding: 0.85rem 1.25rem; }
            .dashboard-body { padding: 1.5rem 1rem; }
            .notification-row { flex-direction: column; align-items: flex-start; gap: 1rem; }
            .row-right-content { width: 100%; justify-content: flex-end; }
        }
    </style>
</head>
<body>

<!-- Fork & Knife SVG Symbol definition for crisp high-dpi cutlery rendering -->
<svg xmlns="http://www.w3.org/2000/svg" style="display: none;">
    <symbol id="icon-cutlery" viewBox="0 0 24 24">
        <path d="M7 2a.75.75 0 0 1 .75.75v3.5a.5.5 0 0 0 1 0v-3.5a.75.75 0 0 1 1.5 0v3.5a.5.5 0 0 0 1 0v-3.5a.75.75 0 0 1 1.5 0v3.75a3 3 0 0 1-2.25 2.9V21.25a.75.75 0 0 1-1.5 0V9.4a3 3 0 0 1-2.25-2.9V2.75A.75.75 0 0 1 7 2z"/>
        <path d="M16.5 2c-.28 0-.5.22-.5.5v8.5a.75.75 0 0 0 .75.75h.5v9.5a.75.75 0 0 0 1.5 0V2.7c0-.39-.31-.7-.75-.7h-1.5z"/>
    </symbol>
</svg>

<div class="dashboard-container">

    <!-- ========================================================= -->
    <!-- 1. LEFT SIDEBAR                                           -->
    <!-- ========================================================= -->
    <aside class="sidebar">
        <div>
            <a href="/" class="brand-header">
                <div class="brand-icon">
                    <i class="bi bi-heart-pulse-fill"></i>
                </div>
                <span>HealthTrack</span>
            </a>

            <div class="nav-category">WORKSPACE</div>
            <ul class="sidebar-nav">
                <li>
                    <a href="/Client" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-grid"></i>
                            <span>Dashboard</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Workouts" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-shield-check"></i>
                            <span>Workout Plans</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Diet" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-egg-fried"></i>
                            <span>Diet Plans</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Appointments" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-calendar2-event"></i>
                            <span>Appointments</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Analytics" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-graph-up-arrow"></i>
                            <span>Progress & Analytics</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Notifications" class="sidebar-link active">
                        <div class="sidebar-link-left">
                            <i class="bi bi-bell"></i>
                            <span>Notifications</span>
                        </div>
                        <span class="active-dot"></span>
                    </a>
                </li>
                <li>
                    <a href="/Client/Profile" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-person"></i>
                            <span>Profile & Health</span>
                        </div>
                    </a>
                </li>
            </ul>
        </div>

        <div class="sidebar-bottom-section">
            <div class="support-card">
                <div class="support-icon">
                    <i class="bi bi-heart-pulse"></i>
                </div>
                <div class="support-title">Need assistance?</div>
                <div class="support-desc">Our team is here to support your health journey.</div>
                <a href="mailto:support@healthtrack.com" class="support-link">
                    <span>Contact support</span>
                    <i class="bi bi-chevron-right" style="font-size: 0.7rem;"></i>
                </a>
            </div>

            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                <button type="submit" class="btn-signout">
                    <i class="bi bi-box-arrow-left"></i>
                    <span>Sign out</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- ========================================================= -->
    <!-- 2. MAIN CONTENT AREA                                      -->
    <!-- ========================================================= -->
    <div class="main-wrapper">
        
        <!-- Top Navbar -->
        <header class="top-navbar">
            <div class="search-box">
                <i class="bi bi-search search-icon"></i>
                <input type="text" class="search-input" placeholder="Search notifications, alerts..." />
            </div>

            <div class="top-controls">
                <!-- Notifications Bell -->
                <a href="/Client/Notifications" class="btn-notification" title="Notifications">
                    <i class="bi bi-bell"></i>
                    @if (Model.UnreadCount > 0)
                    {
                        <span class="notify-dot"></span>
                    }
                </a>

                <!-- User Profile Dropdown with working Logout -->
                <div class="dropdown">
                    <button class="user-profile-pill btn p-0 border-0 d-flex align-items-center" type="button" id="notifUserDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="avatar-initials">@initials</div>
                        <div class="user-meta d-none d-sm-block text-start ms-2">
                            <span class="fw-bold small text-dark d-block">@Model.FullName</span>
                            <span class="text-muted" style="font-size: 0.75rem;">Client</span>
                        </div>
                        <i class="bi bi-chevron-down ms-2 text-muted" style="font-size: 0.75rem;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border border-slate-100 rounded-3 mt-2 py-2" aria-labelledby="notifUserDropdown" style="min-width: 220px; z-index: 1050;">
                        <li class="px-3 py-2 border-bottom">
                            <div class="fw-bold text-dark small">@Model.FullName</div>
                            <div class="text-muted" style="font-size: 0.78rem;">@Model.Email</div>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="/Client">
                                <i class="bi bi-grid text-secondary"></i> Dashboard
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="/Client/Workouts">
                                <i class="bi bi-shield-check text-secondary"></i> Workout Plans
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="/Client/Diet">
                                <i class="bi bi-egg-fried text-secondary"></i> Diet Plans
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="/Client/Appointments">
                                <i class="bi bi-calendar2-event text-secondary"></i> Appointments
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="/Client/Analytics">
                                <i class="bi bi-graph-up-arrow text-secondary"></i> Progress & Analytics
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="/Client/Profile">
                                <i class="bi bi-person text-secondary"></i> Profile & Health
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li class="px-2 pt-1">
                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-2 py-1.5 d-flex align-items-center justify-content-center gap-2 fw-semibold">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Log out</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Main Body -->
        <main class="dashboard-body">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-custom-success alert-dismissible fade show" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- 1. Header Row (STAY UPDATED, Title & Mark all as read CTA) -->
            <div class="page-header-row">
                <div>
                    <div class="page-eyebrow">STAY UPDATED</div>
                    <h1 class="page-main-title">Notifications</h1>
                    <p class="page-subtitle">Reminders and updates from your health team.</p>
                </div>
                
                <form asp-action="MarkAllNotificationsAsRead" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-mark-all-read">
                        Mark all as read
                    </button>
                </form>
            </div>

            <!-- 2. Notifications Card (Exact match to media_1792593460829_608ca178.png) -->
            <div class="notifications-card">
                @if (Model.Notifications.Any())
                {
                    @foreach (var item in Model.Notifications)
                    {
                        var unreadClass = item.IsRead ? "read" : "unread";

                        <div class="notification-row @unreadClass" id="notif-@item.Id">
                            <div class="row-left-content">
                                <!-- Icon Box -->
                                <div class="notif-icon-box">
                                    @if (item.IconType == "dumbbell")
                                    {
                                        <i class="bi bi-record-circle-fill" style="display: none;"></i>
                                        <!-- Crisp dumbbell icon -->
                                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="#10B981" viewBox="0 0 16 16">
                                            <path d="M12 2a1 1 0 0 1 1 1v1h1a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-1v1a1 1 0 0 1-2 0V3a1 1 0 0 1 1-1M2 4a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h1v1a1 1 0 0 0 2 0V3a1 1 0 0 0-2 0v1zm3 3.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5"/>
                                        </svg>
                                    }
                                    else if (item.IconType == "calendar")
                                    {
                                        <i class="bi bi-calendar2-check" style="font-size: 1.25rem; color: #10B981;"></i>
                                    }
                                    else if (item.IconType == "cutlery")
                                    {
                                        <svg style="width: 22px; height: 22px; fill: #10B981;"><use href="#icon-cutlery"/></svg>
                                    }
                                    else
                                    {
                                        <i class="bi bi-activity" style="font-size: 1.35rem; color: #10B981;"></i>
                                    }
                                </div>

                                <!-- Text column -->
                                <div class="notif-text-col">
                                    <h4 class="notif-title">@item.Title</h4>
                                    <p class="notif-body">@item.Body</p>
                                    <span class="notif-time">@item.TimeAgo</span>
                                </div>
                            </div>

                            <!-- Right actions & unread dot -->
                            <div class="row-right-content">
                                @if (!item.IsRead)
                                {
                                    <span class="unread-dot-green"></span>
                                }

                                <div class="dropdown">
                                    <button class="btn-dots-menu" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border border-slate-100 rounded-3">
                                        <li>
                                            <form asp-action="ToggleNotificationRead" asp-route-id="@item.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item small">
                                                    @(item.IsRead ? "Mark as unread" : "Mark as read")
                                                </button>
                                            </form>
                                        </li>
                                        <li>
                                            <form asp-action="DeleteNotification" asp-route-id="@item.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item small text-danger">
                                                    Delete notification
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="bi bi-bell-slash"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">No notifications</h5>
                        <p class="text-muted small mb-0">You're all caught up with your updates and training alerts.</p>
                    </div>
                }
            </div>

        </main>
    </div>
</div>

<!-- Bootstrap 5 JavaScript Bundle -->
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>

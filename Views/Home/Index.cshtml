@{
    ViewData["Title"] = "Build Healthier Habits. See Real Progress.";
}

<style>
    /* Hero Atmosphere & Layout */
    .saas-hero-container {
        position: relative;
        padding: 4.5rem 0 5rem;
        overflow: hidden;
        background: #FFFFFF;
    }

    /* Soft organic blurred background shapes from screenshot */
    .bg-shape-green {
        position: absolute;
        width: 520px;
        height: 520px;
        right: -40px;
        top: 20px;
        background: radial-gradient(circle, rgba(16, 185, 129, 0.16) 0%, rgba(16, 185, 129, 0.04) 60%, rgba(255, 255, 255, 0) 70%);
        border-radius: 50%;
        filter: blur(40px);
        z-index: 1;
        pointer-events: none;
    }

    .bg-shape-blue {
        position: absolute;
        width: 440px;
        height: 440px;
        right: 280px;
        top: 140px;
        background: radial-gradient(circle, rgba(29, 78, 216, 0.08) 0%, rgba(29, 78, 216, 0.02) 60%, rgba(255, 255, 255, 0) 70%);
        border-radius: 50%;
        filter: blur(45px);
        z-index: 1;
        pointer-events: none;
    }

    /* Pill Badge */
    .pill-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        background-color: #F1F5F9;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.6px;
        color: #475569;
        text-transform: uppercase;
        margin-bottom: 1.75rem;
    }

    .pill-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background-color: #10B981;
    }

    /* Headline Typography */
    .hero-title {
        font-size: clamp(2.75rem, 5vw, 4.25rem);
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -0.035em;
        color: #0F172A;
        margin-bottom: 1.5rem;
    }

    .hero-accent {
        color: #10B981;
    }

    .hero-desc {
        font-size: 1.15rem;
        line-height: 1.65;
        color: #64748B;
        max-width: 520px;
        margin-bottom: 2.25rem;
    }

    /* CTA Buttons Matching Reference */
    .btn-journey {
        background-color: #10B981;
        color: #FFFFFF !important;
        font-weight: 700;
        font-size: 1rem;
        padding: 0.85rem 1.75rem;
        border-radius: 14px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: none;
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);
        transition: all 0.2s ease;
    }
    .btn-journey:hover {
        background-color: #059669;
        transform: translateY(-2px);
        box-shadow: 0 8px 22px rgba(16, 185, 129, 0.45);
    }

    .btn-login-card {
        background-color: #FFFFFF;
        color: #0F172A !important;
        font-weight: 600;
        font-size: 1rem;
        padding: 0.85rem 1.65rem;
        border-radius: 14px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        border: 1px solid #E2E8F0;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
        transition: all 0.2s ease;
    }
    .btn-login-card:hover {
        background-color: #F8FAFC;
        border-color: #CBD5E1;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
    }

    /* Trust Micro-Checkmarks */
    .trust-items {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        margin-top: 2rem;
        font-size: 0.85rem;
        color: #64748B;
        font-weight: 500;
    }
    .trust-item {
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .trust-check {
        color: #10B981;
        font-weight: 700;
    }

    /* ========================================= */
    /* Floating Activity Card (Matching Visual)   */
    /* ========================================= */
    .visual-wrapper {
        position: relative;
        z-index: 2;
    }

    .card-activity {
        background: #FFFFFF;
        border-radius: 28px;
        padding: 2.25rem 2rem 1.75rem;
        box-shadow: 0 25px 60px -15px rgba(15, 23, 42, 0.12), 0 0 0 1px rgba(226, 232, 240, 0.8);
        position: relative;
        transform: rotate(1deg);
        transition: transform 0.3s ease;
    }
    .card-activity:hover {
        transform: rotate(0deg);
    }

    .activity-top-bar {
        width: 100px;
        height: 6px;
        background: #E2E8F0;
        border-radius: 9999px;
        margin-bottom: 2rem;
    }

    .activity-label {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.75px;
        color: #94A3B8;
        text-transform: uppercase;
        margin-bottom: 0.5rem;
    }

    .activity-stat-row {
        display: flex;
        align-items: baseline;
        gap: 12px;
        margin-bottom: 1.5rem;
    }

    .activity-value {
        font-size: 2.5rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        color: #0F172A;
        line-height: 1;
    }

    .badge-percent {
        display: inline-flex;
        align-items: center;
        font-size: 0.8rem;
        font-weight: 700;
        color: #10B981;
        background: rgba(16, 185, 129, 0.12);
        padding: 3px 8px;
        border-radius: 6px;
    }

    /* Floating Pills */
    .pill-health-score {
        position: absolute;
        top: -18px;
        right: -14px;
        background: #FFFFFF;
        padding: 10px 18px;
        border-radius: 18px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08), 0 0 0 1px #F1F5F9;
        display: flex;
        align-items: center;
        gap: 10px;
        z-index: 4;
        animation: floatPill1 4s ease-in-out infinite;
    }

    .pill-goal-completed {
        position: absolute;
        bottom: 20px;
        left: -28px;
        background: #FFFFFF;
        padding: 12px 18px;
        border-radius: 18px;
        box-shadow: 0 14px 32px rgba(0, 0, 0, 0.09), 0 0 0 1px #F1F5F9;
        display: flex;
        align-items: center;
        gap: 12px;
        z-index: 4;
        animation: floatPill2 4.5s ease-in-out infinite;
    }

    @@keyframes floatPill1 {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-6px); }
    }

    @@keyframes floatPill2 {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(6px); }
    }

    .icon-heart-pill {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        background: #ECFDF5;
        color: #10B981;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

    .icon-check-pill {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        background: #ECFDF5;
        color: #10B981;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    /* Features Section */
    .section-features {
        padding: 6rem 0;
        background: #FAFAFA;
        border-top: 1px solid #F1F5F9;
    }
    .feature-box {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 20px;
        padding: 2.25rem 2rem;
        height: 100%;
        transition: all 0.25s ease;
    }
    .feature-box:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 32px -10px rgba(15, 23, 42, 0.08);
        border-color: #CBD5E1;
    }
    .feature-icon-circle {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        margin-bottom: 1.5rem;
    }
</style>

<!-- ========================================================= -->
<!-- 1. HERO SECTION (Matching User's Reference Screenshot)     -->
<!-- ========================================================= -->
<section class="saas-hero-container">
    <!-- Atmospheric Ambient Circles -->
    <div class="bg-shape-green"></div>
    <div class="bg-shape-blue"></div>

    <div class="container position-relative" style="z-index: 2;">
        <div class="row align-items-center g-5">
            
            <!-- Left Column: Typography & CTAs -->
            <div class="col-lg-6">
                <!-- Top Small Pill Badge -->
                <div class="pill-label">
                    <span class="pill-dot"></span>
                    <span>Your health, in one place</span>
                </div>

                <!-- Main Bold Headline -->
                <h1 class="hero-title">
                    Build healthier habits.<br />
                    <span class="hero-accent">See real progress.</span>
                </h1>

                <!-- Body Copy -->
                <p class="hero-desc">
                    HealthTrack brings your workouts, nutrition, appointments and progress together in one secure, easy-to-use platform.
                </p>

                <!-- Dual Action Buttons -->
                <div class="d-flex flex-wrap gap-3">
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn-journey">
                        <span>Start your journey</span>
                        <i class="bi bi-chevron-right" style="font-size: 0.85rem; stroke-width: 1;"></i>
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn-login-card">
                        <span>Log in to your account</span>
                    </a>
                </div>

                <!-- Trust Micro-Checkmarks -->
                <div class="trust-items">
                    <div class="trust-item">
                        <span class="trust-check">✓</span>
                        <span>Free to get started</span>
                    </div>
                    <div class="trust-item">
                        <span class="trust-check">✓</span>
                        <span>Secure & private</span>
                    </div>
                    <div class="trust-item">
                        <span class="trust-check">✓</span>
                        <span>Cancel anytime</span>
                    </div>
                </div>
            </div>

            <!-- Right Column: Interactive Graphic Card Matching Reference -->
            <div class="col-lg-6">
                <div class="visual-wrapper px-sm-4">
                    
                    <!-- Floating Top Right Badge -->
                    <div class="pill-health-score">
                        <div class="icon-heart-pill">
                            <i class="bi bi-heart"></i>
                        </div>
                        <div>
                            <span class="d-block" style="font-size: 0.7rem; color: #94A3B8; font-weight: 600;">Health score</span>
                            <span class="fw-bold" style="font-size: 0.85rem; color: #0F172A;">Excellent • 92</span>
                        </div>
                    </div>

                    <!-- Main White Tilted Card -->
                    <div class="card-activity">
                        <!-- Top gray pill bar -->
                        <div class="activity-top-bar"></div>

                        <div class="activity-label">Weekly Activity</div>
                        
                        <div class="activity-stat-row">
                            <span class="activity-value">4h 32m</span>
                            <span class="badge-percent">+18%</span>
                        </div>

                        <!-- Smooth Upward Curved Graph Matching Reference -->
                        <div style="position: relative; width: 100%; height: 160px; margin-top: 1rem;">
                            <!-- Horizontal faint guide lines -->
                            <div style="position: absolute; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: space-between; pointer-events: none; opacity: 0.4;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span style="font-size: 11px; color: #CBD5E1; width: 18px;">90</span>
                                    <div style="flex: 1; border-bottom: 1px solid #F1F5F9;"></div>
                                </div>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span style="font-size: 11px; color: #CBD5E1; width: 18px;">75</span>
                                    <div style="flex: 1; border-bottom: 1px solid #F1F5F9;"></div>
                                </div>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span style="font-size: 11px; color: #CBD5E1; width: 18px;">60</span>
                                    <div style="flex: 1; border-bottom: 1px solid #F1F5F9;"></div>
                                </div>
                            </div>

                            <!-- Vector Bezier Curve with Gradient Area Fill -->
                            <svg viewBox="0 0 450 140" style="width: 100%; height: 100%; overflow: visible;" preserveAspectRatio="none">
                                <defs>
                                    <linearGradient id="curveAreaGrad" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#10B981" stop-opacity="0.25" />
                                        <stop offset="100%" stop-color="#10B981" stop-opacity="0.0" />
                                    </linearGradient>
                                </defs>
                                
                                <!-- Filled area under curve -->
                                <path d="M 20 115 
                                         C 80 110, 130 90, 180 82 
                                         C 230 75, 270 95, 320 50 
                                         C 360 20, 400 35, 430 22 
                                         L 430 140 L 20 140 Z" 
                                      fill="url(#curveAreaGrad)" />

                                <!-- Main Curving Emerald Line -->
                                <path d="M 20 115 
                                         C 80 110, 130 90, 180 82 
                                         C 230 75, 270 95, 320 50 
                                         C 360 20, 400 35, 430 22" 
                                      fill="none" 
                                      stroke="#10B981" 
                                      stroke-width="3.5" 
                                      stroke-linecap="round" />

                                <!-- Points along the curve -->
                                <circle cx="20" cy="115" r="4.5" fill="#FFFFFF" stroke="#10B981" stroke-width="2.5" />
                                <circle cx="180" cy="82" r="4.5" fill="#FFFFFF" stroke="#10B981" stroke-width="2.5" />
                                <circle cx="320" cy="50" r="4.5" fill="#FFFFFF" stroke="#10B981" stroke-width="2.5" />
                                <circle cx="430" cy="22" r="5.5" fill="#10B981" stroke="#FFFFFF" stroke-width="2.5" />
                            </svg>
                        </div>

                        <!-- Date labels matching screenshot -->
                        <div class="d-flex justify-content-between text-muted pt-3" style="font-size: 0.75rem; color: #94A3B8 !important; border-top: 1px solid #F1F5F9;">
                            <span>Mar 01</span>
                            <span>Mar 08</span>
                            <span>Mar 15</span>
                            <span>Mar 22</span>
                            <span>Mar 29</span>
                        </div>
                    </div>

                    <!-- Floating Bottom Left Badge -->
                    <div class="pill-goal-completed">
                        <div class="icon-check-pill">
                            <i class="bi bi-check2"></i>
                        </div>
                        <div>
                            <span class="d-block" style="font-size: 0.7rem; color: #94A3B8; font-weight: 600;">Goal completed</span>
                            <span class="fw-bold" style="font-size: 0.85rem; color: #0F172A;">Morning workout</span>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>


<!-- ========================================================= -->
<!-- 2. FEATURES GRID (Mapped to the 8 Coursework Tasks)        -->
<!-- ========================================================= -->
<section id="features" class="section-features">
    <div class="container">
        
        <div class="text-center max-w-xl mx-auto mb-5">
            <span class="pill-label mb-2">Platform Capabilities</span>
            <h2 class="fw-bold text-dark" style="font-size: 2.25rem; letter-spacing: -0.02em;">Everything you need to succeed</h2>
            <p class="text-secondary small">Comprehensive tools built for clients, certified personal trainers, and system administrators.</p>
        </div>

        <div class="row g-4">
            <!-- Feature 1: Workouts -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-box">
                    <div class="feature-icon-circle" style="background: rgba(16, 185, 129, 0.1); color: #10B981;">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Personalized Workouts</h5>
                    <p class="text-secondary small mb-0">
                        Trainers create structured exercise splits with exact sets, reps, and weights. Clients track completions in real time.
                    </p>
                </div>
            </div>

            <!-- Feature 2: Diet -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-box">
                    <div class="feature-icon-circle" style="background: rgba(29, 78, 216, 0.1); color: #1D4ED8;">
                        <i class="bi bi-egg-fried"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Nutrition & Diet Plans</h5>
                    <p class="text-secondary small mb-0">
                        Caloric target calculations, scheduled meals (Breakfast, Lunch, Dinner), and macro breakdowns (Protein/Carb/Fat).
                    </p>
                </div>
            </div>

            <!-- Feature 3: Analytics -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-box">
                    <div class="feature-icon-circle" style="background: rgba(139, 92, 246, 0.1); color: #8B5CF6;">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Progress & BMI Analytics</h5>
                    <p class="text-secondary small mb-0">
                        Interactive Chart.js trends tracking weight loss, BMI classifications, and active calories burned over time.
                    </p>
                </div>
            </div>

            <!-- Feature 4: Appointments -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-box">
                    <div class="feature-icon-circle" style="background: rgba(59, 130, 246, 0.1); color: #3B82F6;">
                        <i class="bi bi-calendar2-check-fill"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Conflict-Free Appointments</h5>
                    <p class="text-secondary small mb-0">
                        Schedule consultations with certified trainers with automated conflict-detection preventing double bookings.
                    </p>
                </div>
            </div>

            <!-- Feature 5: Notifications -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-box">
                    <div class="feature-icon-circle" style="background: rgba(245, 158, 11, 0.1); color: #F59E0B;">
                        <i class="bi bi-bell-fill"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">In-App Notifications</h5>
                    <p class="text-secondary small mb-0">
                        Instant activity alerts whenever a trainer assigns a routine, approves a session, or when goals are completed.
                    </p>
                </div>
            </div>

            <!-- Feature 6: Security -->
            <div class="col-md-6 col-lg-4">
                <div class="feature-box">
                    <div class="feature-icon-circle" style="background: rgba(239, 68, 68, 0.1); color: #EF4444;">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Enterprise Security</h5>
                    <p class="text-secondary small mb-0">
                        ASP.NET Core Identity with password hashing, anti-forgery verification, and strict role-based data isolation.
                    </p>
                </div>
            </div>
        </div>

    </div>
</section>


<!-- ========================================================= -->
<!-- 3. HOW IT WORKS (3 Simple Steps)                          -->
<!-- ========================================================= -->
<section id="how-it-works" class="py-5 bg-white">
    <div class="container py-4">
        
        <div class="text-center mb-5">
            <span class="pill-label mb-2">Step by Step</span>
            <h2 class="fw-bold text-dark" style="font-size: 2.25rem;">How HealthTrack Works</h2>
        </div>

        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="p-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold fs-4 mb-3" style="width: 56px; height: 56px; background: #ECFDF5; color: #10B981;">
                        1
                    </div>
                    <h5 class="fw-bold text-dark">Create Your Profile</h5>
                    <p class="text-secondary small">Register your account with your height, baseline weight, and target fitness goal.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold fs-4 mb-3" style="width: 56px; height: 56px; background: #EFF6FF; color: #1D4ED8;">
                        2
                    </div>
                    <h5 class="fw-bold text-dark">Get Assigned Routines</h5>
                    <p class="text-secondary small">Your certified trainer customizes your workout splits and daily target diet calories.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold fs-4 mb-3" style="width: 56px; height: 56px; background: #FAF5FF; color: #8B5CF6;">
                        3
                    </div>
                    <h5 class="fw-bold text-dark">Track & Celebrate</h5>
                    <p class="text-secondary small">Log workouts, record daily body measurements, and watch your progress graphs climb.</p>
                </div>
            </div>
        </div>

    </div>
</section>


<!-- ========================================================= -->

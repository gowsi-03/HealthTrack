@model HealthTrack.Models.ViewModels.ProgressAnalyticsViewModel
@{
    ViewData["Title"] = "Progress & Analytics - HealthTrack";
    Layout = null;
    var initials = string.Join("", Model.FullName.Split(' ').Select(n => n.Length > 0 ? n[0].ToString() : "")).ToUpper();
    if (initials.Length > 2) initials = initials.Substring(0, 2);
    if (string.IsNullOrEmpty(initials)) initials = "JD";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Progress & Analytics - HealthTrack</title>

    <!-- Google Fonts & Bootstrap 5 & Icons & Chart.js -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --ht-navy: #0B192C;
            --ht-navy-light: #1E293B;
            --ht-navy-hover: #152840;
            --ht-green: #10B981;
            --ht-green-hover: #059669;
            --ht-teal: #0D9488;
            --ht-teal-light: #CCFBF1;
            --ht-slate: #0F172A;
            --ht-muted: #64748B;
            --ht-border: #E2E8F0;
            --ht-bg: #F8FAFC;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--ht-bg);
            color: var(--ht-slate);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        .dashboard-container {
            display: flex;
            min-height: 100vh;
        }

        /* ========================================================= */
        /* 1. SIDEBAR (Dark Navy)                                    */
        /* ========================================================= */
        .sidebar {
            width: 255px;
            background-color: var(--ht-navy);
            color: #FFFFFF;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: sticky;
            top: 0;
            height: 100vh;
            max-height: 100vh;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 1.5rem 1.15rem;
            flex-shrink: 0;
            z-index: 100;
        }

        .sidebar::-webkit-scrollbar {
            width: 5px;
        }
        .sidebar::-webkit-scrollbar-track {
            background: rgba(11, 25, 44, 0.4);
        }
        .sidebar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 4px;
        }
        .sidebar::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.35);
        }

        .brand-header {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
            font-size: 1.35rem;
            color: #FFFFFF;
            text-decoration: none;
            margin-bottom: 1.35rem;
            padding-left: 0.5rem;
        }
        .brand-header:hover { color: #FFFFFF; }

        .brand-icon {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            background: linear-gradient(135deg, #10B981 0%, #059669 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #FFFFFF;
            font-size: 1.2rem;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
        }

        .nav-category {
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            color: #64748B;
            text-transform: uppercase;
            padding: 0.5rem 0.75rem;
            margin-bottom: 0.5rem;
        }

        .sidebar-nav {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 0.65rem 0.85rem;
            border-radius: 12px;
            color: #94A3B8;
            text-decoration: none;
            font-size: 0.92rem;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .sidebar-link:hover {
            color: #FFFFFF;
            background-color: var(--ht-navy-hover);
        }

        .sidebar-link.active {
            background-color: rgba(255, 255, 255, 0.08);
            color: #FFFFFF;
        }

        .sidebar-link-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sidebar-link i { font-size: 1.15rem; }

        .active-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background-color: var(--ht-green);
            box-shadow: 0 0 8px rgba(16, 185, 129, 0.7);
        }

        .sidebar-bottom-section {
            margin-top: 1.25rem;
            flex-shrink: 0;
            padding-bottom: 0.75rem;
        }

        .support-card {
            background: rgba(30, 41, 59, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 1rem;
            margin-bottom: 0.75rem;
        }

        .support-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: rgba(16, 185, 129, 0.15);
            color: var(--ht-green);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
            margin-bottom: 0.75rem;
        }

        .support-title { font-size: 0.88rem; font-weight: 700; color: #FFFFFF; margin-bottom: 0.25rem; }
        .support-desc { font-size: 0.75rem; color: #94A3B8; margin-bottom: 0.65rem; line-height: 1.4; }
        .support-link { font-size: 0.78rem; font-weight: 700; color: #FFFFFF; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; }
        .support-link:hover { color: var(--ht-green); }

        .btn-signout {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #94A3B8;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 600;
            padding: 0.6rem 0.75rem;
            border-radius: 10px;
            background: none;
            border: none;
            width: 100%;
            text-align: left;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .btn-signout:hover { color: #EF4444; background-color: rgba(239, 68, 68, 0.1); }

        /* ========================================================= */
        /* 2. TOP NAVBAR                                             */
        /* ========================================================= */
        .main-wrapper { flex: 1; display: flex; flex-direction: column; overflow-x: hidden; }

        .top-navbar {
            background-color: #FFFFFF;
            border-bottom: 1px solid var(--ht-border);
            padding: 0.95rem 2.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 90;
        }

        .search-box { position: relative; width: 340px; }
        .search-input {
            width: 100%;
            height: 42px;
            padding: 0.5rem 1rem 0.5rem 2.5rem;
            background-color: #F8FAFC;
            border: 1px solid var(--ht-border);
            border-radius: 12px;
            font-size: 0.9rem;
            color: var(--ht-slate);
            transition: all 0.2s ease;
        }
        .search-input:focus {
            background-color: #FFFFFF;
            border-color: var(--ht-green);
            outline: none;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.12);
        }
        .search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #94A3B8;
            font-size: 0.9rem;
        }

        .top-controls { display: flex; align-items: center; gap: 1.25rem; }

        .btn-notification {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            border: 1px solid var(--ht-border);
            background: #FFFFFF;
            color: #475569;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .btn-notification:hover { background-color: #F1F5F9; color: var(--ht-slate); }

        .notify-dot {
            position: absolute;
            top: 9px;
            right: 9px;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #EF4444;
            border: 2px solid #FFFFFF;
        }

        .user-profile-pill {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 4px 8px 4px 4px;
            border-radius: 30px;
            border: 1px solid transparent;
            cursor: pointer;
            transition: all 0.15s ease;
            background: none;
        }
        .user-profile-pill:hover { background-color: #F1F5F9; border-color: var(--ht-border); }

        .avatar-initials {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: linear-gradient(135deg, #1D4ED8 0%, #10B981 100%);
            color: #FFFFFF;
            font-weight: 700;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* ========================================================= */
        /* 3. DASHBOARD BODY & MAIN LAYOUT                           */
        /* ========================================================= */
        .dashboard-body {
            padding: 2.25rem 2.5rem 4rem;
            max-width: 1400px;
            width: 100%;
            margin: 0 auto;
        }

        /* Page Header */
        .page-header-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 1.75rem;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

        .page-eyebrow {
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            color: #64748B;
            text-transform: uppercase;
            margin-bottom: 0.35rem;
        }

        .page-main-title {
            font-size: 2rem;
            font-weight: 800;
            color: #0F172A;
            letter-spacing: -0.025em;
            margin-bottom: 0.35rem;
        }

        .page-subtitle {
            font-size: 0.95rem;
            color: #64748B;
            font-weight: 500;
            margin: 0;
        }

        .btn-export-report {
            background-color: #FFFFFF;
            border: 1px solid var(--ht-border);
            color: #0F172A;
            font-weight: 600;
            font-size: 0.9rem;
            padding: 0.6rem 1.25rem;
            border-radius: 12px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s ease;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
            cursor: pointer;
        }
        .btn-export-report:hover {
            background-color: #F8FAFC;
            border-color: #CBD5E1;
            color: #0F172A;
        }

        /* ========================================================= */
        /* 4. FILTER CONTROLS BAR                                    */
        /* ========================================================= */
        .filter-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 1.75rem;
            flex-wrap: wrap;
        }

        .filter-pill-btn {
            height: 40px;
            padding: 0.45rem 1.15rem;
            background-color: #FFFFFF;
            border: 1px solid var(--ht-border);
            border-radius: 12px;
            font-size: 0.88rem;
            font-weight: 600;
            color: #475569;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .filter-pill-btn:hover {
            border-color: #CBD5E1;
            background-color: #F8FAFC;
            color: #0F172A;
        }

        .btn-apply-filters {
            height: 40px;
            padding: 0.45rem 1.35rem;
            background-color: #FFFFFF;
            border: 1px solid var(--ht-border);
            border-radius: 12px;
            font-size: 0.88rem;
            font-weight: 700;
            color: #0F172A;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .btn-apply-filters:hover {
            background-color: #0B192C;
            color: #FFFFFF;
            border-color: #0B192C;
        }

        /* ========================================================= */
        /* 5. 4 KPI METRIC CARDS                                     */
        /* ========================================================= */
        .kpi-cards-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.25rem;
            margin-bottom: 1.75rem;
        }

        .kpi-card {
            background-color: #FFFFFF;
            border: 1px solid var(--ht-border);
            border-radius: 16px;
            padding: 1.35rem 1.5rem;
            box-shadow: 0 2px 6px rgba(15, 23, 42, 0.02);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .kpi-label {
            font-size: 0.78rem;
            color: #64748B;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .kpi-value {
            font-size: 1.75rem;
            font-weight: 800;
            color: #0F172A;
            line-height: 1.1;
            margin-bottom: 0.35rem;
            letter-spacing: -0.02em;
        }

        .kpi-subtext {
            font-size: 0.78rem;
            color: #64748B;
            font-weight: 500;
        }

        /* ========================================================= */
        /* 6. CHARTS ROW (Weight Trend & Workout Activity)           */
        /* ========================================================= */
        .charts-row {
            display: grid;
            grid-template-columns: 1.6fr 1fr;
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .chart-card {
            background-color: #FFFFFF;
            border: 1px solid var(--ht-border);
            border-radius: 20px;
            padding: 1.5rem 1.75rem;
            box-shadow: 0 2px 6px rgba(15, 23, 42, 0.02);
            display: flex;
            flex-direction: column;
        }

        .chart-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 1rem;
        }

        .chart-title {
            font-size: 1.1rem;
            font-weight: 800;
            color: #0F172A;
            margin-bottom: 0.2rem;
        }

        .chart-subtitle {
            font-size: 0.8rem;
            color: #64748B;
            margin: 0;
        }

        .chart-metric-badge-row {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 1.25rem;
        }

        .chart-big-number {
            font-size: 1.6rem;
            font-weight: 800;
            color: #0F172A;
        }

        .on-track-badge {
            background-color: #E8F7F0;
            color: #059669;
            font-size: 0.72rem;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 9999px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        .on-track-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: #10B981;
        }

        .canvas-container {
            position: relative;
            width: 100%;
            height: 220px;
        }

        /* ========================================================= */
        /* 7. MEASUREMENT HISTORY TABLE CARD                         */
        /* ========================================================= */
        .history-card {
            background-color: #FFFFFF;
            border: 1px solid var(--ht-border);
            border-radius: 20px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
            overflow: hidden;
            padding: 1.75rem 2rem 1.25rem;
        }

        .history-header-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .history-title {
            font-size: 1.25rem;
            font-weight: 800;
            color: #0F172A;
            margin-bottom: 0.25rem;
        }

        .history-subtitle {
            font-size: 0.88rem;
            color: #64748B;
            margin: 0;
        }

        .btn-record-measure {
            background: linear-gradient(135deg, #10B981 0%, #059669 100%);
            color: #FFFFFF !important;
            font-weight: 700;
            font-size: 0.88rem;
            padding: 0.55rem 1.2rem;
            border-radius: 10px;
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.15s ease;
        }
        .btn-record-measure:hover {
            filter: brightness(1.05);
            transform: translateY(-1px);
        }

        .table-custom {
            width: 100%;
            border-collapse: collapse;
            margin: 0;
        }

        .table-custom th {
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            color: #64748B;
            text-transform: uppercase;
            padding: 0.85rem 1rem;
            border-bottom: 1px solid #E2E8F0;
            text-align: left;
        }

        .table-custom td {
            font-size: 0.92rem;
            font-weight: 600;
            color: #0F172A;
            padding: 1.15rem 1rem;
            border-bottom: 1px solid #F1F5F9;
            vertical-align: middle;
        }
        .table-custom tr:last-child td {
            border-bottom: none;
        }
        .table-custom tbody tr:hover td {
            background-color: #FAFCFF;
        }

        .btn-dots-menu {
            background: none;
            border: none;
            color: #94A3B8;
            font-weight: 800;
            font-size: 1.1rem;
            cursor: pointer;
            padding: 4px 8px;
            border-radius: 6px;
        }
        .btn-dots-menu:hover {
            color: #0F172A;
            background-color: #F1F5F9;
        }

        /* Toast / Alert */
        .alert-custom-success {
            background-color: #ECFDF5;
            border: 1px solid #A7F3D0;
            color: #065F46;
            border-radius: 12px;
            font-weight: 600;
            padding: 1rem 1.25rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        @@media (max-width: 992px) {
            .sidebar { display: none; }
            .top-navbar { padding: 0.85rem 1.25rem; }
            .dashboard-body { padding: 1.5rem 1rem; }
            .kpi-cards-grid { grid-template-columns: repeat(2, 1fr); }
            .charts-row { grid-template-columns: 1fr; }
        }
        @@media (max-width: 576px) {
            .kpi-cards-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

<div class="dashboard-container">

    <!-- ========================================================= -->
    <!-- 1. LEFT SIDEBAR                                           -->
    <!-- ========================================================= -->
    <aside class="sidebar">
        <div>
            <a href="/" class="brand-header">
                <div class="brand-icon">
                    <i class="bi bi-heart-pulse-fill"></i>
                </div>
                <span>HealthTrack</span>
            </a>

            <div class="nav-category">WORKSPACE</div>
            <ul class="sidebar-nav">
                <li>
                    <a href="/Client" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-grid"></i>
                            <span>Dashboard</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Workouts" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-shield-check"></i>
                            <span>Workout Plans</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Diet" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-egg-fried"></i>
                            <span>Diet Plans</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Appointments" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-calendar2-event"></i>
                            <span>Appointments</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Analytics" class="sidebar-link active">
                        <div class="sidebar-link-left">
                            <i class="bi bi-graph-up-arrow"></i>
                            <span>Progress & Analytics</span>
                        </div>
                        <span class="active-dot"></span>
                    </a>
                </li>
                <li>
                    <a href="/Client/Notifications" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-bell"></i>
                            <span>Notifications</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Profile" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-person"></i>
                            <span>Profile & Health</span>
                        </div>
                    </a>
                </li>
            </ul>
        </div>

        <div class="sidebar-bottom-section">
            <div class="support-card">
                <div class="support-icon">
                    <i class="bi bi-heart-pulse"></i>
                </div>
                <div class="support-title">Need assistance?</div>
                <div class="support-desc">Our team is here to support your health journey.</div>
                <a href="mailto:support@healthtrack.com" class="support-link">
                    <span>Contact support</span>
                    <i class="bi bi-chevron-right" style="font-size: 0.7rem;"></i>
                </a>
            </div>

            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                <button type="submit" class="btn-signout">
                    <i class="bi bi-box-arrow-left"></i>
                    <span>Sign out</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- ========================================================= -->
    <!-- 2. MAIN CONTENT AREA                                      -->
    <!-- ========================================================= -->
    <div class="main-wrapper">
        
        <!-- Top Navbar -->
        <header class="top-navbar">
            <div class="search-box">
                <i class="bi bi-search search-icon"></i>
                <input type="text" class="search-input" placeholder="Search analytics, biometrics..." />
            </div>

            <div class="top-controls">
                <!-- Notifications -->
                <a href="/Client/Notifications" class="btn-notification" title="Notifications">
                    <i class="bi bi-bell"></i>
                    @if (Model.UnreadNotificationsCount > 0)
                    {
                        <span class="notify-dot"></span>
                    }
                </a>

                <!-- User Profile Dropdown with working Logout -->
                <div class="dropdown">
                    <button class="user-profile-pill btn p-0 border-0 d-flex align-items-center" type="button" id="analyticsUserDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="avatar-initials">@initials</div>
                        <div class="user-meta d-none d-sm-block text-start ms-2">
                            <span class="fw-bold small text-dark d-block">@Model.FullName</span>
                            <span class="text-muted" style="font-size: 0.75rem;">Client</span>
                        </div>
                        <i class="bi bi-chevron-down ms-2 text-muted" style="font-size: 0.75rem;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border border-slate-100 rounded-3 mt-2 py-2" aria-labelledby="analyticsUserDropdown" style="min-width: 220px; z-index: 1050;">
                        <li class="px-3 py-2 border-bottom">
                            <div class="fw-bold text-dark small">@Model.FullName</div>
                            <div class="text-muted" style="font-size: 0.78rem;">@Model.Email</div>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="/Client">
                                <i class="bi bi-grid text-secondary"></i> Dashboard
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="/Client/Workouts">
                                <i class="bi bi-shield-check text-secondary"></i> Workout Plans
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="/Client/Diet">
                                <i class="bi bi-egg-fried text-secondary"></i> Diet Plans
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="/Client/Appointments">
                                <i class="bi bi-calendar2-event text-secondary"></i> Appointments
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="/Client/Profile">
                                <i class="bi bi-person text-secondary"></i> Profile & Health
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li class="px-2 pt-1">
                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-2 py-1.5 d-flex align-items-center justify-content-center gap-2 fw-semibold">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Log out</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Main Body -->
        <main class="dashboard-body">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-custom-success alert-dismissible fade show" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- 1. Header Row (INSIGHTS, Title & Export report CTA) -->
            <div class="page-header-row">
                <div>
                    <div class="page-eyebrow">INSIGHTS</div>
                    <h1 class="page-main-title">Progress & analytics</h1>
                    <p class="page-subtitle">Track meaningful trends and make informed health decisions.</p>
                </div>
                <a href="/Client/ExportReport" class="btn-export-report">
                    <i class="bi bi-download"></i>
                    <span>Export report</span>
                </a>
            </div>

            <!-- 2. Filter Row (Last 30 days v, All metrics v, Apply filters) -->
            <form method="get" asp-action="Analytics" class="filter-row">
                <!-- Time range dropdown -->
                <div class="dropdown">
                    <button class="filter-pill-btn dropdown-toggle" type="button" id="timeRangeDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <span>@Model.SelectedTimeRange</span>
                    </button>
                    <ul class="dropdown-menu shadow-sm border border-slate-100 rounded-3" aria-labelledby="timeRangeDropdown">
                        <li><a class="dropdown-item small" href="/Client/Analytics?timeRange=Last 7 days&metric=@Model.SelectedMetric">Last 7 days</a></li>
                        <li><a class="dropdown-item small" href="/Client/Analytics?timeRange=Last 30 days&metric=@Model.SelectedMetric">Last 30 days</a></li>
                        <li><a class="dropdown-item small" href="/Client/Analytics?timeRange=Last 90 days&metric=@Model.SelectedMetric">Last 90 days</a></li>
                        <li><a class="dropdown-item small" href="/Client/Analytics?timeRange=This year&metric=@Model.SelectedMetric">This year</a></li>
                    </ul>
                </div>

                <!-- Metrics dropdown -->
                <div class="dropdown">
                    <button class="filter-pill-btn dropdown-toggle" type="button" id="metricsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <span>@Model.SelectedMetric</span>
                    </button>
                    <ul class="dropdown-menu shadow-sm border border-slate-100 rounded-3" aria-labelledby="metricsDropdown">
                        <li><a class="dropdown-item small" href="/Client/Analytics?timeRange=@Model.SelectedTimeRange&metric=All metrics">All metrics</a></li>
                        <li><a class="dropdown-item small" href="/Client/Analytics?timeRange=@Model.SelectedTimeRange&metric=Weight only">Weight only</a></li>
                        <li><a class="dropdown-item small" href="/Client/Analytics?timeRange=@Model.SelectedTimeRange&metric=Workouts only">Workouts only</a></li>
                    </ul>
                </div>

                <button type="submit" class="btn-apply-filters">
                    Apply filters
                </button>
            </form>

            <!-- 3. 4 KPI Metric Cards (Matching media_1792560789365_c98877d8.png) -->
            <div class="kpi-cards-grid">
                <!-- Card 1: Weight change -->
                <div class="kpi-card">
                    <div class="kpi-label">Weight change</div>
                    <div class="kpi-value">@Model.WeightChange</div>
                    <div class="kpi-subtext">@Model.WeightChangePeriod</div>
                </div>

                <!-- Card 2: Workout completion -->
                <div class="kpi-card">
                    <div class="kpi-label">Workout completion</div>
                    <div class="kpi-value">@Model.WorkoutCompletionRate</div>
                    <div class="kpi-subtext">@Model.WorkoutCompletionChange</div>
                </div>

                <!-- Card 3: Active minutes -->
                <div class="kpi-card">
                    <div class="kpi-label">Active minutes</div>
                    <div class="kpi-value">@Model.ActiveMinutes</div>
                    <div class="kpi-subtext">@Model.ActiveMinutesPeriod</div>
                </div>

                <!-- Card 4: Average calories -->
                <div class="kpi-card">
                    <div class="kpi-label">Average calories</div>
                    <div class="kpi-value">@Model.AverageCalories</div>
                    <div class="kpi-subtext">@Model.AverageCaloriesPeriod</div>
                </div>
            </div>

            <!-- 4. Charts Row: Weight Trend (Spline) & Workout Activity (Bars) -->
            <div class="charts-row">
                
                <!-- Left: Weight trend -->
                <div class="chart-card">
                    <div class="chart-header">
                        <div>
                            <div class="chart-title">Weight trend</div>
                            <p class="chart-subtitle">Kilograms over time</p>
                        </div>
                        <div class="dropdown">
                            <button class="filter-pill-btn py-1 px-3 dropdown-toggle" type="button" style="height: 32px; font-size: 0.78rem;" id="trendDropdown" data-bs-toggle="dropdown">
                                <span>Monthly</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border border-slate-100 rounded-3">
                                <li><a class="dropdown-item small" href="javascript:void(0)">Weekly</a></li>
                                <li><a class="dropdown-item small" href="javascript:void(0)">Monthly</a></li>
                                <li><a class="dropdown-item small" href="javascript:void(0)">Quarterly</a></li>
                            </ul>
                        </div>
                    </div>

                    <div class="chart-metric-badge-row">
                        @if (Model.CurrentWeightKg > 0)
                        {
                            <span class="chart-big-number">@Model.CurrentWeightKg.ToString("F1") kg</span>
                        }
                        else
                        {
                            <span class="chart-big-number">-- kg</span>
                        }
                        <span class="on-track-badge">
                            <span class="on-track-dot"></span>
                            <span>@Model.WeightTrendStatus</span>
                        </span>
                    </div>

                    <div class="canvas-container">
                        <canvas id="weightTrendChart"></canvas>
                    </div>
                </div>

                <!-- Right: Workout activity -->
                <div class="chart-card">
                    <div class="chart-header">
                        <div>
                            <div class="chart-title">Workout activity</div>
                            <p class="chart-subtitle">Completion by week</p>
                        </div>
                    </div>

                    <div style="height: 48px;"></div> <!-- Spacing alignment with left card's big number -->

                    <div class="canvas-container">
                        <canvas id="workoutActivityChart"></canvas>
                    </div>
                </div>

            </div>

            <!-- 5. Measurement History Table Card (Matching media_1792560803059_1970f462.png) -->
            <div class="history-card">
                <div class="history-header-row">
                    <div>
                        <h3 class="history-title">Measurement history</h3>
                        <p class="history-subtitle">Your latest recorded health metrics</p>
                    </div>
                    <button type="button" class="btn-record-measure" data-bs-toggle="modal" data-bs-target="#recordMeasurementModal">
                        <i class="bi bi-plus-lg"></i>
                        <span>Record measurement</span>
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-custom">
                        <thead>
                            <tr>
                                <th>DATE</th>
                                <th>WEIGHT</th>
                                <th>HEIGHT</th>
                                <th>BMI</th>
                                <th>WAIST</th>
                                <th style="text-align: right;">ACTION</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.MeasurementHistory != null && Model.MeasurementHistory.Any())
                            {
                                @foreach (var item in Model.MeasurementHistory)
                                {
                                    <tr>
                                        <td>@item.DateText</td>
                                        <td>@item.WeightKg.ToString("F1") kg</td>
                                        <td>@item.HeightCm cm</td>
                                        <td>@item.Bmi.ToString("F1")</td>
                                        <td>@item.WaistCm cm</td>
                                        <td style="text-align: right;">
                                            <div class="dropdown d-inline-block">
                                                <button class="btn-dots-menu" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="bi bi-three-dots"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border border-slate-100 rounded-3 p-1">
                                                    <li>
                                                        <a class="dropdown-item small py-2 d-flex align-items-center" href="javascript:void(0)" onclick="alert('Measurement on @item.DateText:\nWeight: @item.WeightKg kg\nHeight: @item.HeightCm cm\nBMI: @item.Bmi\nWaist: @item.WaistCm cm\nNotes: @(item.Notes ?? "None")')">
                                                            <i class="bi bi-eye me-2 text-secondary"></i> View Details
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <form asp-action="DeleteMeasurement" asp-controller="Client" method="post" style="margin: 0; padding: 0;" onsubmit="return confirm('Are you sure you want to delete this measurement from @item.DateText (@item.WeightKg.ToString("F1") kg)?');">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@item.Id" />
                                                            <button type="submit" class="dropdown-item small py-2 text-danger d-flex align-items-center border-0 bg-transparent w-100 text-start">
                                                                <i class="bi bi-trash me-2"></i> Delete
                                                            </button>
                                                        </form>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <div style="font-size: 2rem; color: #CBD5E1; margin-bottom: 0.5rem;"><i class="bi bi-clipboard2-pulse"></i></div>
                                        <strong style="color: #475569;">No biometric measurements recorded yet.</strong><br />
                                        <span class="small text-muted">Click "Record measurement" above to log your first entry.</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>
</div>

<!-- ========================================================= -->
<!-- MODAL: RECORD MEASUREMENT                                 -->
<!-- ========================================================= -->
<div class="modal fade" id="recordMeasurementModal" tabindex="-1" aria-labelledby="recordMeasurementModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white p-4" style="background: linear-gradient(135deg, #0C2333 0%, #081B28 100%) !important;">
                <div class="d-flex align-items-center gap-3">
                    <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(16, 185, 129, 0.2); color: #10B981; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                        <i class="bi bi-clipboard2-pulse"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-white mb-0" id="recordMeasurementModalLabel">Record Health Metric</h5>
                        <small class="text-white-50">Log biometrics to track weight, BMI & waist over time</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <form asp-action="RecordMeasurement" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-secondary text-uppercase">Weight (kg)</label>
                            <input asp-for="RecordMeasurementForm.WeightKg" type="number" step="0.1" class="form-control rounded-3 py-2" placeholder="72.4" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-secondary text-uppercase">Height (cm)</label>
                            <input asp-for="RecordMeasurementForm.HeightCm" type="number" class="form-control rounded-3 py-2" placeholder="178" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-secondary text-uppercase">Waist Circumference (cm)</label>
                            <input asp-for="RecordMeasurementForm.WaistCm" type="number" class="form-control rounded-3 py-2" placeholder="82" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-secondary text-uppercase">Date</label>
                            <input asp-for="RecordMeasurementForm.MeasurementDate" type="date" class="form-control rounded-3 py-2" required value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary text-uppercase">Session Notes / Observations</label>
                        <textarea asp-for="RecordMeasurementForm.Notes" rows="2" class="form-control rounded-3" placeholder="e.g. Post-cardio morning check, steady recovery."></textarea>
                    </div>

                    <div class="p-3 rounded-3" style="background-color: #F8FAFC; border: 1px dashed #CBD5E1;">
                        <div class="d-flex align-items-center gap-2 small text-muted">
                            <i class="bi bi-info-circle text-primary"></i>
                            <span>BMI will be automatically computed and saved to your biometric history.</span>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light p-3 border-top">
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn text-white rounded-3 px-4 fw-bold" style="background: linear-gradient(135deg, #10B981 0%, #059669 100%);">
                        <i class="bi bi-check2-circle me-1"></i> Save Measurement
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Bootstrap 5 JavaScript Bundle -->
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<!-- Chart.js Initialization matching screenshots -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // 1. Weight Trend Spline Chart
        const weightCtx = document.getElementById('weightTrendChart').getContext('2d');
        
        // Gradient fill
        const gradient = weightCtx.createLinearGradient(0, 0, 0, 200);
        gradient.addColorStop(0, 'rgba(16, 185, 129, 0.22)');
        gradient.addColorStop(1, 'rgba(16, 185, 129, 0.0)');

        const weightLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeightLabels));
        const weightData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeightValues));

        new Chart(weightCtx, {
            type: 'line',
            data: {
                labels: weightLabels,
                datasets: [{
                    label: 'Weight (kg)',
                    data: weightData,
                    borderColor: '#0D9488',
                    borderWidth: 3,
                    backgroundColor: gradient,
                    fill: true,
                    tension: 0.4, // Smooth spline
                    pointRadius: 5,
                    pointBackgroundColor: '#FFFFFF',
                    pointBorderColor: '#0D9488',
                    pointBorderWidth: 2.5,
                    pointHoverRadius: 7,
                    pointHoverBackgroundColor: '#0D9488',
                    pointHoverBorderColor: '#FFFFFF',
                    pointHoverBorderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#0F172A',
                        titleFont: { family: 'Plus Jakarta Sans', size: 12 },
                        bodyFont: { family: 'Plus Jakarta Sans', size: 12 },
                        padding: 10,
                        cornerRadius: 8,
                        displayColors: false,
                        callbacks: {
                            label: function (context) {
                                return context.parsed.y.toFixed(1) + ' kg';
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: {
                            color: '#94A3B8',
                            font: { family: 'Plus Jakarta Sans', size: 11, weight: '600' }
                        }
                    },
                    y: {
                        min: (weightData && weightData.length > 0) ? Math.max(0, Math.floor(Math.min(...weightData) - 3)) : undefined,
                        max: (weightData && weightData.length > 0) ? Math.ceil(Math.max(...weightData) + 3) : undefined,
                        grid: {
                            color: '#F1F5F9',
                            drawBorder: false
                        },
                        ticks: {
                            stepSize: 5,
                            color: '#94A3B8',
                            font: { family: 'Plus Jakarta Sans', size: 11, weight: '600' }
                        }
                    }
                }
            }
        });

        // 2. Workout Activity Weekly Bar Chart (Matching media_1792560789365_c98877d8.png)
        const activityCtx = document.getElementById('workoutActivityChart').getContext('2d');
        const activityDays = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActivityDays));
        const activityData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActivityPercentages));

        // Bar colors: soft mint for M-S, solid emerald green for Sunday
        const barColors = [
            '#D1FAE5', // M
            '#D1FAE5', // T
            '#D1FAE5', // W
            '#D1FAE5', // T
            '#D1FAE5', // F
            '#D1FAE5', // S
            '#0D9488'  // S (Sunday active dark emerald)
        ];

        new Chart(activityCtx, {
            type: 'bar',
            data: {
                labels: activityDays,
                datasets: [{
                    data: activityData,
                    backgroundColor: barColors,
                    borderRadius: 6,
                    borderSkipped: false,
                    barThickness: 24
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#0F172A',
                        titleFont: { family: 'Plus Jakarta Sans', size: 12 },
                        bodyFont: { family: 'Plus Jakarta Sans', size: 12 },
                        padding: 10,
                        cornerRadius: 8,
                        displayColors: false,
                        callbacks: {
                            label: function (context) {
                                return context.parsed.y + '% completion';
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: {
                            color: '#94A3B8',
                            font: { family: 'Plus Jakarta Sans', size: 11, weight: '700' }
                        }
                    },
                    y: {
                        display: false,
                        max: 110,
                        grid: { display: false }
                    }
                }
            }
        });
    });
</script>

</body>
</html>

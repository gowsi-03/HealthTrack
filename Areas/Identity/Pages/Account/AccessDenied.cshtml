@page
@model HealthTrack.Areas.Identity.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied (403 Forbidden)";
    Layout = null;

    var isClient = User.IsInRole("Client");
    var isTrainer = User.IsInRole("Trainer");
    var dashboardUrl = isClient ? "/Client" : (isTrainer ? "/Trainer" : "/");
    var dashboardLabel = isClient ? "Return to Client Dashboard" : (isTrainer ? "Return to Trainer Dashboard" : "Return to Dashboard");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>403 Access Denied - HealthTrack</title>
    
    <!-- Google Fonts & Bootstrap 5 & Bootstrap Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --ht-teal: #0D9488;
            --ht-teal-hover: #0F766E;
            --ht-rose: #E11D48;
            --ht-rose-bg: #FFF1F2;
            --ht-rose-border: #FECDD3;
            --ht-slate-900: #0F172A;
            --ht-slate-700: #334155;
            --ht-slate-500: #64748B;
            --ht-border: #E2E8F0;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #F8FAFC;
            color: var(--ht-slate-900);
            min-height: 100vh;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .denied-wrapper {
            width: 100%;
            max-width: 600px;
            padding: 2.5rem 1.5rem;
        }

        .brand-logo-center {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 2rem;
            text-decoration: none;
        }

        .brand-icon-box {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, #0D9488, #14B8A6);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #FFFFFF;
            font-size: 1.3rem;
            box-shadow: 0 4px 12px rgba(13, 148, 136, 0.25);
        }

        .brand-title {
            font-size: 1.45rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: var(--ht-slate-900);
            margin: 0;
        }

        .denied-card {
            background: #FFFFFF;
            border: 1px solid var(--ht-border);
            border-radius: 20px;
            padding: 2.5rem 2.25rem;
            box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.07);
            text-align: center;
        }

        .icon-shield-container {
            width: 80px;
            height: 80px;
            background-color: var(--ht-rose-bg);
            border: 2px solid var(--ht-rose-border);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem auto;
            color: var(--ht-rose);
            font-size: 2.5rem;
            box-shadow: 0 8px 24px rgba(225, 29, 72, 0.15);
        }

        .status-badge-forbidden {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background-color: var(--ht-rose-bg);
            color: var(--ht-rose);
            font-size: 0.8rem;
            font-weight: 700;
            padding: 0.35rem 0.85rem;
            border-radius: 50px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border: 1px solid var(--ht-rose-border);
            margin-bottom: 1rem;
        }

        .card-main-title {
            font-size: 1.75rem;
            font-weight: 800;
            color: var(--ht-slate-900);
            margin-bottom: 0.65rem;
            letter-spacing: -0.5px;
        }

        .card-subtext {
            color: var(--ht-slate-500);
            font-size: 0.95rem;
            line-height: 1.6;
            margin-bottom: 1.75rem;
        }

        .resource-box {
            background-color: #F8FAFC;
            border: 1px solid var(--ht-border);
            border-radius: 12px;
            padding: 1rem 1.25rem;
            text-align: left;
            margin-bottom: 2rem;
        }

        .resource-label {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--ht-slate-500);
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        .resource-path {
            font-family: SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--ht-rose);
            word-break: break-all;
        }

        .active-role-pill {
            display: inline-block;
            font-size: 0.8rem;
            font-weight: 600;
            padding: 2px 10px;
            border-radius: 6px;
            background: #E2E8F0;
            color: var(--ht-slate-700);
            margin-top: 6px;
        }

        .btn-action-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            background-color: var(--ht-teal);
            color: #FFFFFF;
            font-size: 0.95rem;
            font-weight: 700;
            padding: 0.85rem 1.5rem;
            border-radius: 12px;
            border: none;
            text-decoration: none;
            transition: all 0.2s ease;
            box-shadow: 0 4px 14px rgba(13, 148, 136, 0.25);
            margin-bottom: 0.75rem;
        }

        .btn-action-primary:hover {
            background-color: var(--ht-teal-hover);
            color: #FFFFFF;
            transform: translateY(-1px);
        }

        .btn-action-secondary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            background-color: #FFFFFF;
            color: var(--ht-slate-700);
            font-size: 0.95rem;
            font-weight: 600;
            padding: 0.8rem 1.5rem;
            border-radius: 12px;
            border: 1px solid var(--ht-border);
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-action-secondary:hover {
            background-color: #F1F5F9;
            color: var(--ht-slate-900);
        }

        .footer-security-note {
            margin-top: 2rem;
            text-align: center;
            font-size: 0.82rem;
            color: #94A3B8;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
    </style>
</head>
<body>

    <div class="denied-wrapper">
        <!-- Brand Header -->
        <a href="/" class="brand-logo-center">
            <div class="brand-icon-box">
                <i class="bi bi-heart-pulse-fill"></i>
            </div>
            <h1 class="brand-title">HealthTrack</h1>
        </a>

        <!-- Access Denied Card -->
        <div class="denied-card">
            <div class="icon-shield-container">
                <i class="bi bi-shield-x"></i>
            </div>

            <div class="status-badge-forbidden">
                <i class="bi bi-lock-fill"></i> 403 Forbidden
            </div>

            <h2 class="card-main-title">Access Denied</h2>
            
            <p class="card-subtext">
                You do not have the required administrative permissions to access this protected area. 
                This resource is restricted to authorized personnel.
            </p>

            <!-- Technical Detail Box -->
            <div class="resource-box">
                <div class="resource-label">Attempted Destination</div>
                <div class="resource-path">
                    @(string.IsNullOrEmpty(Model.ReturnUrl) ? "/Admin/Trainers" : Model.ReturnUrl)
                </div>
                
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top border-slate-200">
                        <span class="small text-muted">Current Session: <strong>@User.Identity.Name</strong></span>
                        <span class="active-role-pill">
                            <i class="bi bi-person-badge me-1"></i>
                            @(isClient ? "Role: Client" : (isTrainer ? "Role: Trainer" : "Role: Authenticated User"))
                        </span>
                    </div>
                }
            </div>

            <!-- Action Buttons -->
            <div>
                <a href="@dashboardUrl" class="btn-action-primary">
                    <i class="bi bi-grid-fill"></i> @dashboardLabel
                </a>
                
                <a href="/Identity/Account/Login?returnUrl=@(Uri.EscapeDataString(Model.ReturnUrl ?? "/Admin/Trainers"))" class="btn-action-secondary">
                    <i class="bi bi-box-arrow-in-right"></i> Sign In with an Administrator Account
                </a>
            </div>
        </div>

        <!-- Security System Footnote -->
        <div class="footer-security-note">
            <i class="bi bi-shield-check text-success"></i>
            <span>HealthTrack Role-Based Access Control (RBAC) &bull; Security Logged</span>
        </div>
    </div>

</body>
</html>

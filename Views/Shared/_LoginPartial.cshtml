@using Microsoft.AspNetCore.Identity
@using HealthTrack.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var isTrainer = currentUser != null && (currentUser.Role == "Trainer" || currentUser.Role == "Admin");
    var dashboardUrl = isTrainer ? "/Trainer" : "/Client";
    var roleLabel = isTrainer ? "Trainer" : "Client";

    <div class="d-flex align-items-center gap-2">
        <a class="btn-get-started py-1.5 px-3.5 d-flex align-items-center gap-2" style="font-size: 0.88rem;" href="@dashboardUrl">
            <i class="bi @(isTrainer ? "bi-grid" : "bi-speedometer2")"></i>
            <span>@roleLabel Dashboard</span>
        </a>
        <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1">Logout</button>
        </form>
    </div>
}
else
{
    <div class="d-flex align-items-center gap-2">
        <a class="nav-link-login" asp-area="Identity" asp-page="/Account/Login">Log in</a>
        <a class="btn-get-started" asp-area="Identity" asp-page="/Account/Register">Get started</a>
    </div>
}

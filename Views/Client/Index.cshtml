@model HealthTrack.Models.ViewModels.ClientDashboardViewModel
@{
    ViewData["Title"] = "Client Dashboard - HealthTrack";
    Layout = null; // Full dashboard layout matching screenshot
    var greeting = DateTime.Now.Hour < 12 ? "Good morning" : DateTime.Now.Hour < 17 ? "Good afternoon" : "Good evening";
    var userFirstName = Model.FullName.Split(' ')[0];
    var initials = string.Join("", Model.FullName.Split(' ').Select(n => n.Length > 0 ? n[0].ToString() : "")).ToUpper();
    if (initials.Length > 2) initials = initials.Substring(0, 2);
    if (string.IsNullOrEmpty(initials)) initials = "AM";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard - HealthTrack</title>

    <!-- Google Fonts & Bootstrap 5 & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Chart.js for Smooth Curved Analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <style>
        :root {
            --ht-navy: #0B192C;
            --ht-navy-light: #1E293B;
            --ht-navy-hover: #152840;
            --ht-green: #10B981;
            --ht-green-hover: #059669;
            --ht-green-bg: #E8F7F0;
            --ht-slate: #0F172A;
            --ht-muted: #64748B;
            --ht-border: #E2E8F0;
            --ht-bg: #F8FAFC;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--ht-bg);
            color: var(--ht-slate);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        .dashboard-container {
            display: flex;
            min-height: 100vh;
        }

        /* ==================================================== */
        /* 1. SIDEBAR (Dark Navy)                              */
        /* ==================================================== */
        .sidebar {
            width: 255px;
            background-color: var(--ht-navy);
            color: #FFFFFF;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: sticky;
            top: 0;
            height: 100vh;
            max-height: 100vh;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 1.5rem 1.15rem;
            flex-shrink: 0;
            z-index: 100;
        }

        .sidebar::-webkit-scrollbar {
            width: 5px;
        }
        .sidebar::-webkit-scrollbar-track {
            background: rgba(11, 25, 44, 0.4);
        }
        .sidebar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 4px;
        }
        .sidebar::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.35);
        }

        .brand-header {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
            font-size: 1.35rem;
            color: #FFFFFF;
            text-decoration: none;
            margin-bottom: 1.35rem;
            padding-left: 0.5rem;
        }
        .brand-header:hover { color: #FFFFFF; }

        .brand-icon {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            background: linear-gradient(135deg, #10B981 0%, #059669 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #FFFFFF;
            font-size: 1.2rem;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
        }

        .nav-category {
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            color: #64748B;
            text-transform: uppercase;
            padding: 0.5rem 0.75rem;
            margin-bottom: 0.5rem;
        }

        .sidebar-nav {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 0.65rem 0.85rem;
            border-radius: 12px;
            color: #94A3B8;
            text-decoration: none;
            font-size: 0.92rem;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .sidebar-link:hover {
            color: #FFFFFF;
            background-color: var(--ht-navy-hover);
        }

        .sidebar-link.active {
            background-color: rgba(255, 255, 255, 0.08);
            color: #FFFFFF;
        }

        .sidebar-link-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sidebar-link i {
            font-size: 1.15rem;
        }

        .active-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background-color: var(--ht-green);
            box-shadow: 0 0 8px rgba(16, 185, 129, 0.7);
        }

        /* Support Help Card */
        .sidebar-bottom-section {
            margin-top: 1.25rem;
            flex-shrink: 0;
            padding-bottom: 0.75rem;
        }

        .support-card {
            background: rgba(30, 41, 59, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 1rem;
            margin-bottom: 0.75rem;
        }

        .support-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: rgba(16, 185, 129, 0.15);
            color: var(--ht-green);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
            margin-bottom: 0.75rem;
        }

        .support-title {
            font-size: 0.88rem;
            font-weight: 700;
            color: #FFFFFF;
            margin-bottom: 0.25rem;
        }

        .support-desc {
            font-size: 0.75rem;
            color: #94A3B8;
            margin-bottom: 0.65rem;
            line-height: 1.4;
        }

        .support-link {
            font-size: 0.78rem;
            font-weight: 700;
            color: #FFFFFF;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        .support-link:hover { color: var(--ht-green); }

        .btn-signout {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #94A3B8;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 600;
            padding: 0.6rem 0.75rem;
            border-radius: 10px;
            background: none;
            border: none;
            width: 100%;
            text-align: left;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .btn-signout:hover {
            color: #EF4444;
            background-color: rgba(239, 68, 68, 0.1);
        }

        /* ==================================================== */
        /* 2. MAIN CONTENT AREA                                 */
        /* ==================================================== */
        .main-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* Top Bar */
        .top-navbar {
            background-color: #FFFFFF;
            border-bottom: 1px solid var(--ht-border);
            padding: 0.95rem 2.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 90;
        }

        .search-box {
            position: relative;
            width: 320px;
        }
        .search-input {
            width: 100%;
            height: 42px;
            padding: 0.5rem 1rem 0.5rem 2.5rem;
            background-color: #F8FAFC;
            border: 1px solid var(--ht-border);
            border-radius: 12px;
            font-size: 0.9rem;
            color: var(--ht-slate);
            transition: all 0.2s ease;
        }
        .search-input:focus {
            background-color: #FFFFFF;
            border-color: var(--ht-green);
            outline: none;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.12);
        }
        .search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #94A3B8;
            font-size: 0.9rem;
        }

        .top-controls {
            display: flex;
            align-items: center;
            gap: 1.25rem;
        }

        .btn-notification {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            border: 1px solid var(--ht-border);
            background: #FFFFFF;
            color: #475569;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            position: relative;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .btn-notification:hover {
            background-color: #F8FAFC;
            border-color: #CBD5E1;
        }
        .notify-dot {
            position: absolute;
            top: 9px;
            right: 9px;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background-color: #EF4444;
        }

        .user-profile-pill {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 4px 8px 4px 4px;
            border-radius: 12px;
            cursor: pointer;
            text-decoration: none;
            transition: background 0.15s ease;
        }
        .user-profile-pill:hover {
            background-color: #F8FAFC;
        }

        .avatar-initials {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: #E2E8F0;
            color: #334155;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.9rem;
            letter-spacing: 0.5px;
        }

        .user-meta {
            text-align: left;
            line-height: 1.2;
        }
        .user-name {
            font-size: 0.9rem;
            font-weight: 700;
            color: #0F172A;
            display: block;
        }
        .user-role-label {
            font-size: 0.75rem;
            color: #94A3B8;
        }

        /* Dashboard Body Content */
        .dashboard-body {
            padding: 2.25rem 2.5rem;
            max-width: 1400px;
            width: 100%;
            margin: 0 auto;
        }

        /* Header Greeting */
        .dashboard-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 2rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .date-eyebrow {
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            color: #94A3B8;
            text-transform: uppercase;
            margin-bottom: 0.35rem;
            display: block;
        }

        .greeting-title {
            font-size: 1.85rem;
            font-weight: 800;
            color: #0F172A;
            letter-spacing: -0.025em;
            margin-bottom: 0.25rem;
        }

        .greeting-subtext {
            font-size: 0.95rem;
            color: var(--ht-muted);
            margin: 0;
        }

        .btn-book-appointment {
            background-color: var(--ht-green);
            color: #FFFFFF !important;
            font-weight: 700;
            font-size: 0.92rem;
            padding: 0.75rem 1.45rem;
            border-radius: 12px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: none;
            box-shadow: 0 4px 14px rgba(16, 185, 129, 0.25);
            transition: all 0.2s ease;
            cursor: pointer;
        }
        .btn-book-appointment:hover {
            background-color: var(--ht-green-hover);
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(16, 185, 129, 0.35);
        }

        /* ==================================================== */
        /* 3. CARDS & STATS                                     */
        /* ==================================================== */
        .stat-card {
            background: #FFFFFF;
            border: 1px solid var(--ht-border);
            border-radius: 18px;
            padding: 1.5rem 1.65rem;
            height: 100%;
            transition: all 0.2s ease;
        }
        .stat-card:hover {
            box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.05);
            border-color: #CBD5E1;
        }

        .stat-card-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 0.75rem;
        }

        .stat-icon-wrapper {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        .stat-icon-green { background: #ECFDF5; color: #10B981; }
        .stat-icon-blue { background: #EFF6FF; color: #3B82F6; }
        .stat-icon-orange { background: #FFF7ED; color: #F97316; }

        .stat-dots {
            color: #CBD5E1;
            font-size: 1.2rem;
            cursor: pointer;
            line-height: 1;
        }
        .stat-dots:hover { color: #64748B; }

        .stat-label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #64748B;
            margin-bottom: 0.35rem;
        }

        .stat-value {
            font-size: 2.1rem;
            font-weight: 800;
            color: #0F172A;
            letter-spacing: -0.025em;
            line-height: 1.1;
            margin-bottom: 0.65rem;
        }
        .stat-unit {
            font-size: 1rem;
            font-weight: 600;
            color: #94A3B8;
            margin-left: 3px;
        }

        .trend-pill {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 0.78rem;
            font-weight: 600;
            color: #059669;
        }
        .trend-pill.negative { color: #DC2626; }

        /* ==================================================== */
        /* 4. GRAPH & APPOINTMENT ROW                          */
        /* ==================================================== */
        .chart-card {
            background: #FFFFFF;
            border: 1px solid var(--ht-border);
            border-radius: 20px;
            padding: 1.75rem 2rem;
            height: 100%;
        }

        .chart-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 0.25rem;
        }

        .section-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: #0F172A;
            margin: 0;
        }

        .view-report-link {
            font-size: 0.85rem;
            font-weight: 600;
            color: #0F172A;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        .view-report-link:hover { color: var(--ht-green); }

        .section-subtitle {
            font-size: 0.88rem;
            color: #94A3B8;
            margin-bottom: 1.25rem;
        }

        .weight-hero-row {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 1.25rem;
        }

        .weight-hero-val {
            font-size: 1.75rem;
            font-weight: 800;
            color: #0F172A;
            letter-spacing: -0.02em;
        }

        .badge-month-trend {
            background: #ECFDF5;
            color: #059669;
            font-size: 0.78rem;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 6px;
        }

        /* Upcoming Appointment Card */
        .appointment-card {
            background: #FFFFFF;
            border: 1px solid var(--ht-border);
            border-radius: 20px;
            padding: 1.75rem 1.85rem;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .appointment-badge-box {
            display: flex;
            gap: 14px;
            align-items: flex-start;
            margin-top: 1.25rem;
            margin-bottom: 2rem;
        }

        .date-square {
            width: 58px;
            height: 58px;
            background-color: var(--ht-navy);
            color: #FFFFFF;
            border-radius: 14px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .date-square-num {
            font-size: 1.35rem;
            font-weight: 800;
            line-height: 1;
        }
        .date-square-month {
            font-size: 0.65rem;
            font-weight: 800;
            letter-spacing: 0.1em;
            color: #94A3B8;
            margin-top: 2px;
        }

        .appt-info-right {
            flex: 1;
        }

        .appt-category-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 0.72rem;
            font-weight: 700;
            color: #0284C7;
            background: #F0F9FF;
            padding: 2px 8px;
            border-radius: 6px;
            margin-bottom: 0.35rem;
        }
        .appt-cat-dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background-color: #0284C7;
        }

        .appt-provider-name {
            font-size: 1.05rem;
            font-weight: 700;
            color: #0F172A;
            margin-bottom: 0.25rem;
        }

        .appt-meta-item {
            font-size: 0.8rem;
            color: #64748B;
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 2px;
        }

        .appt-btn-row {
            display: flex;
            gap: 10px;
        }

        .btn-appt-details {
            flex: 1;
            background: #FFFFFF;
            border: 1px solid var(--ht-border);
            color: #0F172A;
            font-weight: 600;
            font-size: 0.88rem;
            padding: 0.65rem 1rem;
            border-radius: 10px;
            text-align: center;
            cursor: pointer;
            transition: all 0.15s ease;
            text-decoration: none;
        }
        .btn-appt-details:hover {
            background: #F8FAFC;
            border-color: #CBD5E1;
            color: #0F172A;
        }

        .btn-appt-join {
            flex: 1;
            background: var(--ht-green);
            border: none;
            color: #FFFFFF !important;
            font-weight: 600;
            font-size: 0.88rem;
            padding: 0.65rem 1rem;
            border-radius: 10px;
            text-align: center;
            cursor: pointer;
            transition: all 0.15s ease;
            text-decoration: none;
            box-shadow: 0 2px 8px rgba(16, 185, 129, 0.25);
        }
        .btn-appt-join:hover {
            background: var(--ht-green-hover);
        }

        /* ==================================================== */
        /* 5. TODAY'S PLAN & QUICK ACTIONS                     */
        /* ==================================================== */
        .bottom-card {
            background: #FFFFFF;
            border: 1px solid var(--ht-border);
            border-radius: 20px;
            padding: 1.75rem 2rem;
            height: 100%;
        }

        /* Plan Progress Ring */
        .plan-percent-badge {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            border: 3.5px solid var(--ht-green);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 800;
            color: var(--ht-green);
        }

        .plan-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.85rem 0;
            border-bottom: 1px solid #F1F5F9;
        }
        .plan-item:last-child { border-bottom: none; }

        .plan-item-left {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .plan-check-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: #ECFDF5;
            color: #10B981;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
        }

        .plan-item-title {
            font-size: 0.92rem;
            font-weight: 700;
            color: #0F172A;
            margin-bottom: 2px;
        }
        .plan-item-sub {
            font-size: 0.78rem;
            color: #94A3B8;
        }

        .badge-done {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 0.78rem;
            font-weight: 700;
            color: #059669;
        }
        .done-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: #10B981;
        }

        .btn-plan-start {
            background: #FFFFFF;
            border: 1px solid var(--ht-border);
            color: #0F172A;
            font-weight: 700;
            font-size: 0.78rem;
            padding: 4px 12px;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.15s ease;
        }
        .btn-plan-start:hover {
            border-color: var(--ht-green);
            color: var(--ht-green);
        }

        /* Quick Action Tiles */
        .quick-action-tile {
            background: #FFFFFF;
            border: 1px solid var(--ht-border);
            border-radius: 14px;
            padding: 1.15rem 1.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            text-decoration: none;
            color: var(--ht-slate);
            transition: all 0.2s ease;
            cursor: pointer;
            height: 100%;
        }
        .quick-action-tile:hover {
            border-color: var(--ht-green);
            background: #F0FDF4;
            transform: translateY(-2px);
            box-shadow: 0 4px 14px rgba(16, 185, 129, 0.08);
            color: var(--ht-slate);
        }

        .tile-icon-box {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: #ECFDF5;
            color: #10B981;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            flex-shrink: 0;
        }

        .tile-title {
            font-size: 0.92rem;
            font-weight: 700;
            color: #0F172A;
            margin-bottom: 2px;
        }
        .tile-desc {
            font-size: 0.75rem;
            color: #94A3B8;
        }

        @@media (max-width: 992px) {
            .sidebar { display: none; }
            .top-navbar { padding: 0.85rem 1.25rem; }
            .dashboard-body { padding: 1.5rem 1rem; }
        }
    </style>
</head>
<body>

<div class="dashboard-container">

    <!-- ========================================================= -->
    <!-- 1. LEFT SIDEBAR (Dark Navy Brand Navigation)              -->
    <!-- ========================================================= -->
    <aside class="sidebar">
        <div>
            <!-- Brand Logo -->
            <a href="/" class="brand-header">
                <div class="brand-icon">
                    <i class="bi bi-heart-pulse-fill"></i>
                </div>
                <span>HealthTrack</span>
            </a>

            <!-- Workspace Menu -->
            <div class="nav-category">WORKSPACE</div>
            <ul class="sidebar-nav">
                <li>
                    <a href="/Client" class="sidebar-link active">
                        <div class="sidebar-link-left">
                            <i class="bi bi-grid-fill"></i>
                            <span>Dashboard</span>
                        </div>
                        <span class="active-dot"></span>
                    </a>
                </li>
                <li>
                    <a href="/Client/Workouts" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-shield-check"></i>
                            <span>Workout Plans</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Diet" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-egg-fried"></i>
                            <span>Diet Plans</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Appointments" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-calendar2-event"></i>
                            <span>Appointments</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Analytics" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-graph-up-arrow"></i>
                            <span>Progress & Analytics</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Notifications" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-bell"></i>
                            <span>Notifications</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Profile" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-person"></i>
                            <span>Profile & Health</span>
                        </div>
                    </a>
                </li>
            </ul>
        </div>

        <div class="sidebar-bottom-section">
            <!-- Support Assistance Card -->
            <div class="support-card">
                <div class="support-icon">
                    <i class="bi bi-heart-pulse"></i>
                </div>
                <div class="support-title">Need assistance?</div>
                <div class="support-desc">Our care team is here to help with questions or goals.</div>
                <a href="mailto:support@healthtrack.com" class="support-link">
                    <span>Contact support</span>
                    <i class="bi bi-chevron-right" style="font-size: 0.7rem;"></i>
                </a>
            </div>

            <!-- Sign Out Form -->
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                <button type="submit" class="btn-signout">
                    <i class="bi bi-box-arrow-left"></i>
                    <span>Sign out</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- ========================================================= -->
    <!-- 2. MAIN DASHBOARD CONTENT                                 -->
    <!-- ========================================================= -->
    <div class="main-wrapper">
        
        <!-- Top Navbar -->
        <header class="top-navbar">
            <div class="search-box">
                <i class="bi bi-search search-icon"></i>
                <input type="text" class="search-input" placeholder="Search anything..." />
            </div>

            <div class="top-controls">
                <!-- Notifications Bell -->
                <a href="/Client/Notifications" class="btn-notification" title="Notifications">
                    <i class="bi bi-bell"></i>
                    @if (Model.UnreadNotificationsCount > 0)
                    {
                        <span class="notify-dot"></span>
                    }
                </a>

                <!-- User Profile Dropdown -->
                <div class="dropdown">
                    <button class="user-profile-pill btn p-0 border-0 d-flex align-items-center" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="avatar-initials">@initials</div>
                        <div class="user-meta d-none d-sm-block text-start ms-2">
                            <span class="user-name">@Model.FullName</span>
                            <span class="user-role-label">Client</span>
                        </div>
                        <i class="bi bi-chevron-down ms-2 text-muted" style="font-size: 0.75rem;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border border-slate-100 rounded-3 mt-2 py-2" aria-labelledby="userMenuDropdown" style="min-width: 220px; z-index: 1050;">
                        <li class="px-3 py-2 border-bottom">
                            <div class="fw-bold text-dark small">@Model.FullName</div>
                            <div class="text-muted" style="font-size: 0.78rem;">@(string.IsNullOrEmpty(Model.Email) ? "client@healthtrack.com" : Model.Email)</div>
                            <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2 py-0.5 rounded-pill mt-1" style="font-size: 0.7rem;">Client Account</span>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="/Client/Profile">
                                <i class="bi bi-person text-secondary"></i>
                                <span>Profile & Health</span>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="javascript:void(0)" onclick="openBookingModal()">
                                <i class="bi bi-calendar2-check text-secondary"></i>
                                <span>Book Consultation</span>
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li class="px-2 pt-1">
                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-2 py-1.5 d-flex align-items-center justify-content-center gap-2 fw-semibold">
                                    <i class="bi bi-box-arrow-left"></i>
                                    <span>Log out</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Body Container -->
        <main class="dashboard-body">

            <!-- Toast / Alerts -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3 shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3 shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Header Row -->
            <div class="dashboard-header">
                <div>
                    <span class="date-eyebrow">@DateTime.Now.ToString("dddd, MMMM d")</span>
                    <h1 class="greeting-title">@greeting, @userFirstName</h1>
                    <p class="greeting-subtext">Here's how your health journey is progressing today.</p>
                </div>
                <div>
                    <button type="button" class="btn-book-appointment" onclick="openBookingModal()">
                        <i class="bi bi-plus-lg"></i>
                        <span>Book appointment</span>
                    </button>
                </div>
            </div>

            @if (!Model.HasAssignedTrainer)
            {
                <!-- ================================================= -->
                <!-- ONBOARDING WELCOME BANNER (For clients without coach) -->
                <!-- ================================================= -->
                <div class="card border-0 mb-4 overflow-hidden position-relative" style="background: linear-gradient(135deg, #0B192C 0%, #152840 100%); border-radius: 20px; box-shadow: 0 10px 30px rgba(11, 25, 44, 0.15);">
                    <div class="card-body p-4 p-md-5 position-relative" style="z-index: 2;">
                        <div class="row align-items-center g-4">
                            <div class="col-lg-8">
                                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: rgba(16, 185, 129, 0.15); color: #34D399; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em;">
                                    <span style="width: 8px; height: 8px; border-radius: 50%; background: #10B981;"></span>
                                    <span>GETTING STARTED • STEP 1</span>
                                </div>
                                <h2 class="text-white fw-bold mb-2 fs-3">Connect With Your Personal Coach</h2>
                                <p class="text-white-50 mb-0" style="font-size: 0.95rem; line-height: 1.6; max-width: 600px;">
                                    You don't have an assigned coach yet. Pair with one of our certified specialists to unlock your custom workout programs, macronutrient targets, and 1-on-1 guidance.
                                </p>
                            </div>
                            <div class="col-lg-4 text-lg-end">
                                <div class="d-flex flex-column flex-sm-row flex-lg-column gap-2 justify-content-lg-end">
                                    <button type="button" class="btn text-white fw-bold px-4 py-2.5 rounded-3 shadow-sm d-inline-flex align-items-center justify-content-center gap-2" style="background: linear-gradient(135deg, #10B981 0%, #059669 100%); border: none;" data-bs-toggle="modal" data-bs-target="#coachSelectModal">
                                        <i class="bi bi-person-check-fill"></i>
                                        <span>Choose Your Coach</span>
                                    </button>
                                    <button type="button" class="btn btn-outline-light fw-semibold px-4 py-2.5 rounded-3 d-inline-flex align-items-center justify-content-center gap-2" onclick="openBookingModal()">
                                        <i class="bi bi-calendar2-plus"></i>
                                        <span>Book Consultation</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Active Coach Header Bar -->
                <div class="d-flex align-items-center justify-content-between p-3 rounded-4 mb-4 bg-white border shadow-sm flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-3">
                        <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(16, 185, 129, 0.12); color: #10B981; display: flex; align-items: center; justify-content: center; font-size: 1.35rem;">
                            <i class="bi bi-person-badge-fill"></i>
                        </div>
                        <div>
                            <div class="small text-muted text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 0.05em;">Your Head Coach</div>
                            <div class="fw-bold text-dark fs-6">@Model.TrainerName</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 px-3 py-1.5 fw-semibold" data-bs-toggle="modal" data-bs-target="#coachSelectModal">
                            <i class="bi bi-arrow-repeat me-1"></i> Switch Coach
                        </button>
                        <button type="button" class="btn btn-sm btn-success rounded-3 px-3 py-1.5 fw-bold" style="background: #10B981; border: none;" onclick="openBookingModal()">
                            <i class="bi bi-calendar2-plus me-1"></i> Book Session
                        </button>
                    </div>
                </div>
            }

            <!-- ================================================= -->
            <!-- 3 STAT CARDS (Weight, BMI, Calories)              -->
            <!-- ================================================= -->
            <div class="row g-4 mb-4">
                
                <!-- Card 1: Current Weight -->
                <div class="col-md-4">
                    <div class="stat-card">
                        <div class="stat-card-top">
                            <div class="stat-icon-wrapper stat-icon-green">
                                <i class="bi bi-speedometer2"></i>
                            </div>
                            <span class="stat-dots" onclick="openMeasurementModal()" title="Log new weight">â€¢â€¢â€¢</span>
                        </div>
                        <div class="stat-label">Current weight</div>
                        <div class="stat-value">
                            @if (Model.CurrentWeight > 0)
                            {
                                @Model.CurrentWeight<span class="stat-unit">kg</span>
                            }
                            else
                            {
                                <span style="color: #94A3B8;">--</span><span class="stat-unit">kg</span>
                            }
                        </div>
                        <div class="trend-pill @(Model.IsWeightTrendPositive ? "" : "negative")">
                            <i class="bi bi-graph-up-arrow"></i>
                            <span>@Model.WeightTrendText</span>
                        </div>
                    </div>
                </div>

                <!-- Card 2: BMI -->
                <div class="col-md-4">
                    <div class="stat-card">
                        <div class="stat-card-top">
                            <div class="stat-icon-wrapper stat-icon-blue">
                                <i class="bi bi-heart-pulse-fill"></i>
                            </div>
                            <span class="stat-dots" onclick="openMeasurementModal()" title="View BMI info">â€¢â€¢â€¢</span>
                        </div>
                        <div class="stat-label">Body mass index</div>
                        <div class="stat-value">
                            @if (Model.CurrentBmi > 0)
                            {
                                @Model.CurrentBmi<span class="stat-unit">BMI</span>
                            }
                            else
                            {
                                <span style="color: #94A3B8;">--</span><span class="stat-unit">BMI</span>
                            }
                        </div>
                        <div class="trend-pill">
                            <i class="bi bi-arrow-up-right"></i>
                            <span>@Model.BmiTrendText</span>
                        </div>
                    </div>
                </div>

                <!-- Card 3: Calories Burned -->
                <div class="col-md-4">
                    <div class="stat-card">
                        <div class="stat-card-top">
                            <div class="stat-icon-wrapper stat-icon-orange">
                                <i class="bi bi-fire"></i>
                            </div>
                            <span class="stat-dots" onclick="openMeasurementModal()" title="Log calories">â€¢â€¢â€¢</span>
                        </div>
                        <div class="stat-label">Calories burned</div>
                        <div class="stat-value">
                            @Model.CaloriesBurned.ToString("N0")<span class="stat-unit">kcal</span>
                        </div>
                        <div class="trend-pill">
                            <i class="bi bi-clock"></i>
                            <span>@Model.CaloriesTrendText</span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- ================================================= -->
            <!-- ROW 2: WEIGHT PROGRESS GRAPH & UPCOMING APPT      -->
            <!-- ================================================= -->
            <div id="analyticsSection" class="row g-4 mb-4">
                
                <!-- Left 8 cols: Weight Progress Graph -->
                <div class="col-lg-8">
                    <div class="chart-card">
                        <div class="chart-card-header">
                            <h2 class="section-title">Weight progress</h2>
                            <a href="javascript:void(0)" onclick="openMeasurementModal()" class="view-report-link">
                                <span>Log measurement</span>
                                <i class="bi bi-chevron-right" style="font-size: 0.75rem;"></i>
                            </a>
                        </div>
                        <div class="section-subtitle">Your weight trend over the last 30 days</div>

                        @if (Model.ChartWeights != null && Model.ChartWeights.Count > 0)
                        {
                            <div class="weight-hero-row">
                                <span class="weight-hero-val">@Model.CurrentWeight kg</span>
                                <span class="badge-month-trend">@Model.WeightChangeThisMonth</span>
                            </div>

                            <!-- Chart.js Canvas -->
                            <div style="position: relative; width: 100%; height: 190px;">
                                <canvas id="weightProgressChart"></canvas>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column align-items-center justify-content-center text-center py-4" style="min-height: 200px;">
                                <div style="width: 50px; height: 50px; border-radius: 50%; background: #ECFDF5; color: #10B981; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; margin-bottom: 0.65rem;">
                                    <i class="bi bi-graph-up-arrow"></i>
                                </div>
                                <div style="font-size: 1rem; font-weight: 700; color: #0F172A; margin-bottom: 0.25rem;">Start tracking your progress</div>
                                <div style="font-size: 0.82rem; color: #64748B; margin-bottom: 1rem; max-width: 320px;">
                                    Log your current weight today to start charting your journey over time.
                                </div>
                                <button type="button" class="btn btn-sm px-3 py-2 text-white" style="background: #10B981; border-radius: 8px; font-weight: 600;" onclick="openMeasurementModal()">
                                    <i class="bi bi-plus-lg me-1"></i> Log first measurement
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Right 4 cols: Upcoming Appointment Card -->
                <div class="col-lg-4">
                    <div class="appointment-card">
                        <div>
                            <div class="d-flex align-items-center justify-content-between">
                                <h2 class="section-title">Upcoming appointment</h2>
                                <span class="stat-dots" onclick="openBookingModal()" title="Reschedule">â€¢â€¢â€¢</span>
                            </div>

                            @if (Model.HasUpcomingAppointment)
                            {
                                <div class="appointment-badge-box">
                                    <div class="date-square">
                                        <span class="date-square-num">@Model.AppointmentDay</span>
                                        <span class="date-square-month">@Model.AppointmentMonth</span>
                                    </div>
                                    <div class="appt-info-right">
                                        <span class="appt-category-pill">
                                            <span class="appt-cat-dot"></span>
                                            <span>@Model.AppointmentType</span>
                                        </span>
                                        <div class="appt-provider-name">@Model.AppointmentProvider</div>
                                        <div class="appt-meta-item">
                                            <i class="bi bi-clock"></i>
                                            <span>@(string.IsNullOrEmpty(Model.AppointmentDateFormatted) ? Model.AppointmentTime : Model.AppointmentDateFormatted)</span>
                                        </div>
                                        <div class="appt-meta-item">
                                            <i class="bi bi-camera-video"></i>
                                            <span>Online video call</span>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center text-center py-3" style="min-height: 160px;">
                                    <div style="width: 46px; height: 46px; border-radius: 50%; background: #F1F5F9; color: #64748B; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; margin-bottom: 0.65rem;">
                                        <i class="bi bi-calendar-check"></i>
                                    </div>
                                    <div style="font-size: 0.95rem; font-weight: 700; color: #0F172A; margin-bottom: 0.25rem;">No upcoming appointments</div>
                                    <div style="font-size: 0.8rem; color: #64748B; margin-bottom: 0.85rem; max-width: 230px;">
                                        Schedule your next check-in or training session with a coach.
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="appt-btn-row">
                            @if (Model.HasUpcomingAppointment)
                            {
                                <button type="button" class="btn-appt-details" onclick="openBookingModal()">
                                    View details
                                </button>
                                <a href="javascript:void(0)" onclick="alert('Starting video consultation session with @Model.AppointmentProvider...')" class="btn-appt-join">
                                    Join call
                                </a>
                            }
                            else
                            {
                                <button type="button" class="btn-appt-join w-100" onclick="openBookingModal()">
                                    <i class="bi bi-plus-lg me-1"></i> Book consultation
                                </button>
                            }
                        </div>
                    </div>
                </div>

            </div>

            <!-- ================================================= -->
            <!-- ROW 3: TODAY'S PLAN & QUICK ACTIONS               -->
            <!-- ================================================= -->
            <div class="row g-4">
                
                <!-- Left 6 cols: Today's Plan -->
                <div class="col-lg-6">
                    <div class="bottom-card">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div>
                                <h2 class="section-title">Today's plan</h2>
                                <div class="section-subtitle mb-0">@Model.CompletedActivitiesCount of @Model.TotalActivitiesCount activities completed</div>
                            </div>
                            <div class="plan-percent-badge">
                                @Model.CompletionPercentage%
                            </div>
                        </div>

                        <div class="mt-3">
                            @foreach (var item in Model.TodayPlanItems)
                            {
                                <div class="plan-item">
                                    <div class="plan-item-left">
                                        <div class="plan-check-icon">
                                            @if (item.IsCompleted)
                                            {
                                                <i class="bi bi-check2"></i>
                                            }
                                            else if (item.Category == "Workout")
                                            {
                                                <i class="bi bi-activity"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-egg-fried"></i>
                                            }
                                        </div>
                                        <div>
                                            <div class="plan-item-title">@item.Title</div>
                                            <div class="plan-item-sub">@item.Subtitle</div>
                                        </div>
                                    </div>

                                    @if (item.IsCompleted)
                                    {
                                        <span class="badge-done">
                                            <span class="done-dot"></span>
                                            <span>Done</span>
                                        </span>
                                    }
                                    else if (item.Category == "Workout")
                                    {
                                        <button type="button" class="btn-plan-start" onclick="openWorkoutModal()">
                                            Start
                                        </button>
                                    }
                                    else if (item.Category == "Hydration")
                                    {
                                        <form asp-action="LogHydration" asp-controller="Client" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-plan-start">
                                                Log
                                            </button>
                                        </form>
                                    }
                                    else if (item.Title.Contains("breakfast", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <button type="button" class="btn-plan-start" onclick="openMealModal('Breakfast')">
                                            Log
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn-plan-start" onclick="openMealModal('Dinner')">
                                            Log
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Right 6 cols: Quick Actions Grid -->
                <div class="col-lg-6">
                    <div class="bottom-card">
                        <h2 class="section-title">Quick actions</h2>
                        <div class="section-subtitle">Stay on top of your daily goals</div>

                        <div class="row g-3">
                            <!-- Action 1: Log Workout -->
                            <div class="col-sm-6">
                                <div class="quick-action-tile" onclick="openWorkoutModal()">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="tile-icon-box">
                                            <i class="bi bi-activity"></i>
                                        </div>
                                        <div>
                                            <div class="tile-title">Log workout</div>
                                            <div class="tile-desc">Record your activity</div>
                                        </div>
                                    </div>
                                    <i class="bi bi-chevron-right text-muted" style="font-size: 0.8rem;"></i>
                                </div>
                            </div>

                            <!-- Action 2: Log a Meal -->
                            <div class="col-sm-6">
                                <div class="quick-action-tile" onclick="openMealModal()">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="tile-icon-box">
                                            <i class="bi bi-egg-fried"></i>
                                        </div>
                                        <div>
                                            <div class="tile-title">Log a meal</div>
                                            <div class="tile-desc">Track nutrition</div>
                                        </div>
                                    </div>
                                    <i class="bi bi-chevron-right text-muted" style="font-size: 0.8rem;"></i>
                                </div>
                            </div>

                            <!-- Action 3: Book a Visit -->
                            <div class="col-sm-6">
                                <div class="quick-action-tile" onclick="openBookingModal()">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="tile-icon-box">
                                            <i class="bi bi-calendar2-check"></i>
                                        </div>
                                        <div>
                                            <div class="tile-title">Book a visit</div>
                                            <div class="tile-desc">Find a specialist</div>
                                        </div>
                                    </div>
                                    <i class="bi bi-chevron-right text-muted" style="font-size: 0.8rem;"></i>
                                </div>
                            </div>

                            <!-- Action 4: Add Measurement -->
                            <div class="col-sm-6">
                                <div class="quick-action-tile" onclick="openMeasurementModal()">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="tile-icon-box">
                                            <i class="bi bi-speedometer2"></i>
                                        </div>
                                        <div>
                                            <div class="tile-title">Add measurement</div>
                                            <div class="tile-desc">Update your stats</div>
                                        </div>
                                    </div>
                                    <i class="bi bi-chevron-right text-muted" style="font-size: 0.8rem;"></i>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>

        </main>
    </div>

</div>

<!-- ========================================================= -->
<!-- MODAL: ADD MEASUREMENT                                    -->
<!-- ========================================================= -->
<div class="modal fade" id="measurementModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Add Health Measurement</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="LogMeasurement" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">Current Weight (kg)</label>
                        <input asp-for="QuickMeasurement.WeightKg" class="form-control rounded-3" step="0.1" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">Calories Burned (kcal)</label>
                        <input asp-for="QuickMeasurement.CaloriesBurned" class="form-control rounded-3" type="number" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">Water Intake (Liters)</label>
                        <input asp-for="QuickMeasurement.WaterIntakeLiters" class="form-control rounded-3" step="0.25" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">Notes / Activity summary</label>
                        <input asp-for="QuickMeasurement.Notes" class="form-control rounded-3" placeholder="Felt great during morning workout" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-3 px-4 fw-semibold" style="background-color: #10B981; border: none;">Save Measurement</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================= -->
<!-- MODAL: CHOOSE YOUR COACH (1-Click Selector)               -->
<!-- ========================================================= -->
<div class="modal fade" id="coachSelectModal" tabindex="-1" aria-labelledby="coachSelectModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white p-4" style="background: linear-gradient(135deg, #0B192C 0%, #152840 100%);">
                <div>
                    <h5 class="modal-title fw-bold text-white mb-1" id="coachSelectModalLabel">
                        <i class="bi bi-person-badge-fill text-success me-2"></i>Choose Your Personal Coach
                    </h5>
                    <small class="text-white-50">Select a specialist tailored to your health and performance targets</small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <div class="row g-3">
                    @foreach (var coach in Model.AvailableTrainers)
                    {
                        var isCurrent = coach.Id == Model.TrainerId;
                        var initials = string.Join("", coach.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(w => w[0])).ToUpper();
                        if (initials.Length > 2) initials = initials.Substring(0, 2);

                        <div class="col-md-6">
                            <div class="card h-100 border rounded-4 p-3 shadow-sm bg-white position-relative d-flex flex-column" style="transition: all 0.2s ease;">
                                @if (isCurrent)
                                {
                                    <span class="position-absolute top-0 end-0 m-3 badge bg-success text-white px-2 py-1 rounded-pill small">
                                        <i class="bi bi-check2"></i> Current Coach
                                    </span>
                                }
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div style="width: 50px; height: 50px; border-radius: 14px; background: linear-gradient(135deg, #10B981 0%, #059669 100%); color: white; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.15rem; flex-shrink: 0;">
                                        @initials
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0 fs-6">@coach.Name</h6>
                                        <div class="text-success small fw-semibold">@coach.RoleOrSpecialty</div>
                                    </div>
                                </div>
                                <div class="text-muted small mb-3 flex-grow-1" style="line-height: 1.5; font-size: 0.82rem;">
                                    Specializes in personalized training programs, accountability tracking, and weekly nutrition guidance.
                                </div>
                                <div>
                                    @if (isCurrent)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success w-100 rounded-3 fw-bold disabled" disabled>
                                            <i class="bi bi-check-circle-fill me-1"></i> Already Assigned
                                        </button>
                                    }
                                    else
                                    {
                                        <form asp-action="AssignCoach" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="trainerId" value="@coach.Id" />
                                            <button type="submit" class="btn btn-sm btn-dark w-100 rounded-3 fw-bold py-2 shadow-sm" style="background: #0B192C; border: none;">
                                                <i class="bi bi-check2 me-1"></i> Select as My Coach
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer bg-white p-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                <small class="text-muted">Want to talk first? You can also <a href="javascript:void(0)" onclick="bootstrap.Modal.getInstance(document.getElementById('coachSelectModal')).hide(); openBookingModal();" class="text-success fw-bold text-decoration-none">book a consultation session</a>.</small>
                <button type="button" class="btn btn-secondary rounded-3 px-3" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================= -->
<!-- MODAL: BOOK APPOINTMENT                                   -->
<!-- ========================================================= -->
<div class="modal fade" id="bookingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Book Trainer Consultation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="BookAppointment" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="alert alert-info py-2 px-3 small rounded-3 mb-3">
                        <i class="bi bi-shield-check me-1"></i> Conflict-Detection Active: System automatically verifies coach schedule availability.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">Select Date</label>
                        <input asp-for="QuickBooking.AppointmentDate" type="date" class="form-control rounded-3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">Available Time Slot</label>
                        <select asp-for="QuickBooking.TimeSlot" class="form-select rounded-3">
                            <option value="09:00 AM">09:00 AM</option>
                            <option value="10:30 AM" selected>10:30 AM</option>
                            <option value="01:00 PM">01:00 PM</option>
                            <option value="03:30 PM">03:30 PM</option>
                            <option value="05:00 PM">05:00 PM</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">Consultation Goal</label>
                        <textarea asp-for="QuickBooking.Notes" class="form-control rounded-3" rows="2" placeholder="Routine review, form check, or diet adjustments"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-3 px-4 fw-semibold" style="background-color: #10B981; border: none;">Confirm Booking</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================= -->
<!-- MODAL: LOG MEAL                                           -->
<!-- ========================================================= -->
<div class="modal fade" id="mealModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Log Daily Meal</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
                <div>
                    <span class="badge bg-primary px-3 py-1 mb-2">Viva Voce Demonstration</span>
                    <h4 class="fw-bold text-dark mb-1">Pre-Configured Evaluation Accounts</h4>
                    <p class="small text-muted mb-0">Use these pre-seeded credentials to evaluate the 3 user roles during assessment.</p>
                </div>
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-ht-primary px-4 py-2">
                    Proceed to Sign In <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <div class="p-3 bg-white rounded-3 border border-slate-200">
                        <span class="badge bg-primary text-white mb-2">Client Role</span>
                        <div class="small fw-bold text-dark">Email: client@healthtrack.com</div>
                        <div class="small text-muted">Password: <code>Client123!</code></div>
                        <span class="text-xs text-muted mt-2 d-block">Tests: Daily logging, workouts, booking.</span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 bg-white rounded-3 border border-slate-200">
                        <span class="badge bg-purple text-white mb-2" style="background-color: #7C3AED;">Trainer Role</span>
                        <div class="small fw-bold text-dark">Email: trainer@healthtrack.com</div>
                        <div class="small text-muted">Password: <code>Trainer123!</code></div>
                        <span class="text-xs text-muted mt-2 d-block">Tests: Routine builder, appointment queue.</span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 bg-white rounded-3 border border-slate-200">
                        <span class="badge bg-dark text-white mb-2">Admin Role</span>
                        <div class="small fw-bold text-dark">Email: admin@healthtrack.com</div>
                        <div class="small text-muted">Password: <code>Admin123!</code></div>
                        <span class="text-xs text-muted mt-2 d-block">Tests: User roles, global metrics.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

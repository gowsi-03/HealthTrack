<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HealthTrack</title>
    
    <!-- Google Fonts & Bootstrap 5 & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --ht-green: #10B981;
            --ht-green-dark: #059669;
            --ht-green-light: #ECFDF5;
            --ht-blue: #1D4ED8;
            --ht-dark: #0F172A;
            --ht-muted: #64748B;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #FFFFFF;
            color: var(--ht-dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* Navbar exact style from shared screenshot */
        .ht-header {
            background-color: #FFFFFF;
            padding: 1.25rem 0;
            border-bottom: 1px solid rgba(241, 245, 249, 0.8);
        }

        .ht-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            font-weight: 800;
            font-size: 1.45rem;
            letter-spacing: -0.02em;
            color: #0F172A;
        }
        .ht-brand-accent {
            color: #10B981;
        }

        /* Logo Icon from Screenshot (Teal/Emerald rounded squircle with heart) */
        .ht-logo-icon {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            background: linear-gradient(135deg, #10B981 0%, #059669 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #FFFFFF;
            font-size: 1.15rem;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
        }

        /* Center Nav Links */
        .ht-nav-link {
            color: #475569 !important;
            font-weight: 500;
            font-size: 0.95rem;
            padding: 0.5rem 1.15rem !important;
            text-decoration: none;
            transition: color 0.15s ease;
        }
        .ht-nav-link:hover {
            color: #10B981 !important;
        }

        /* Right Buttons from Screenshot */
        .nav-link-login {
            color: #0F172A !important;
            font-weight: 600;
            font-size: 0.95rem;
            text-decoration: none;
            padding: 0.5rem 1rem;
            transition: color 0.15s ease;
        }
        .nav-link-login:hover {
            color: #10B981 !important;
        }

        .btn-get-started {
            background-color: #10B981;
            color: #FFFFFF !important;
            font-weight: 600;
            font-size: 0.95rem;
            padding: 0.65rem 1.6rem;
            border-radius: 9999px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            border: none;
        }
        .btn-get-started:hover {
            background-color: #059669;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(16, 185, 129, 0.45);
        }

        main { flex: 1; }

        footer {
            background-color: #FAFAFA;
            border-top: 1px solid #F1F5F9;
            color: #64748B;
        }
    </style>
</head>
<body>
    <header class="ht-header sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light py-0">
            <div class="container">
                <!-- Brand: Logo Icon + HealthTrack -->
                <a class="ht-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="ht-logo-icon">
                        <i class="bi bi-heart"></i>
                    </div>
                    <span>Health<span class="ht-brand-accent">Track</span></span>
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Center Links: How it works, Features, For trainers, About -->
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="ht-nav-link" href="#how-it-works">How it works</a>
                        </li>
                        <li class="nav-item">
                            <a class="ht-nav-link" href="#features">Features</a>
                        </li>
                        <li class="nav-item">
                            <a class="ht-nav-link" href="#for-trainers">For trainers</a>
                        </li>
                        <li class="nav-item">
                            <a class="ht-nav-link" href="#features">About</a>
                        </li>
                    </ul>

                    <!-- Right Controls: Log in & Get started pill -->
                    <div class="d-flex align-items-center">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="py-5 mt-auto">
        <div class="container">
            <div class="row g-4 justify-content-between align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <div class="ht-brand mb-2">
                        <span>Health<span class="ht-brand-accent">Track</span></span>
                    </div>
                    <p class="small text-muted mb-0">Personal Health & Fitness Management System</p>
                    <p class="small text-secondary mb-0">CS6004ES – Application Development • London Metropolitan University</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <p class="small text-muted mb-2">&copy; @DateTime.Now.Year HealthTrack • ASP.NET Core MVC & C#</p>
                    <div class="d-inline-flex gap-2">
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2.5 py-1 rounded-pill">.NET 10 LTS</span>
                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2.5 py-1 rounded-pill">Bootstrap 5</span>
                        <span class="badge bg-dark bg-opacity-10 text-dark border border-dark border-opacity-25 px-2.5 py-1 rounded-pill">SQL LocalDB</span>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
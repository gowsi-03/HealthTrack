<div class="modal fade" id="workoutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Active Workout Routine</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                    <div>
                        <div class="fw-bold text-dark">@(Model.ActiveWorkoutPlan?.Title ?? "Upper Body Hypertrophy")</div>
                        <div class="small text-muted">Assigned by Coach @(Model.TrainerName ?? "Personal Coach")</div>
                    </div>
                    <span class="badge bg-success bg-opacity-15 text-success px-3 py-1.5 rounded-pill fw-bold">Active Routine</span>
                </div>

                <div class="workout-exercise-list">
                    @if (Model.ActiveWorkoutPlan?.Exercises != null && Model.ActiveWorkoutPlan.Exercises.Any())
                    {
                        foreach (var ex in Model.ActiveWorkoutPlan.Exercises)
                        {
                            <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                                <div class="form-check d-flex align-items-center gap-2 mb-0">
                                    <input class="form-check-input" type="checkbox" id="ex_@ex.Id" @(ex.IsCompleted ? "checked" : "") onchange="toggleExercise(@ex.Id)" />
                                    <label class="form-check-label fw-semibold small" for="ex_@ex.Id">@ex.Name</label>
                                </div>
                                <span class="small text-muted">@ex.Sets â€¢ @ex.Reps</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                            <div class="form-check d-flex align-items-center gap-2 mb-0">
                                <input class="form-check-input" type="checkbox" checked />
                                <label class="form-check-label fw-semibold small">Barbell Bench Press</label>
                            </div>
                            <span class="small text-muted">4 sets â€¢ 10 reps (60 kg)</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                            <div class="form-check d-flex align-items-center gap-2 mb-0">
                                <input class="form-check-input" type="checkbox" checked />
                                <label class="form-check-label fw-semibold small">Incline Dumbbell Rows</label>
                            </div>
                            <span class="small text-muted">3 sets â€¢ 12 reps (18 kg)</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                            <div class="form-check d-flex align-items-center gap-2 mb-0">
                                <input class="form-check-input" type="checkbox" />
                                <label class="form-check-label fw-semibold small">Overhead Dumbbell Press</label>
                            </div>
                            <span class="small text-muted">3 sets â€¢ 10 reps (35 kg)</span>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-success w-100 rounded-3 py-2 fw-semibold" style="background-color: #10B981; border: none;" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap 5 Scripts -->
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<!-- Interactive Scripts & Chart.js Config -->
<script>
    // Modal Helpers
    const measurementModal = new bootstrap.Modal(document.getElementById('measurementModal'));
    const bookingModal = new bootstrap.Modal(document.getElementById('bookingModal'));
    const mealModal = new bootstrap.Modal(document.getElementById('mealModal'));
    const workoutModal = new bootstrap.Modal(document.getElementById('workoutModal'));

    function openMeasurementModal() { measurementModal.show(); }
    function openBookingModal() { bookingModal.show(); }
    function openMealModal(mealType) {
        if (mealType) {
            const select = document.querySelector('#mealModal select[name="QuickMeal.MealType"]');
            if (select) select.value = mealType;
        }
        mealModal.show();
    }
    function openWorkoutModal() { workoutModal.show(); }

    function toggleExercise(id) {
        fetch('/Client/ToggleExercise/' + id, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        }).then(() => {
            setTimeout(() => window.location.reload(), 300);
        }).catch(err => console.error(err));
    }

    // Chart.js Configuration Matching Uploaded Design Reference
    document.addEventListener("DOMContentLoaded", function () {
        const canvas = document.getElementById('weightProgressChart');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        
        // Gradient Area Fill
        const gradient = ctx.createLinearGradient(0, 0, 0, 180);
        gradient.addColorStop(0, 'rgba(16, 185, 129, 0.22)');
        gradient.addColorStop(1, 'rgba(16, 185, 129, 0.0)');

        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels));
        const dataValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartWeights));

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    data: dataValues,
                    borderColor: '#10B981',
                    borderWidth: 3.5,
                    backgroundColor: gradient,
                    fill: true,
                    tension: 0.38, // Smooth spline curve matching screenshot
                    pointBackgroundColor: '#FFFFFF',
                    pointBorderColor: '#10B981',
                    pointBorderWidth: 2.5,
                    pointRadius: 5,
                    pointHoverRadius: 7,
                    pointHoverBackgroundColor: '#10B981',
                    pointHoverBorderColor: '#FFFFFF',
                    pointHoverBorderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#0F172A',
                        titleColor: '#94A3B8',
                        bodyColor: '#FFFFFF',
                        titleFont: { family: 'Plus Jakarta Sans', size: 11 },
                        bodyFont: { family: 'Plus Jakarta Sans', size: 13, weight: 'bold' },
                        padding: 10,
                        cornerRadius: 8,
                        displayColors: false,
                        callbacks: {
                            label: function(context) {
                                return context.parsed.y + ' kg';
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: {
                            color: '#94A3B8',
                            font: { family: 'Plus Jakarta Sans', size: 11 }
                        }
                    },
                    y: {
                        border: { dash: [4, 4] },
                        grid: { color: '#F1F5F9' },
                        ticks: {
                            color: '#94A3B8',
                            font: { family: 'Plus Jakarta Sans', size: 11 },
                            stepSize: 5
                        }
                    }
                }
            }
        });
    });
</script>

</body>
</html>

@page
@model HealthTrack.Areas.Identity.Pages.Account.TrainerPendingApprovalModel
@{
    ViewData["Title"] = "Trainer Application Under Review";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Application Under Review - HealthTrack</title>
    
    <!-- Google Fonts & Bootstrap 5 & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --ht-green: #10B981;
            --ht-green-hover: #059669;
            --ht-green-bg: #ECFDF5;
            --ht-dark-navy: #0B192C;
            --ht-slate: #0F172A;
            --ht-muted: #64748B;
            --ht-border: #E2E8F0;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #F8FAFC;
            color: #0F172A;
            min-height: 100vh;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .review-wrapper {
            width: 100%;
            max-width: 620px;
            padding: 2rem 1.25rem;
        }

        .brand-logo-center {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 2rem;
            text-decoration: none;
        }

        .brand-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: linear-gradient(135deg, #10B981, #059669);
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 1.25rem;
            box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);
        }

        .brand-text {
            color: var(--ht-dark-navy);
            font-weight: 800;
            font-size: 1.4rem;
            letter-spacing: -0.5px;
        }

        .review-card {
            background-color: #FFFFFF;
            border: 1px solid var(--ht-border);
            border-radius: 20px;
            padding: 2.75rem 2.5rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.04), 0 8px 10px -6px rgba(0, 0, 0, 0.02);
            text-align: center;
        }

        .icon-circle-amber {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background-color: #FEF3C7;
            color: #D97706;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 0 0 8px #FFFBEB;
            animation: pulse-amber 2s infinite ease-in-out;
        }

        @@keyframes pulse-amber {
            0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.25); }
            70% { box-shadow: 0 0 0 12px rgba(245, 158, 11, 0); }
            100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }
        }

        .pending-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background-color: #FFFBEB;
            border: 1px solid #FDE68A;
            color: #B45309;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            padding: 4px 12px;
            border-radius: 999px;
            margin-bottom: 1rem;
        }

        .pending-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background-color: #F59E0B;
        }

        .review-title {
            font-size: 1.65rem;
            font-weight: 800;
            color: var(--ht-slate);
            letter-spacing: -0.5px;
            margin-bottom: 0.5rem;
        }

        .review-subtitle {
            font-size: 0.95rem;
            color: var(--ht-muted);
            line-height: 1.5;
            margin-bottom: 1.75rem;
        }

        .info-step-box {
            background-color: #F8FAFC;
            border: 1px solid var(--ht-border);
            border-radius: 14px;
            padding: 1.25rem 1.5rem;
            text-align: left;
            margin-bottom: 2rem;
        }

        .step-item {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            padding: 0.65rem 0;
        }

        .step-item:not(:last-child) {
            border-bottom: 1px solid #F1F5F9;
        }

        .step-num {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background-color: #E2E8F0;
            color: #475569;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.78rem;
            font-weight: 700;
            flex-shrink: 0;
            margin-top: 2px;
        }

        .step-num.active {
            background-color: #10B981;
            color: #FFFFFF;
        }

        .step-num.pending {
            background-color: #F59E0B;
            color: #FFFFFF;
        }

        .step-title {
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--ht-slate);
            margin-bottom: 2px;
        }

        .step-desc {
            font-size: 0.8rem;
            color: var(--ht-muted);
            line-height: 1.4;
        }

        .btn-action-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background-color: var(--ht-green);
            color: #FFFFFF;
            font-weight: 700;
            font-size: 0.92rem;
            padding: 0.85rem 1.75rem;
            border-radius: 12px;
            text-decoration: none;
            transition: all 0.2s;
            border: none;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);
            width: 100%;
        }

        .btn-action-primary:hover {
            background-color: var(--ht-green-hover);
            color: #FFFFFF;
            transform: translateY(-1px);
        }

        .btn-action-secondary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            background-color: transparent;
            color: var(--ht-muted);
            font-weight: 600;
            font-size: 0.88rem;
            padding: 0.7rem 1.5rem;
            text-decoration: none;
            border: none;
            transition: color 0.2s;
            margin-top: 0.75rem;
        }

        .btn-action-secondary:hover {
            color: var(--ht-slate);
        }

        .login-alert-banner {
            background-color: #FEF2F2;
            border: 1px solid #FECACA;
            color: #991B1B;
            border-radius: 12px;
            padding: 0.9rem 1.25rem;
            font-size: 0.86rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 10px;
            text-align: left;
        }
    </style>
</head>
<body>

    <div class="review-wrapper">
        <a href="/" class="brand-logo-center">
            <div class="brand-icon">H</div>
            <span class="brand-text">HealthTrack</span>
        </a>

        <div class="review-card">
            @if (Model.FromLogin)
            {
                <div class="login-alert-banner">
                    <i class="bi bi-exclamation-triangle-fill fs-5 text-danger flex-shrink-0"></i>
                    <div>
                        <strong>Account Under Review:</strong> Your trainer profile has not yet been approved by an administrator. Please wait for the confirmation email before logging in.
                    </div>
                </div>
            }

            <div class="icon-circle-amber">
                <i class="bi bi-clock-history"></i>
            </div>

            <div>
                <span class="pending-badge">
                    <span class="pending-dot"></span>
                    <span>Application Under Review</span>
                </span>
            </div>

            <h1 class="review-title">Trainer Account Created!</h1>
            <p class="review-subtitle">
                Thank you, <strong>@Model.Name</strong>. Your coach registration is in our review queue. To ensure safety and coaching excellence, an Administrator will verify your profile prior to activating your dashboard access.
            </p>

            <div class="info-step-box">
                <div class="step-item">
                    <div class="step-num active"><i class="bi bi-check"></i></div>
                    <div>
                        <div class="step-title">1. Account Registered</div>
                        <div class="step-desc">Your credentials have been securely stored in the HealthTrack platform.</div>
                    </div>
                </div>
                <div class="step-item">
                    <div class="step-num pending"><i class="bi bi-hourglass-split"></i></div>
                    <div>
                        <div class="step-title">2. Administrator Review</div>
                        <div class="step-desc">Our administrative team reviews all coach registrations for credentials & safety.</div>
                    </div>
                </div>
                <div class="step-item">
                    <div class="step-num"><i class="bi bi-envelope"></i></div>
                    <div>
                        <div class="step-title">3. Instant Notification</div>
                        <div class="step-desc">You will receive an automated email at <strong>@Model.Email</strong> the moment you are approved.</div>
                    </div>
                </div>
            </div>

            <a href="/" class="btn-action-primary">
                <i class="bi bi-house-door-fill"></i> Return to Homepage
            </a>

            <a href="/Identity/Account/Login" class="btn-action-secondary">
                <i class="bi bi-box-arrow-in-right"></i> Back to Sign In
            </a>
        </div>
    </div>

</body>
</html>

@model HealthTrack.Models.ViewModels.AppointmentsViewModel
@{
    ViewData["Title"] = "Appointments - HealthTrack";
    Layout = null;
    var initials = string.Join("", Model.FullName.Split(' ').Select(n => n.Length > 0 ? n[0].ToString() : "")).ToUpper();
    if (initials.Length > 2) initials = initials.Substring(0, 2);
    if (string.IsNullOrEmpty(initials)) initials = "JD";

    var currentList = Model.ActiveTab == "Past" ? Model.PastAppointments : Model.UpcomingAppointments;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Appointments - HealthTrack</title>

    <!-- Google Fonts & Bootstrap 5 & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --ht-navy: #0B192C;
            --ht-navy-light: #1E293B;
            --ht-navy-hover: #152840;
            --ht-green: #10B981;
            --ht-green-hover: #059669;
            --ht-teal: #0D9488;
            --ht-teal-light: #CCFBF1;
            --ht-teal-dark: #0F766E;
            --ht-slate: #0F172A;
            --ht-muted: #64748B;
            --ht-border: #E2E8F0;
            --ht-bg: #F8FAFC;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--ht-bg);
            color: var(--ht-slate);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        .dashboard-container {
            display: flex;
            min-height: 100vh;
        }

        /* ========================================================= */
        /* 1. SIDEBAR (Dark Navy)                                    */
        /* ========================================================= */
        .sidebar {
            width: 255px;
            background-color: var(--ht-navy);
            color: #FFFFFF;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: sticky;
            top: 0;
            height: 100vh;
            max-height: 100vh;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 1.5rem 1.15rem;
            flex-shrink: 0;
            z-index: 100;
        }

        .sidebar::-webkit-scrollbar {
            width: 5px;
        }
        .sidebar::-webkit-scrollbar-track {
            background: rgba(11, 25, 44, 0.4);
        }
        .sidebar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 4px;
        }
        .sidebar::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.35);
        }

        .brand-header {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
            font-size: 1.35rem;
            color: #FFFFFF;
            text-decoration: none;
            margin-bottom: 1.35rem;
            padding-left: 0.5rem;
        }
        .brand-header:hover { color: #FFFFFF; }

        .brand-icon {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            background: linear-gradient(135deg, #10B981 0%, #059669 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #FFFFFF;
            font-size: 1.2rem;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
        }

        .nav-category {
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            color: #64748B;
            text-transform: uppercase;
            padding: 0.5rem 0.75rem;
            margin-bottom: 0.5rem;
        }

        .sidebar-nav {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 0.65rem 0.85rem;
            border-radius: 12px;
            color: #94A3B8;
            text-decoration: none;
            font-size: 0.92rem;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .sidebar-link:hover {
            color: #FFFFFF;
            background-color: var(--ht-navy-hover);
        }

        .sidebar-link.active {
            background-color: rgba(255, 255, 255, 0.08);
            color: #FFFFFF;
        }

        .sidebar-link-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sidebar-link i { font-size: 1.15rem; }

        .active-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background-color: var(--ht-green);
            box-shadow: 0 0 8px rgba(16, 185, 129, 0.7);
        }

        .sidebar-bottom-section {
            margin-top: 1.25rem;
            flex-shrink: 0;
            padding-bottom: 0.75rem;
        }

        .support-card {
            background: rgba(30, 41, 59, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 1rem;
            margin-bottom: 0.75rem;
        }

        .support-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: rgba(16, 185, 129, 0.15);
            color: var(--ht-green);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
            margin-bottom: 0.75rem;
        }

        .support-title { font-size: 0.88rem; font-weight: 700; color: #FFFFFF; margin-bottom: 0.25rem; }
        .support-desc { font-size: 0.75rem; color: #94A3B8; margin-bottom: 0.65rem; line-height: 1.4; }
        .support-link { font-size: 0.78rem; font-weight: 700; color: #FFFFFF; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; }
        .support-link:hover { color: var(--ht-green); }

        .btn-signout {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #94A3B8;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 600;
            padding: 0.6rem 0.75rem;
            border-radius: 10px;
            background: none;
            border: none;
            width: 100%;
            text-align: left;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .btn-signout:hover { color: #EF4444; background-color: rgba(239, 68, 68, 0.1); }

        /* ========================================================= */
        /* 2. TOP NAVBAR                                             */
        /* ========================================================= */
        .main-wrapper { flex: 1; display: flex; flex-direction: column; overflow-x: hidden; }

        .top-navbar {
            background-color: #FFFFFF;
            border-bottom: 1px solid var(--ht-border);
            padding: 0.95rem 2.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 90;
        }

        .search-box { position: relative; width: 340px; }
        .search-input {
            width: 100%;
            height: 42px;
            padding: 0.5rem 1rem 0.5rem 2.5rem;
            background-color: #F8FAFC;
            border: 1px solid var(--ht-border);
            border-radius: 12px;
            font-size: 0.9rem;
            color: var(--ht-slate);
            transition: all 0.2s ease;
        }
        .search-input:focus {
            background-color: #FFFFFF;
            border-color: var(--ht-green);
            outline: none;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.12);
        }
        .search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #94A3B8;
            font-size: 0.9rem;
        }

        .top-controls { display: flex; align-items: center; gap: 1.25rem; }

        .btn-notification {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            border: 1px solid var(--ht-border);
            background: #FFFFFF;
            color: #475569;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .btn-notification:hover { background-color: #F1F5F9; color: var(--ht-slate); }

        .notify-dot {
            position: absolute;
            top: 9px;
            right: 9px;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #EF4444;
            border: 2px solid #FFFFFF;
        }

        .user-profile-pill {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 4px 8px 4px 4px;
            border-radius: 30px;
            border: 1px solid transparent;
            cursor: pointer;
            transition: all 0.15s ease;
            background: none;
        }
        .user-profile-pill:hover { background-color: #F1F5F9; border-color: var(--ht-border); }

        .avatar-initials {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: linear-gradient(135deg, #1D4ED8 0%, #10B981 100%);
            color: #FFFFFF;
            font-weight: 700;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* ========================================================= */
        /* 3. DASHBOARD BODY & MAIN LAYOUT                           */
        /* ========================================================= */
        .dashboard-body {
            padding: 2.25rem 2.5rem 4rem;
            max-width: 1400px;
            width: 100%;
            margin: 0 auto;
        }

        /* Page Header matching image */
        .page-header-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 2rem;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

        .page-eyebrow {
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            color: #64748B;
            text-transform: uppercase;
            margin-bottom: 0.35rem;
        }

        .page-main-title {
            font-size: 2rem;
            font-weight: 800;
            color: #0F172A;
            letter-spacing: -0.025em;
            margin-bottom: 0.35rem;
        }

        .page-subtitle {
            font-size: 0.95rem;
            color: #64748B;
            font-weight: 500;
            margin: 0;
        }

        .btn-book-cta {
            background: linear-gradient(135deg, #10B981 0%, #059669 100%);
            color: #FFFFFF !important;
            font-weight: 700;
            font-size: 0.95rem;
            padding: 0.75rem 1.6rem;
            border-radius: 12px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: none;
            box-shadow: 0 4px 14px rgba(16, 185, 129, 0.28);
            transition: all 0.2s ease;
            cursor: pointer;
        }
        .btn-book-cta:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(16, 185, 129, 0.38);
            filter: brightness(1.05);
        }

        /* ========================================================= */
        /* 4. CONTROLS BAR (Tabs, Search, Filter)                     */
        /* ========================================================= */
        .controls-card {
            background-color: #FFFFFF;
            border: 1px solid var(--ht-border);
            border-radius: 18px;
            padding: 0.85rem 1.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.25rem;
            margin-bottom: 1.75rem;
            box-shadow: 0 2px 6px rgba(15, 23, 42, 0.02);
            flex-wrap: wrap;
        }

        .tabs-pill-group {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .tab-btn {
            font-size: 0.88rem;
            font-weight: 700;
            padding: 0.55rem 1.25rem;
            border-radius: 9999px;
            text-decoration: none;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: none;
            background: transparent;
            color: #64748B;
            cursor: pointer;
        }
        .tab-btn:hover {
            color: #0F172A;
            background-color: #F1F5F9;
        }
        .tab-btn.active {
            background-color: #0B192C;
            color: #FFFFFF;
        }
        .tab-counter-badge {
            font-size: 0.78rem;
            font-weight: 800;
            margin-left: 2px;
        }

        .controls-right-group {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .appt-search-box {
            position: relative;
            width: 260px;
        }
        .appt-search-input {
            width: 100%;
            height: 38px;
            padding: 0.4rem 0.85rem 0.4rem 2.25rem;
            background-color: #F8FAFC;
            border: 1px solid var(--ht-border);
            border-radius: 12px;
            font-size: 0.88rem;
            color: #0F172A;
            transition: all 0.2s ease;
        }
        .appt-search-input:focus {
            background-color: #FFFFFF;
            border-color: var(--ht-green);
            outline: none;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.12);
        }
        .appt-search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: #94A3B8;
            font-size: 0.85rem;
        }

        .btn-filter-dropdown {
            height: 38px;
            padding: 0.4rem 1.1rem;
            border: 1px solid var(--ht-border);
            background-color: #FFFFFF;
            color: #475569;
            font-size: 0.88rem;
            font-weight: 600;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.15s ease;
            cursor: pointer;
        }
        .btn-filter-dropdown:hover {
            background-color: #F8FAFC;
            border-color: #CBD5E1;
            color: #0F172A;
        }

        /* ========================================================= */
        /* 5. APPOINTMENTS LIST CARD (Exact match to screenshot)     */
        /* ========================================================= */
        .appointments-card {
            background-color: #FFFFFF;
            border: 1px solid var(--ht-border);
            border-radius: 20px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
            overflow: hidden;
        }

        .appointment-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1.45rem 2rem;
            border-bottom: 1px solid #F1F5F9;
            transition: background-color 0.15s ease;
        }
        .appointment-row:last-child {
            border-bottom: none;
        }
        .appointment-row:hover {
            background-color: #FAFCFF;
        }

        .row-left-group {
            display: flex;
            align-items: center;
            gap: 22px;
            flex: 1;
            min-width: 0;
        }

        /* Date block (18 APR) */
        .date-block {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-width: 48px;
            text-align: center;
        }
        .date-day {
            font-size: 1.45rem;
            font-weight: 800;
            color: #0F172A;
            line-height: 1;
        }
        .date-month {
            font-size: 0.72rem;
            font-weight: 800;
            color: #64748B;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            margin-top: 3px;
        }

        /* Specialist Avatar Box (MP, CW, NF) */
        .specialist-avatar-box {
            width: 46px;
            height: 46px;
            border-radius: 14px;
            background-color: #CCFBF1;
            color: #0F766E;
            font-weight: 800;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            letter-spacing: -0.02em;
        }

        /* Middle details */
        .appt-details-col {
            display: flex;
            flex-direction: column;
            gap: 2px;
            min-width: 0;
        }

        .category-eyebrow {
            font-size: 0.7rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            color: #0D9488;
            text-transform: uppercase;
        }

        .specialist-name {
            font-size: 1.05rem;
            font-weight: 700;
            color: #0F172A;
            margin: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .time-meta-row {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.8rem;
            color: #64748B;
            font-weight: 500;
            margin-top: 2px;
        }
        .time-meta-row i {
            font-size: 0.82rem;
            color: #94A3B8;
        }

        /* Right actions & status */
        .row-right-group {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-shrink: 0;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.78rem;
            font-weight: 700;
            padding: 4px 14px;
            border-radius: 9999px;
            white-space: nowrap;
        }
        .pill-approved {
            background-color: #ECFDF5;
            color: #059669;
        }
        .pill-pending {
            background-color: #FFFBEB;
            color: #D97706;
        }
        .pill-completed {
            background-color: #F1F5F9;
            color: #475569;
        }
        .pill-cancelled {
            background-color: #FEF2F2;
            color: #DC2626;
        }

        .dot-green {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: #10B981;
        }
        .dot-amber {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: #F59E0B;
        }
        .dot-gray {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: #94A3B8;
        }
        .dot-red {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: #EF4444;
        }

        .btn-view-appt {
            border: 1px solid var(--ht-border);
            background: #FFFFFF;
            color: #0F172A;
            font-weight: 600;
            font-size: 0.85rem;
            padding: 0.45rem 1.2rem;
            border-radius: 10px;
            transition: all 0.15s ease;
            cursor: pointer;
        }
        .btn-view-appt:hover {
            background-color: #F8FAFC;
            border-color: #CBD5E1;
            color: #0F172A;
        }

        .btn-cancel-appt {
            background: none;
            border: none;
            color: #0D9488;
            font-weight: 600;
            font-size: 0.85rem;
            padding: 0.45rem 0.65rem;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .btn-cancel-appt:hover {
            color: #EF4444;
            text-decoration: underline;
        }

        /* Empty state */
        .empty-state {
            padding: 4rem 2rem;
            text-align: center;
        }
        .empty-icon {
            width: 64px;
            height: 64px;
            border-radius: 20px;
            background-color: #F1F5F9;
            color: #94A3B8;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin-bottom: 1.25rem;
        }

        /* Toast / Alert */
        .alert-custom-success {
            background-color: #ECFDF5;
            border: 1px solid #A7F3D0;
            color: #065F46;
            border-radius: 12px;
            font-weight: 600;
            padding: 1rem 1.25rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        @@media (max-width: 992px) {
            .sidebar { display: none; }
            .top-navbar { padding: 0.85rem 1.25rem; }
            .dashboard-body { padding: 1.5rem 1rem; }
            .appointment-row { flex-direction: column; align-items: flex-start; gap: 1rem; }
            .row-right-group { width: 100%; justify-content: flex-end; }
            .appt-search-box { width: 100%; }
        }
    </style>
</head>
<body>

<div class="dashboard-container">

    <!-- ========================================================= -->
    <!-- 1. LEFT SIDEBAR                                           -->
    <!-- ========================================================= -->
    <aside class="sidebar">
        <div>
            <a href="/" class="brand-header">
                <div class="brand-icon">
                    <i class="bi bi-heart-pulse-fill"></i>
                </div>
                <span>HealthTrack</span>
            </a>

            <div class="nav-category">WORKSPACE</div>
            <ul class="sidebar-nav">
                <li>
                    <a href="/Client" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-grid"></i>
                            <span>Dashboard</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Workouts" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-shield-check"></i>
                            <span>Workout Plans</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Diet" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-egg-fried"></i>
                            <span>Diet Plans</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Appointments" class="sidebar-link active">
                        <div class="sidebar-link-left">
                            <i class="bi bi-calendar2-event"></i>
                            <span>Appointments</span>
                        </div>
                        <span class="active-dot"></span>
                    </a>
                </li>
                <li>
                    <a href="/Client/Analytics" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-graph-up-arrow"></i>
                            <span>Progress & Analytics</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Notifications" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-bell"></i>
                            <span>Notifications</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Client/Profile" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-person"></i>
                            <span>Profile & Health</span>
                        </div>
                    </a>
                </li>
            </ul>
        </div>

        <div class="sidebar-bottom-section">
            <div class="support-card">
                <div class="support-icon">
                    <i class="bi bi-heart-pulse"></i>
                </div>
                <div class="support-title">Need assistance?</div>
                <div class="support-desc">Our medical & coaching team is here to assist your schedule.</div>
                <a href="mailto:support@healthtrack.com" class="support-link">
                    <span>Contact support</span>
                    <i class="bi bi-chevron-right" style="font-size: 0.7rem;"></i>
                </a>
            </div>

            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                <button type="submit" class="btn-signout">
                    <i class="bi bi-box-arrow-left"></i>
                    <span>Sign out</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- ========================================================= -->
    <!-- 2. MAIN CONTENT AREA                                      -->
    <!-- ========================================================= -->
    <div class="main-wrapper">
        
        <!-- Top Navbar -->
        <header class="top-navbar">
            <div class="search-box">
                <i class="bi bi-search search-icon"></i>
                <input type="text" class="search-input" placeholder="Search appointments, clinicians..." />
            </div>

            <div class="top-controls">
                <!-- Notifications -->
                <a href="/Client/Notifications" class="btn-notification" title="Notifications">
                    <i class="bi bi-bell"></i>
                    @if (Model.UnreadNotificationsCount > 0)
                    {
                        <span class="notify-dot"></span>
                    }
                </a>

                <!-- User Profile Dropdown with working Logout -->
                <div class="dropdown">
                    <button class="user-profile-pill btn p-0 border-0 d-flex align-items-center" type="button" id="apptUserDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="avatar-initials">@initials</div>
                        <div class="user-meta d-none d-sm-block text-start ms-2">
                            <span class="fw-bold small text-dark d-block">@Model.FullName</span>
                            <span class="text-muted" style="font-size: 0.75rem;">Client</span>
                        </div>
                        <i class="bi bi-chevron-down ms-2 text-muted" style="font-size: 0.75rem;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border border-slate-100 rounded-3 mt-2 py-2" aria-labelledby="apptUserDropdown" style="min-width: 220px; z-index: 1050;">
                        <li class="px-3 py-2 border-bottom">
                            <div class="fw-bold text-dark small">@Model.FullName</div>
                            <div class="text-muted" style="font-size: 0.78rem;">@Model.Email</div>
                            <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2 py-0.5 rounded-pill mt-1" style="font-size: 0.7rem;">Client Account</span>
                        </li>
                        <li class="px-2 pt-2">
                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-2 py-1.5 d-flex align-items-center justify-content-center gap-2 fw-semibold">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Log out</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Main Body -->
        <main class="dashboard-body">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-custom-success alert-dismissible fade show" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- 1. Header Row (CARE & SUPPORT, Title & + Book appointment CTA) -->
            <div class="page-header-row">
                <div>
                    <div class="page-eyebrow">CARE & SUPPORT</div>
                    <h1 class="page-main-title">Appointments</h1>
                    <p class="page-subtitle">Schedule and manage your consultations and training sessions.</p>
                </div>
                <button type="button" class="btn-book-cta" data-bs-toggle="modal" data-bs-target="#bookAppointmentModal">
                    <i class="bi bi-plus-lg"></i>
                    <span>Book appointment</span>
                </button>
            </div>

            <!-- 2. Controls Bar (Tabs: Upcoming 3, Past & Search + All statuses) -->
            <div class="controls-card">
                <div class="tabs-pill-group">
                    <a href="/Client/Appointments?tab=Upcoming" class="tab-btn @(Model.ActiveTab == "Upcoming" ? "active" : "")">
                        <span>Upcoming</span>
                        <span class="tab-counter-badge">@Model.UpcomingCount</span>
                    </a>
                    <a href="/Client/Appointments?tab=Past" class="tab-btn @(Model.ActiveTab == "Past" ? "active" : "")">
                        <span>Past</span>
                    </a>
                </div>

                <div class="controls-right-group">
                    <!-- Search input -->
                    <form method="get" asp-action="Appointments" class="appt-search-box">
                        <input type="hidden" name="tab" value="@Model.ActiveTab" />
                        <input type="hidden" name="status" value="@Model.StatusFilter" />
                        <i class="bi bi-search appt-search-icon"></i>
                        <input type="text" name="search" value="@Model.SearchTerm" class="appt-search-input" placeholder="Search appointments" onchange="this.form.submit()" />
                    </form>

                    <!-- Filter dropdown -->
                    <div class="dropdown">
                        <button class="btn-filter-dropdown" type="button" id="filterStatusBtn" data-bs-toggle="dropdown" aria-expanded="false">
                            <span>@(Model.StatusFilter == "All" ? "All statuses" : Model.StatusFilter)</span>
                            <i class="bi bi-chevron-right text-muted" style="font-size: 0.75rem;"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border border-slate-100 rounded-3 mt-1" aria-labelledby="filterStatusBtn">
                            <li><a class="dropdown-item small" href="/Client/Appointments?tab=@Model.ActiveTab&status=All&search=@Model.SearchTerm">All statuses</a></li>
                            <li><a class="dropdown-item small" href="/Client/Appointments?tab=@Model.ActiveTab&status=Approved&search=@Model.SearchTerm">Approved</a></li>
                            <li><a class="dropdown-item small" href="/Client/Appointments?tab=@Model.ActiveTab&status=Pending&search=@Model.SearchTerm">Pending</a></li>
                            <li><a class="dropdown-item small" href="/Client/Appointments?tab=@Model.ActiveTab&status=Completed&search=@Model.SearchTerm">Completed</a></li>
                            <li><a class="dropdown-item small" href="/Client/Appointments?tab=@Model.ActiveTab&status=Cancelled&search=@Model.SearchTerm">Cancelled</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- 3. Appointments List Card (Exact match to media_1792558583092_fb065d35.png) -->
            <div class="appointments-card">
                @if (currentList.Any())
                {
                    @foreach (var appt in currentList)
                    {
                        var statusPillClass = appt.Status switch
                        {
                            "Approved" => "pill-approved",
                            "Pending" => "pill-pending",
                            "Completed" => "pill-completed",
                            "Cancelled" => "pill-cancelled",
                            _ => "pill-approved"
                        };

                        var dotClass = appt.Status switch
                        {
                            "Approved" => "dot-green",
                            "Pending" => "dot-amber",
                            "Completed" => "dot-gray",
                            "Cancelled" => "dot-red",
                            _ => "dot-green"
                        };

                        <div class="appointment-row" id="row-@appt.Id">
                            <div class="row-left-group">
                                <!-- Date block: 18 APR -->
                                <div class="date-block">
                                    <span class="date-day">@appt.Day</span>
                                    <span class="date-month">@appt.Month</span>
                                </div>

                                <!-- Specialist Initials Avatar: MP / CW / NF -->
                                <div class="specialist-avatar-box">
                                    @appt.SpecialistInitials
                                </div>

                                <!-- Middle Details -->
                                <div class="appt-details-col">
                                    <span class="category-eyebrow">@appt.Category</span>
                                    <h4 class="specialist-name">@appt.SpecialistName</h4>
                                    <div class="time-meta-row">
                                        <i class="bi bi-clock"></i>
                                        <span>@appt.TimeSlot · @appt.DurationText</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(appt.Notes) && 
                                        (appt.Status == "Completed" || 
                                         appt.Notes.StartsWith("Form check", StringComparison.OrdinalIgnoreCase) || 
                                         appt.Notes.StartsWith("Feedback", StringComparison.OrdinalIgnoreCase) || 
                                         appt.Notes.StartsWith("Coach", StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <div class="mt-2 p-2 px-3 rounded-3 small" style="background-color: #F8FAFC; border: 1px solid #E2E8F0; border-left: 3px solid #10B981 !important; max-width: 520px;">
                                            <div class="d-flex align-items-center gap-1 text-success fw-bold" style="font-size: 0.72rem; letter-spacing: 0.5px; text-transform: uppercase;">
                                                <i class="bi bi-chat-left-quote-fill"></i>
                                                <span>Coach Review & Feedback</span>
                                            </div>
                                            <div class="text-secondary small fw-medium mt-0.5" style="line-height: 1.45; font-size: 0.82rem;">
                                                @appt.Notes
                                            </div>
                                        </div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(appt.Notes) && 
                                             !appt.Notes.StartsWith("Client booked consultation", StringComparison.OrdinalIgnoreCase) && 
                                             !appt.Notes.Equals("Standard consultation session.", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div class="mt-1 small text-muted" style="font-size: 0.78rem;">
                                            <i class="bi bi-card-text me-1 text-secondary"></i><span class="text-secondary">Focus: @appt.Notes</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Right actions & status -->
                            <div class="row-right-group">
                                <span class="status-pill @statusPillClass">
                                    <span class="@dotClass"></span>
                                    <span>@appt.Status</span>
                                </span>

                                <button type="button" class="btn-view-appt" onclick="openViewModal('@appt.Id', '@appt.Day @appt.Month', '@appt.Category', '@appt.SpecialistName', '@appt.SpecialistRole', '@appt.TimeSlot', '@appt.DurationText', '@appt.Status', '@((appt.Notes ?? "").Replace("'", "\\'").Replace("\r", "").Replace("\n", " "))')">
                                    View
                                </button>

                                @if (appt.Status != "Cancelled" && appt.Status != "Completed")
                                {
                                    <button type="button" class="btn-cancel-appt" onclick="confirmCancel('@appt.Id', '@appt.SpecialistName', '@appt.Day @appt.Month')">
                                        Cancel
                                    </button>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="bi bi-calendar-x"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">No appointments found</h5>
                        <p class="text-muted small mb-3">You do not have any @Model.ActiveTab.ToLower() appointments matching your filters.</p>
                        <button type="button" class="btn btn-outline-success rounded-3 px-3 fw-bold small" data-bs-toggle="modal" data-bs-target="#bookAppointmentModal">
                            <i class="bi bi-plus-lg me-1"></i> Book your next consultation
                        </button>
                    </div>
                }
            </div>

        </main>
    </div>
</div>

<!-- ========================================================= -->
<!-- MODAL 1: BOOK APPOINTMENT (+ Book appointment CTA)        -->
<!-- ========================================================= -->
<div class="modal fade" id="bookAppointmentModal" tabindex="-1" aria-labelledby="bookAppointmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white p-4" style="background: linear-gradient(135deg, #0C2333 0%, #081B28 100%) !important;">
                <div class="d-flex align-items-center gap-3">
                    <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(16, 185, 129, 0.2); color: #10B981; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                        <i class="bi bi-calendar2-plus"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-white mb-0" id="bookAppointmentModalLabel">Book a Session</h5>
                        <small class="text-white-50">Reserve time with medical doctors, nutritionists & coaches</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <form asp-action="BookAppointment" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show rounded-3 p-3 mb-3 d-flex align-items-center gap-2" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger flex-shrink-0"></i>
                            <div class="small fw-semibold">@TempData["ErrorMessage"]</div>
                            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary text-uppercase">Consultation Category</label>
                        <select asp-for="BookingForm.Category" class="form-select rounded-3 py-2" id="consultCategorySelect" onchange="updateSpecialistOptions()">
                            <option value="Health Consultation">HEALTH CONSULTATION</option>
                            <option value="Personal Training">PERSONAL TRAINING</option>
                            <option value="Nutrition Review">NUTRITION REVIEW</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary text-uppercase">Specialist / Clinician</label>
                        <select asp-for="BookingForm.SpecialistName" class="form-select rounded-3 py-2" id="specialistSelect">
                            @if (Model.AvailableTrainers != null && Model.AvailableTrainers.Any())
                            {
                                foreach (var trainer in Model.AvailableTrainers)
                                {
                                    <option value="@trainer.Name">@trainer.Name (@trainer.RoleOrSpecialty)</option>
                                }
                            }
                            else
                            {
                                <option value="" disabled selected>No certified coaches available currently</option>
                            }
                        </select>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-secondary text-uppercase">Date</label>
                            <input asp-for="BookingForm.AppointmentDate" type="date" class="form-control rounded-3 py-2" required min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-secondary text-uppercase">Time Slot</label>
                            <select asp-for="BookingForm.TimeSlot" class="form-select rounded-3 py-2">
                                <option value="9:15 AM">09:15 AM</option>
                                <option value="10:30 AM" selected>10:30 AM</option>
                                <option value="11:45 AM">11:45 AM</option>
                                <option value="2:00 PM">02:00 PM</option>
                                <option value="4:00 PM">04:00 PM</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary text-uppercase">Duration</label>
                        <select asp-for="BookingForm.DurationText" class="form-select rounded-3 py-2">
                            <option value="45 min">45 min (Standard Session)</option>
                            <option value="60 min" selected>60 min (Full Comprehensive Session)</option>
                            <option value="30 min">30 min (Express Check-in)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary text-uppercase">Notes / Goals for Session</label>
                        <textarea asp-for="BookingForm.Notes" rows="2" class="form-control rounded-3" placeholder="e.g. Discuss cardiovascular progress, recovery and routine blood test results."></textarea>
                    </div>

                    <div class="p-3 rounded-3" style="background-color: #F8FAFC; border: 1px dashed #CBD5E1;">
                        <div class="d-flex align-items-center gap-2 small text-muted">
                            <i class="bi bi-info-circle text-primary"></i>
                            <span>You will receive an in-app confirmation once your specialist confirms this slot.</span>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light p-3 border-top">
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn text-white rounded-3 px-4 fw-bold" style="background: linear-gradient(135deg, #10B981 0%, #059669 100%);">
                        <i class="bi bi-check2-circle me-1"></i> Confirm Booking
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================================= -->
<!-- MODAL 2: VIEW APPOINTMENT DETAILS (View button)           -->
<!-- ========================================================= -->
<div class="modal fade" id="viewAppointmentModal" tabindex="-1" aria-labelledby="viewAppointmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white p-4" style="background: linear-gradient(135deg, #0C2333 0%, #081B28 100%);">
                <div class="d-flex align-items-center gap-3">
                    <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(52, 211, 153, 0.2); color: #34D399; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                        <i class="bi bi-file-medical"></i>
                    </div>
                    <div>
                        <span id="viewCategoryBadge" class="badge bg-white text-dark fw-bold mb-1" style="font-size: 0.7rem;"></span>
                        <h5 class="modal-title fw-bold text-white mb-0" id="viewSpecialistName">Appointment Details</h5>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <div class="d-flex align-items-center justify-content-between p-3 rounded-3 mb-3 bg-light border">
                    <div>
                        <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.7rem;">Scheduled Time</small>
                        <div class="fw-bold text-dark fs-6" id="viewDateTime"></div>
                    </div>
                    <span id="viewStatusPill" class="status-pill pill-approved"></span>
                </div>

                <div class="mb-3">
                    <label class="text-muted small fw-bold text-uppercase">Specialist Profile</label>
                    <p id="viewRole" class="small text-secondary mb-0 fw-semibold"></p>
                </div>

                <div class="mb-3">
                    <label class="text-muted small fw-bold text-uppercase">Location / Meeting</label>
                    <div class="d-flex align-items-center gap-2 small text-dark mt-1">
                        <i class="bi bi-geo-alt-fill text-danger"></i>
                        <span>HealthTrack Clinic Suite 3B & Secure Encrypted Video Stream</span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="text-muted small fw-bold text-uppercase d-flex align-items-center gap-1 mb-1" id="viewNotesLabel">
                        <i class="bi bi-journal-text"></i>
                        <span>Session Focus</span>
                    </label>
                    <div id="viewNotes" class="p-3 rounded-3 bg-light small text-secondary"></div>
                </div>
            </div>

            <div class="modal-footer bg-light p-3 border-top">
                <button type="button" class="btn btn-secondary rounded-3 px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================= -->
<!-- MODAL 3: CANCEL CONFIRMATION (Cancel button)              -->
<!-- ========================================================= -->
<div class="modal fade" id="cancelConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-body p-4 text-center">
                <div style="width: 52px; height: 52px; border-radius: 50%; background-color: #FEE2E2; color: #DC2626; display: inline-flex; align-items: center; justify-content: center; font-size: 1.5rem; margin-bottom: 1rem;">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">Cancel Appointment?</h5>
                <p class="text-muted small mb-3">Are you sure you want to cancel your session with <strong id="cancelSpecialistText"></strong> on <strong id="cancelDateText"></strong>?</p>
                
                <form asp-action="CancelAppointment" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="cancelApptIdInput" />
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-light border w-50 rounded-3 fw-semibold small" data-bs-dismiss="modal">Keep</button>
                        <button type="submit" class="btn btn-danger w-50 rounded-3 fw-bold small">Yes, Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap 5 JavaScript Bundle -->
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function openViewModal(id, dateText, category, specialist, role, time, duration, status, notes) {
        document.getElementById('viewCategoryBadge').innerText = category;
        document.getElementById('viewSpecialistName').innerText = specialist;
        document.getElementById('viewRole').innerText = role;
        document.getElementById('viewDateTime').innerText = dateText + ' · ' + time + ' (' + duration + ')';

        var label = document.getElementById('viewNotesLabel');
        var notesBox = document.getElementById('viewNotes');
        var isFeedback = (status === 'Completed' || (notes && (notes.toLowerCase().startsWith('form check') || notes.toLowerCase().startsWith('feedback') || notes.toLowerCase().startsWith('coach') || notes.toLowerCase().startsWith('enter posture'))));

        if (isFeedback) {
            label.className = 'small fw-bold text-uppercase text-success d-flex align-items-center gap-1 mb-1';
            label.innerHTML = '<i class="bi bi-chat-left-quote-fill"></i><span>Coach Feedback & Review</span>';
            notesBox.className = 'p-3 rounded-3 small fw-medium text-dark border-start border-3 border-success';
            notesBox.style.backgroundColor = '#F0FDF4';
            notesBox.innerText = notes && notes.length > 0 ? notes : "No specific feedback provided.";
        } else {
            label.className = 'text-muted small fw-bold text-uppercase d-flex align-items-center gap-1 mb-1';
            label.innerHTML = '<i class="bi bi-journal-text"></i><span>Session Focus</span>';
            notesBox.className = 'p-3 rounded-3 bg-light small text-secondary';
            notesBox.style.backgroundColor = '#F8FAFC';
            notesBox.innerText = notes && notes.length > 0 ? notes : "No specific session focus provided.";
        }

        var pill = document.getElementById('viewStatusPill');
        pill.innerText = status;
        pill.className = 'status-pill ' + (status === 'Approved' ? 'pill-approved' : (status === 'Pending' ? 'pill-pending' : (status === 'Cancelled' ? 'pill-cancelled' : 'pill-completed')));

        var modal = new bootstrap.Modal(document.getElementById('viewAppointmentModal'));
        modal.show();
    }

    function confirmCancel(id, specialist, dateText) {
        document.getElementById('cancelApptIdInput').value = id;
        document.getElementById('cancelSpecialistText').innerText = specialist;
        document.getElementById('cancelDateText').innerText = dateText;

        var modal = new bootstrap.Modal(document.getElementById('cancelConfirmModal'));
        modal.show();
    }

    function updateSpecialistOptions() {
        // Keeps user's selected trainer dynamically without forcing hardcoded names
    }

    document.addEventListener("DOMContentLoaded", function() {
        @if (TempData["OpenBookingModal"] != null && TempData["OpenBookingModal"]?.ToString() == "true")
        {
            <text>
            var bookModalElem = document.getElementById('bookAppointmentModal');
            if (bookModalElem) {
                var bookModal = new bootstrap.Modal(bookModalElem);
                bookModal.show();
            }
            </text>
        }
    });
</script>

</body>
</html>

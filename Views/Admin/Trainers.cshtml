@model HealthTrack.Models.ViewModels.AdminTrainerManagementViewModel
@{
    ViewData["Title"] = "Trainer Management - HealthTrack Administration";
    Layout = null;
    var initials = string.IsNullOrEmpty(Model.AdminInitials) ? "JL" : Model.AdminInitials;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --ht-navy-bg: #0C1E28;
            --ht-navy-card: #132733;
            --ht-green: #10B981;
            --ht-green-hover: #059669;
            --ht-green-light: #ECFDF5;
            --ht-slate-dark: #0F172A;
            --ht-slate-muted: #64748B;
            --ht-border: #E2E8F0;
            --ht-body-bg: #F8FAFC;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--ht-body-bg);
            color: var(--ht-slate-dark);
            min-height: 100vh;
            display: flex;
        }

        /* ========================================================= */
        /* 1. SIDEBAR                                                */
        /* ========================================================= */
        .sidebar {
            width: 260px;
            background-color: var(--ht-navy-bg);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: sticky;
            top: 0;
            height: 100vh;
            padding: 1.5rem 1.15rem;
            flex-shrink: 0;
            z-index: 100;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
            font-size: 1.35rem;
            color: #FFFFFF;
            text-decoration: none;
            margin-bottom: 2rem;
            padding-left: 0.5rem;
        }

        .brand-icon {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            background: linear-gradient(135deg, #10B981 0%, #059669 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #FFFFFF;
            font-size: 1.15rem;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
        }

        .nav-category {
            font-size: 0.7rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            color: #64748B;
            text-transform: uppercase;
            padding: 0.5rem 0.75rem;
            margin-bottom: 0.5rem;
        }

        .sidebar-menu {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.75rem 0.95rem;
            border-radius: 12px;
            color: #94A3B8;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.2s ease;
        }

        .sidebar-link:hover {
            color: #FFFFFF;
            background-color: rgba(255, 255, 255, 0.05);
        }

        .sidebar-link.active {
            color: #FFFFFF;
            background-color: rgba(16, 185, 129, 0.16);
            font-weight: 700;
        }

        .sidebar-link-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sidebar-link-left i {
            font-size: 1.15rem;
        }

        .sidebar-link.active .sidebar-link-left i {
            color: #10B981;
        }

        .active-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background-color: #10B981;
            box-shadow: 0 0 8px #10B981;
        }

        /* Sidebar Support Card & Logout */
        .sidebar-bottom {
            display: flex;
            flex-direction: column;
            gap: 12px;
            padding-top: 1.5rem;
        }

        .support-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            padding: 1rem;
        }

        .support-icon {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            background: rgba(16, 185, 129, 0.2);
            color: #10B981;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0.75rem;
            font-size: 1rem;
        }

        .support-title {
            color: #FFFFFF;
            font-weight: 700;
            font-size: 0.85rem;
            margin-bottom: 0.2rem;
        }

        .support-desc {
            color: #94A3B8;
            font-size: 0.75rem;
            line-height: 1.4;
            margin-bottom: 0.65rem;
        }

        .support-link {
            color: #10B981;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.75rem;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .btn-signout {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            padding: 0.7rem 0.95rem;
            border-radius: 10px;
            color: #94A3B8;
            background: transparent;
            border: none;
            font-size: 0.88rem;
            font-weight: 600;
            text-align: left;
            transition: all 0.2s;
            cursor: pointer;
        }

        .btn-signout:hover {
            color: #EF4444;
            background: rgba(239, 68, 68, 0.1);
        }

        .public-site-link {
            display: block;
            text-align: center;
            color: #64748B;
            font-size: 0.72rem;
            text-decoration: none;
            padding-top: 4px;
        }

        .public-site-link:hover {
            color: #94A3B8;
        }

        /* ========================================================= */
        /* 2. MAIN CONTENT                                           */
        /* ========================================================= */
        .main-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* Top Navbar */
        .top-navbar {
            background: #FFFFFF;
            border-bottom: 1px solid var(--ht-border);
            padding: 0.9rem 2.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 90;
        }

        .search-box-top {
            position: relative;
            width: 360px;
        }

        .search-input-top {
            width: 100%;
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            border-radius: 12px;
            padding: 0.55rem 1rem 0.55rem 2.5rem;
            font-size: 0.88rem;
            color: var(--ht-slate-dark);
            outline: none;
            transition: all 0.2s;
        }

        .search-input-top:focus {
            background: #FFFFFF;
            border-color: #10B981;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
        }

        .search-icon-top {
            position: absolute;
            left: 0.85rem;
            top: 50%;
            transform: translateY(-50%);
            color: #94A3B8;
            font-size: 0.95rem;
        }

        .navbar-right {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .btn-notification {
            position: relative;
            width: 42px;
            height: 42px;
            border-radius: 12px;
            border: 1px solid #E2E8F0;
            background: #FFFFFF;
            color: #64748B;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            text-decoration: none;
            transition: all 0.2s;
        }

        .btn-notification:hover {
            background: #F8FAFC;
            color: var(--ht-slate-dark);
            border-color: #CBD5E1;
        }

        .notify-dot {
            position: absolute;
            top: 9px;
            right: 10px;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #EF4444;
            border: 2px solid #FFFFFF;
        }

        .admin-profile-pill {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0.35rem 0.85rem 0.35rem 0.4rem;
            background: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .admin-profile-pill:hover {
            background: #F8FAFC;
            border-color: #CBD5E1;
        }

        .avatar-initials-admin {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #D1FAE5;
            color: #059669;
            font-weight: 800;
            font-size: 0.88rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .admin-meta-name {
            font-weight: 700;
            font-size: 0.85rem;
            color: #0F172A;
            line-height: 1.2;
        }

        .admin-meta-role {
            font-size: 0.72rem;
            color: #64748B;
        }

        /* Body container */
        .dashboard-body {
            padding: 2.25rem;
            flex: 1;
        }

        /* Alerts */
        .alert-custom-success {
            background-color: #ECFDF5;
            border: 1px solid #A7F3D0;
            color: #065F46;
            border-radius: 12px;
            padding: 0.9rem 1.2rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .alert-custom-error {
            background-color: #FEF2F2;
            border: 1px solid #FECACA;
            color: #991B1B;
            border-radius: 12px;
            padding: 0.9rem 1.2rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-weight: 600;
            font-size: 0.9rem;
        }

        /* Page Header */
        .page-header-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.75rem;
        }

        .page-eyebrow {
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            color: #64748B;
            text-transform: uppercase;
            margin-bottom: 0.35rem;
        }

        .page-title {
            font-weight: 800;
            font-size: 1.85rem;
            color: #0F172A;
            margin-bottom: 0.25rem;
            letter-spacing: -0.02em;
        }

        .page-subtitle {
            color: #64748B;
            font-size: 0.92rem;
            margin-bottom: 0;
        }

        .btn-add-trainer {
            background: #10B981;
            color: #FFFFFF;
            border: none;
            padding: 0.7rem 1.35rem;
            border-radius: 10px;
            font-weight: 700;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);
            cursor: pointer;
        }

        .btn-add-trainer:hover {
            background: #059669;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(16, 185, 129, 0.35);
            color: #FFFFFF;
        }

        /* Filter Card */
        .filter-card {
            background: #FFFFFF;
            border: 1px solid var(--ht-border);
            border-radius: 16px;
            padding: 0.85rem 1.25rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
        }

        .filter-search-box {
            position: relative;
            flex: 1;
            min-width: 280px;
            max-width: 480px;
        }

        .filter-search-input {
            width: 100%;
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            border-radius: 10px;
            padding: 0.6rem 1rem 0.6rem 2.4rem;
            font-size: 0.88rem;
            color: var(--ht-slate-dark);
            outline: none;
            transition: all 0.2s;
        }

        .filter-search-input:focus {
            background: #FFFFFF;
            border-color: #10B981;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
        }

        .filter-search-icon {
            position: absolute;
            left: 0.85rem;
            top: 50%;
            transform: translateY(-50%);
            color: #94A3B8;
            font-size: 0.95rem;
        }

        .filter-controls-group {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .custom-filter-select {
            background: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: 10px;
            padding: 0.58rem 1rem;
            font-size: 0.85rem;
            font-weight: 600;
            color: #475569;
            outline: none;
            cursor: pointer;
            transition: all 0.2s;
        }

        .custom-filter-select:focus {
            border-color: #10B981;
        }

        .btn-filter-action {
            background: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: 10px;
            padding: 0.58rem 1.15rem;
            font-size: 0.85rem;
            font-weight: 700;
            color: #475569;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
        }

        .btn-filter-action:hover {
            background: #F8FAFC;
            border-color: #CBD5E1;
            color: var(--ht-slate-dark);
        }

        /* Table Card */
        .trainers-table-card {
            background: #FFFFFF;
            border: 1px solid var(--ht-border);
            border-radius: 20px;
            padding: 1.65rem;
        }

        .table-card-header {
            margin-bottom: 1.25rem;
        }

        .table-card-title {
            font-weight: 800;
            font-size: 1.15rem;
            color: #0F172A;
            margin-bottom: 0.2rem;
        }

        .table-card-sub {
            font-size: 0.82rem;
            color: #64748B;
            margin-bottom: 0;
        }

        .table-trainers-list {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            margin-bottom: 0;
        }

        .table-trainers-list th {
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            color: #64748B;
            text-transform: uppercase;
            padding: 0.9rem 1.2rem;
            border-bottom: 1px solid #F1F5F9;
            background: #FAFAFA;
        }

        .table-trainers-list th:first-child {
            border-top-left-radius: 12px;
            border-bottom-left-radius: 12px;
        }

        .table-trainers-list th:last-child {
            border-top-right-radius: 12px;
            border-bottom-right-radius: 12px;
        }

        .table-trainers-list td {
            padding: 1.15rem 1.2rem;
            vertical-align: middle;
            border-bottom: 1px solid #F8FAFC;
            font-size: 0.88rem;
        }

        .table-trainers-list tr:last-child td {
            border-bottom: none;
        }

        .table-trainers-list tr:hover td {
            background-color: #F8FAFC;
        }

        .trainer-cell {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .trainer-avatar-circle {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 0.88rem;
            flex-shrink: 0;
        }

        .trainer-name-bold {
            font-weight: 700;
            color: #0F172A;
            font-size: 0.9rem;
        }

        .specialty-pill {
            display: inline-flex;
            align-items: center;
            padding: 0.25rem 0.65rem;
            border-radius: 8px;
            background: #F1F5F9;
            color: #334155;
            font-size: 0.78rem;
            font-weight: 600;
        }

        .clients-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 0.28rem 0.65rem;
            border-radius: 20px;
            background: #EFF6FF;
            color: #1D4ED8;
            font-weight: 700;
            font-size: 0.78rem;
            border: 1px solid rgba(59, 130, 246, 0.2);
        }

        .status-pill-active {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 0.3rem 0.75rem;
            border-radius: 20px;
            background: #ECFDF5;
            color: #059669;
            font-weight: 700;
            font-size: 0.76rem;
        }

        .status-pill-inactive {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 0.3rem 0.75rem;
            border-radius: 20px;
            background: #FEF2F2;
            color: #DC2626;
            font-weight: 700;
            font-size: 0.76rem;
        }

        .status-dot-green {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #10B981;
        }

        .status-dot-red {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #EF4444;
        }

        /* Table Pagination Footer */
        .table-pagination-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 1.5rem;
            margin-top: 0.5rem;
            border-top: 1px solid #F1F5F9;
            flex-wrap: wrap;
            gap: 12px;
        }

        .pagination-info-text {
            color: #64748B;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .pagination-nav {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .page-box {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 34px;
            height: 34px;
            padding: 0 0.5rem;
            border-radius: 8px;
            border: 1px solid #E2E8F0;
            background: #FFFFFF;
            color: #475569;
            font-weight: 700;
            font-size: 0.82rem;
            text-decoration: none;
            transition: all 0.2s;
        }

        .page-box:hover:not(.disabled) {
            background: #F8FAFC;
            color: var(--ht-slate-dark);
            border-color: #CBD5E1;
        }

        .page-box.active {
            background: #0F172A;
            border-color: #0F172A;
            color: #FFFFFF;
        }

        .page-box.disabled {
            color: #CBD5E1;
            background: #F8FAFC;
            cursor: not-allowed;
            border-color: #E2E8F0;
        }
    </style>
</head>
<body>

    <!-- ========================================================= -->
    <!-- 1. SIDEBAR (Dark Navy)                                    -->
    <!-- ========================================================= -->
    <aside class="sidebar">
        <div>
            <!-- Brand Logo -->
            <a href="/Admin" class="sidebar-brand">
                <div class="brand-icon">
                    <i class="bi bi-heart"></i>
                </div>
                <span>Health<span style="color: #10B981;">Track</span></span>
            </a>

            <!-- Navigation Links -->
            <div class="nav-category">WORKSPACE</div>
            <ul class="sidebar-menu">
                <li>
                    <a href="/Admin" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-grid-fill"></i>
                            <span>Dashboard</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Admin/Users" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-people"></i>
                            <span>User Management</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Admin/Trainers" class="sidebar-link active">
                        <div class="sidebar-link-left">
                            <i class="bi bi-activity"></i>
                            <span>Trainer Management</span>
                        </div>
                        <span class="active-dot"></span>
                    </a>
                </li>
                <li>
                    <a href="/Admin/Appointments" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-calendar2-event"></i>
                            <span>Appointments</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Admin/Analytics" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-graph-up-arrow"></i>
                            <span>Reports & Analytics</span>
                        </div>
                    </a>
                </li>
                <li>
                    <a href="/Admin/Settings" class="sidebar-link">
                        <div class="sidebar-link-left">
                            <i class="bi bi-gear"></i>
                            <span>System Settings</span>
                        </div>
                    </a>
                </li>
            </ul>
        </div>

        <div class="sidebar-bottom">
            <!-- Support Card -->
            <div class="support-card">
                <div class="support-icon">
                    <i class="bi bi-heart-pulse"></i>
                </div>
                <div class="support-title">Need assistance?</div>
                <div class="support-desc">Our care team is here to help.</div>
                <a href="mailto:support@healthtrack.com" class="support-link">
                    <span>Contact support</span>
                    <i class="bi bi-chevron-right" style="font-size: 0.7rem;"></i>
                </a>
            </div>

            <!-- Sign Out Button -->
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                <button type="submit" class="btn-signout">
                    <i class="bi bi-box-arrow-left"></i>
                    <span>Sign out</span>
                </button>
            </form>

            <a href="/" class="public-site-link">View public site</a>
        </div>
    </aside>

    <!-- ========================================================= -->
    <!-- 2. MAIN CONTENT AREA                                      -->
    <!-- ========================================================= -->
    <div class="main-wrapper">

        <!-- Top Navbar -->
        <header class="top-navbar">
            <div class="search-box-top">
                <i class="bi bi-search search-icon-top"></i>
                <input type="text" class="search-input-top" placeholder="Search anything..." />
            </div>

            <div class="navbar-right">
                <!-- Notification Bell -->
                <a href="javascript:void(0)" class="btn-notification" title="Notifications">
                    <i class="bi bi-bell"></i>
                    <span class="notify-dot"></span>
                </a>

                <!-- User Profile Dropdown -->
                <div class="dropdown">
                    <button class="admin-profile-pill btn p-0 border-0" type="button" id="adminDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="avatar-initials-admin">@initials</div>
                        <div class="text-start d-none d-sm-block">
                            <div class="admin-meta-name">@Model.AdminFullName</div>
                            <div class="admin-meta-role">@Model.AdminRole</div>
                        </div>
                        <i class="bi bi-chevron-right text-muted ms-1" style="font-size: 0.75rem;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border border-slate-100 rounded-3 mt-2 py-2" aria-labelledby="adminDropdown" style="min-width: 220px; z-index: 1050;">
                        <li class="px-3 py-2 border-bottom">
                            <div class="fw-bold text-dark small">@Model.AdminFullName</div>
                            <div class="text-muted" style="font-size: 0.78rem;">@Model.AdminEmail</div>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="/Admin">
                                <i class="bi bi-grid text-secondary"></i> Administrator Dashboard
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="/Admin/Users">
                                <i class="bi bi-people text-secondary"></i> User Management
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small d-flex align-items-center gap-2 active" href="/Admin/Trainers">
                                <i class="bi bi-activity text-secondary"></i> Trainer Management
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="/Admin/Appointments">
                                <i class="bi bi-calendar2-event text-secondary"></i> Appointments
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li class="px-2 pt-1">
                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-2 py-1.5 d-flex align-items-center justify-content-center gap-2 fw-semibold">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Log out</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Main Body -->
        <main class="dashboard-body">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert-custom-success">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                    <button type="button" class="btn-close" onclick="this.parentElement.remove()"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert-custom-error">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                    <button type="button" class="btn-close" onclick="this.parentElement.remove()"></button>
                </div>
            }

            <!-- Page Header Row -->
            <div class="page-header-row">
                <div>
                    <div class="page-eyebrow">ADMINISTRATION</div>
                    <h1 class="page-title">Trainer Management</h1>
                    <p class="page-subtitle">Review coach credentials, specialties, client allocations, and status.</p>
                </div>
            </div>

            <!-- ========================================================= -->
            <!-- 3. FILTER BAR CARD                                        -->
            <!-- ========================================================= -->
            <form method="get" asp-action="Trainers" class="filter-card">
                <div class="filter-search-box">
                    <i class="bi bi-search filter-search-icon"></i>
                    <input type="text" name="search" value="@Model.SearchTerm" class="filter-search-input" placeholder="Search by coach name, email or specialty..." />
                </div>

                <div class="filter-controls-group">
                    <!-- Specialty Filter Dropdown -->
                    <select name="specialty" class="custom-filter-select" onchange="this.form.submit()">
                        <option value="All" selected="@(Model.SpecialtyFilter == "All" ? "selected" : null)">All specialties</option>
                        <option value="Strength" selected="@(Model.SpecialtyFilter == "Strength" ? "selected" : null)">Strength & Conditioning</option>
                        <option value="Nutrition" selected="@(Model.SpecialtyFilter == "Nutrition" ? "selected" : null)">Clinical Nutrition</option>
                        <option value="Physician" selected="@(Model.SpecialtyFilter == "Physician" ? "selected" : null)">Health & Wellness Physician</option>
                        <option value="Rehab" selected="@(Model.SpecialtyFilter == "Rehab" ? "selected" : null)">Mobility & Rehab</option>
                    </select>

                    <!-- Status Filter Dropdown -->
                    <select name="status" class="custom-filter-select" onchange="this.form.submit()">
                        <option value="All" selected="@(Model.StatusFilter == "All" ? "selected" : null)">All statuses</option>
                        <option value="Active" selected="@(Model.StatusFilter == "Active" ? "selected" : null)">Active</option>
                        <option value="Inactive" selected="@(Model.StatusFilter == "Inactive" ? "selected" : null)">Inactive</option>
                    </select>

                    <!-- Filter Submit Button -->
                    <button type="submit" class="btn-filter-action">
                        <i class="bi bi-sliders"></i>
                        <span>Filters</span>
                    </button>
                </div>
            </form>

            <!-- ========================================================= -->
            <!-- 4. TRAINERS TABLE CARD                                    -->
            <!-- ========================================================= -->
            <div class="trainers-table-card">
                <div class="table-card-header">
                    <h2 class="table-card-title">Certified Coaches & Specialists</h2>
                    <p class="table-card-sub">
                        @if (Model.TotalItems > 0)
                        {
                            <span>Showing @Model.StartItemIndex–@Model.EndItemIndex of @Model.TotalItems specialists</span>
                        }
                        else
                        {
                            <span>0 registered specialists</span>
                        }
                    </p>
                </div>

                <div class="table-responsive">
                    <table class="table-trainers-list">
                        <thead>
                            <tr>
                                <th>TRAINER</th>
                                <th>EMAIL</th>
                                <th>SPECIALTY</th>
                                <th>ACTIVE CLIENTS</th>
                                <th>STATUS</th>
                                <th>ONBOARDED</th>
                                <th style="width: 50px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Trainers != null && Model.Trainers.Any())
                            {
                                foreach (var trainer in Model.Trainers)
                                {
                                    <tr>
                                        <td>
                                            <div class="trainer-cell">
                                                <div class="trainer-avatar-circle" style="background-color: @trainer.AvatarBgColor; color: @trainer.AvatarTextColor;">
                                                    @trainer.Initials
                                                </div>
                                                <span class="trainer-name-bold">@trainer.FullName</span>
                                            </div>
                                        </td>
                                        <td class="text-muted">@trainer.Email</td>
                                        <td>
                                            <span class="specialty-pill">@trainer.Specialty</span>
                                        </td>
                                        <td>
                                            <span class="clients-badge">
                                                <i class="bi bi-people-fill"></i>
                                                <span>@trainer.AssignedClientsCount Clients</span>
                                            </span>
                                        </td>
                                        <td>
                                            @if (trainer.Status == "Active")
                                            {
                                                <span class="status-pill-active">
                                                    <span class="status-dot-green"></span>
                                                    <span>Active</span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-pill-inactive">
                                                    <span class="status-dot-red"></span>
                                                    <span>Inactive</span>
                                                </span>
                                            }
                                        </td>
                                        <td class="text-muted">@trainer.JoinedDate</td>
                                        <td class="text-end">
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-link text-muted p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="bi bi-three-dots"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border border-slate-100 rounded-3 py-1">
                                                    <li>
                                                        <form asp-action="ToggleUserStatus" method="post" style="display:inline;">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="userId" value="@trainer.Id" />
                                                            <input type="hidden" name="returnUrl" value="/Admin/Trainers?search=@Model.SearchTerm&specialty=@Model.SpecialtyFilter&status=@Model.StatusFilter&page=@Model.CurrentPage" />
                                                            <button type="submit" class="dropdown-item small py-1.5">
                                                                <i class="bi bi-toggle-on me-2 text-secondary"></i> Toggle Status
                                                            </button>
                                                        </form>
                                                    </li>
                                                    <li>
                                                        <form asp-action="DeleteUser" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to remove this trainer?');">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="userId" value="@trainer.Id" />
                                                            <input type="hidden" name="returnUrl" value="/Admin/Trainers?search=@Model.SearchTerm&specialty=@Model.SpecialtyFilter&status=@Model.StatusFilter&page=@Model.CurrentPage" />
                                                            <button type="submit" class="dropdown-item small py-1.5 text-danger">
                                                                <i class="bi bi-trash3 me-2"></i> Remove Trainer
                                                            </button>
                                                        </form>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="bi bi-activity fs-2 text-secondary d-block mb-2"></i>
                                        <div class="fw-semibold text-dark">No trainers found</div>
                                        <div class="small">Try adjusting your search criteria or specialty filters.</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Table Pagination Footer -->
                @if (Model.TotalPages > 1)
                {
                    <div class="table-pagination-footer">
                        <div class="pagination-info-text">
                            Showing @Model.StartItemIndex to @Model.EndItemIndex of @Model.TotalItems
                        </div>

                        <div class="pagination-nav">
                            <!-- Previous Button -->
                            @if (Model.CurrentPage > 1)
                            {
                                <a href="/Admin/Trainers?search=@Model.SearchTerm&specialty=@Model.SpecialtyFilter&status=@Model.StatusFilter&page=@(Model.CurrentPage - 1)" class="page-box">
                                    Previous
                                </a>
                            }
                            else
                            {
                                <span class="page-box disabled">Previous</span>
                            }

                            <!-- Page Numbers -->
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                if (p == Model.CurrentPage)
                                {
                                    <span class="page-box active">@p</span>
                                }
                                else
                                {
                                    <a href="/Admin/Trainers?search=@Model.SearchTerm&specialty=@Model.SpecialtyFilter&status=@Model.StatusFilter&page=@p" class="page-box">
                                        @p
                                    </a>
                                }
                            }

                            <!-- Next Button -->
                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <a href="/Admin/Trainers?search=@Model.SearchTerm&specialty=@Model.SpecialtyFilter&status=@Model.StatusFilter&page=@(Model.CurrentPage + 1)" class="page-box">
                                    Next
                                </a>
                            }
                            else
                            {
                                <span class="page-box disabled">Next</span>
                            }
                        </div>
                    </div>
                }

            </div>

        </main>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
